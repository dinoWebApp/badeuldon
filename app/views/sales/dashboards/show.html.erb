<%# 영업 직원 대시보드(SALES-6 — /sales). SALES-7 — 모든 @변수는 로그인 본인 rep 스코프로만
    적재됐다(컨트롤러 격리). 결제 총액 그래프는 리포트와 같은 CSS bar chart(bar_height_percent
    재사용), 수수료는 스냅샷(SalesCommission)이 단일 소스다. 원천징수 3.3%는 지급 시 오프라인
    처리 고지(Q24). %>
<div class="py-4">
  <header>
    <h1 class="text-2xl font-bold tracking-tight text-emerald-900">
      <%= @rep.name %>님의 실적<% if @rep.title.present? %> <span class="ml-1 align-middle rounded-full bg-emerald-700/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-800"><%= @rep.title %></span><% end %>
    </h1>
    <p class="mt-1 text-sm text-stone-500">
      <%= @rep.email %> · 수수료율 <%= @rep.effective_rate %>%
      <% if @rep.sales? %>(유치 후 12개월 내 결제분 · 이후 무지급)<% else %>(기간 제한 없음)<% end %>
    </p>
  </header>

  <%# ── 현재 추천 코드 — 복사 버튼(clipboard 컨트롤러 재사용)·만료 예정 안내 ── %>
  <section aria-labelledby="code-heading" class="mt-6">
    <h2 id="code-heading" class="sr-only">내 추천 코드</h2>
    <% if @current_code %>
      <div class="rounded-2xl border border-emerald-700/20 bg-white p-5 shadow-sm"
           data-controller="clipboard" data-clipboard-text-value="<%= @current_code.code %>">
        <p class="text-xs font-medium text-stone-500">현재 추천 코드 <span class="ml-1 rounded-full bg-stone-100 px-2 py-0.5 text-stone-500">~<%= display_date(@current_code.valid_until) %>까지 유효</span></p>
        <div class="mt-2 flex items-center gap-3">
          <input type="text" value="<%= @current_code.code %>" readonly
                 data-clipboard-target="source" aria-label="추천 코드"
                 class="w-44 rounded-xl border border-stone-300 bg-stone-50 px-3 py-2 font-mono text-lg font-bold tracking-widest text-emerald-900 uppercase">
          <button type="button" data-action="clipboard#copy"
                  class="cursor-pointer rounded-xl border border-emerald-700 px-4 py-2 text-sm font-semibold text-emerald-800 shadow-sm transition hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700">
            <span data-clipboard-target="label">복사</span>
          </button>
        </div>
        <p class="mt-2 text-xs text-stone-400">코드는 매주 월요일 새로 발급됩니다 — 이전 코드로는 가입할 수 없습니다.</p>
      </div>
    <% else %>
      <div class="rounded-2xl border border-stone-200 bg-white p-5 text-sm text-stone-500 shadow-sm">
        아직 발급된 추천 코드가 없습니다. 관리자에게 발급을 요청해 주세요.
      </div>
    <% end %>
  </section>

  <%# ── 정산 요약 카드 2장 — 이번 달 수령 예정(직전월 스냅샷)·연도 누적 ── %>
  <section aria-labelledby="commission-heading" class="mt-6">
    <h2 id="commission-heading" class="sr-only">수수료 정산</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-xs font-medium text-stone-500">이번 달 수령 예정 <span class="text-stone-400">(직전월 정산분)</span></p>
        <% if @latest_commission %>
          <p class="mt-1 text-2xl font-bold tabular-nums text-emerald-900"><%= number_with_delimiter(@latest_commission.amount) %>원</p>
          <p class="mt-1 text-xs text-stone-500">
            <%= @latest_commission.period_label %> 실적 · 결제액 <%= number_with_delimiter(@latest_commission.base_amount) %>원 · <%= @latest_commission.rate %>%
          </p>
          <% if @latest_commission.pending? %>
            <span class="mt-2 inline-block rounded-full bg-orange-100 px-2.5 py-0.5 text-xs font-semibold text-orange-700">지급 예정</span>
          <% else %>
            <span class="mt-2 inline-block rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-700">지급 완료</span>
          <% end %>
        <% else %>
          <p class="mt-1 text-2xl font-bold tabular-nums text-stone-300">0원</p>
          <p class="mt-1 text-xs text-stone-400">아직 정산 스냅샷이 없습니다 — 유치 사용자가 Plus를 결제하면 매월 1일 집계됩니다.</p>
        <% end %>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-xs font-medium text-stone-500"><%= Date.current.year %>년 수수료 누적 <span class="text-stone-400">(전체 <%= number_with_delimiter(@total_amount) %>원)</span></p>
        <p class="mt-1 text-2xl font-bold tabular-nums text-emerald-900"><%= number_with_delimiter(@year_total) %>원</p>
        <p class="mt-1 text-xs text-stone-400">지급 시 원천징수 3.3%가 공제됩니다(사업자 소득 신고 기준 — 지급은 별도 이체).</p>
      </div>
    </div>
  </section>

  <%# ── 월별 결제 총액 — 최근 12개월 CSS 막대(리포트 그래프 패턴 재사용) ── %>
  <section aria-labelledby="monthly-heading" class="mt-8">
    <h2 id="monthly-heading" class="text-base font-bold text-stone-800">월별 결제 총액</h2>
    <p class="mt-1 text-sm text-stone-500">내가 유치한 사용자의 Plus 결제액(환불 제외)입니다. 수수료는 위 정산 스냅샷 기준으로 지급됩니다.</p>
    <% max_amount = monthly_max_amount(@monthly_rows) %>
    <figure class="mt-3">
      <div class="flex h-44 items-end gap-1.5 rounded-2xl border border-stone-200 bg-white px-4 pb-3 pt-6 shadow-sm sm:gap-2.5" role="img" aria-label="최근 12개월 유치 사용자 결제액 막대 그래프">
        <% @monthly_rows.each do |row| %>
          <div class="group flex h-full min-w-0 flex-1 flex-col items-center justify-end gap-1.5">
            <span class="text-[10px] font-bold tabular-nums text-emerald-800 transition duration-150 sm:opacity-0 sm:group-hover:opacity-100">
              <%= number_with_delimiter(row.amount) %>
            </span>
            <div class="w-full rounded-t-md bg-emerald-700/80 transition duration-200 group-hover:bg-emerald-800"
                 style="height: <%= bar_height_percent(row.amount, max_amount) %>%"
                 aria-hidden="true"></div>
            <span class="text-[10px] tabular-nums text-stone-400"><%= row.label %></span>
          </div>
        <% end %>
      </div>
      <figcaption class="mt-2 text-xs text-stone-400">각 막대 위 숫자가 해당 월의 결제 총액입니다(PC에서는 막대에 올려 확인). 결제일 기준 집계입니다.</figcaption>
    </figure>
  </section>

  <%# ── 내 사용자 목록 — 본인 유치 사용자만(SALES-7 스코프 격리) ── %>
  <section aria-labelledby="users-heading" class="mt-8">
    <h2 id="users-heading" class="text-base font-bold text-stone-800">내 사용자</h2>
    <p class="mt-1 text-sm text-stone-500">추천 코드로 가입한 사용자 총 <%= number_with_delimiter(@referred_users_count) %>명(목록은 최근 30명 표시).</p>
    <% if @referred_users.any? %>
      <div class="mt-3 overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm">
        <table class="w-full min-w-[560px] text-left text-sm">
          <caption class="sr-only">내가 유치한 사용자의 표시명·가입일·요금제·상태</caption>
          <thead>
            <tr class="border-b border-stone-200 text-xs font-semibold text-stone-500">
              <th scope="col" class="px-5 py-3.5">표시명</th>
              <th scope="col" class="px-5 py-3.5">가입일</th>
              <th scope="col" class="px-5 py-3.5">요금제</th>
              <th scope="col" class="px-5 py-3.5">상태</th>
            </tr>
          </thead>
          <tbody>
            <% @referred_users.each do |user| %>
              <tr class="border-b border-stone-100 transition duration-150 last:border-0 hover:bg-stone-50">
                <th scope="row" class="px-5 py-4 font-semibold text-stone-800"><%= user.display_name.presence || "미설정" %></th>
                <td class="px-5 py-4 tabular-nums text-stone-600"><%= display_date(user.created_at.to_date) %></td>
                <td class="px-5 py-4 text-stone-600">
                  <% if user.subscription&.plus? %>
                    <span class="rounded-full bg-emerald-700/10 px-2 py-0.5 text-xs font-semibold text-emerald-800">Plus</span>
                  <% else %>
                    <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs font-semibold text-stone-500">Free</span>
                  <% end %>
                </td>
                <td class="px-5 py-4 text-stone-600">
                  <% if user.suspended? %>
                    <span class="rounded-full bg-orange-100 px-2 py-0.5 text-xs font-semibold text-orange-700">정지</span>
                  <% else %>
                    <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs font-semibold text-stone-500">이용 중</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-3 rounded-2xl border border-stone-200 bg-white px-5 py-8 text-center text-sm text-stone-500 shadow-sm">
        아직 내 추천 코드로 가입한 사용자가 없습니다. 코드를 공유해 보세요.
      </p>
    <% end %>
  </section>
</div>
