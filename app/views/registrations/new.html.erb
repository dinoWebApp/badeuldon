<%# 회원가입 — AUTH-1 이메일/비밀번호 + AUTH-9 휴대폰 SMS 인증(폼 내 2단계 비동기) +
    SALES-3 추천 코드(선택). UI 품질 기준(DESIGN) 준수 — 기존 폼 스타일·문구 톤 계승.
    휴대폰 인증 상태 전환은 Stimulus(phone_verification)가 담당하고 서버가 이중 검증한다. %>
<div class="mx-auto w-full max-w-md py-12"
     data-controller="phone-verification"
     data-phone-verification-send-path="<%= send_phone_code_registration_path %>"
     data-phone-verification-verify-path="<%= verify_phone_code_registration_path %>">
  <h1 class="text-2xl font-bold tracking-tight text-emerald-900 sm:text-3xl">무료로 시작하기</h1>
  <p class="mt-2 text-sm text-stone-500">휴대폰 인증 후 이메일·비밀번호만으로 가입합니다. 무료 · 카드등록 없음</p>

  <% if flash[:alert] %>
    <div class="mt-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-600" role="alert">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <% if @user.errors.any? %>
    <div class="mt-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-600" role="alert">
      <ul class="list-disc space-y-1 pl-5">
        <% @user.errors.messages.each_value do |messages| %>
          <% messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "mt-8 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm", data: { phone_verification_target: "form" } do |form| %>
    <div>
      <%= form.label :phone, "휴대폰 번호", class: "block text-sm font-medium text-stone-700" %>
      <div class="mt-1 flex gap-2">
        <%= telephone_field_tag "user[phone]", params.dig(:user, :phone), required: true,
              placeholder: "01012345678", autocomplete: "tel",
              data: { phone_verification_target: "phone" },
              class: "block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
        <button type="button" data-action="phone-verification#send" data-phone-verification-target="sendButton"
                class="shrink-0 cursor-pointer rounded-xl border border-emerald-700 bg-white px-4 text-sm font-semibold text-emerald-800 shadow-sm transition hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700">
          인증번호 받기
        </button>
      </div>
    </div>

    <div class="mt-3 hidden" data-phone-verification-target="codeGroup">
      <div class="flex gap-2">
        <%= number_field_tag "verification_code", nil, inputmode: "numeric", maxlength: 6,
              placeholder: "인증번호 6자리", autocomplete: "one-time-code",
              data: { phone_verification_target: "code" },
              class: "block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
        <button type="button" data-action="phone-verification#verify" data-phone-verification-target="verifyButton"
                class="shrink-0 cursor-pointer rounded-xl border border-emerald-700 bg-white px-4 text-sm font-semibold text-emerald-800 shadow-sm transition hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700">
          인증번호 확인
        </button>
      </div>
    </div>
    <p class="mt-2 hidden min-h-5 text-xs" data-phone-verification-target="status" aria-live="polite"></p>

    <div class="mt-4">
      <%= form.label :email, "이메일", class: "block text-sm font-medium text-stone-700" %>
      <%= form.email_field :email, required: true, autocomplete: "username",
            class: "mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
    </div>

    <div class="mt-4">
      <%= form.label :password, "비밀번호", class: "block text-sm font-medium text-stone-700" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
    </div>

    <div class="mt-4">
      <%= form.label :password_confirmation, "비밀번호 확인", class: "block text-sm font-medium text-stone-700" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
    </div>

    <div class="mt-4">
      <%= label_tag :referred_code, "추천 코드 (선택)", class: "block text-sm font-medium text-stone-700" %>
      <%= text_field_tag :referred_code, params[:referred_code],
            placeholder: "담당 영업에게 받은 코드 8자리", maxlength: 8,
            class: "mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 uppercase shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
      <p class="mt-1 text-xs text-stone-400">추천 코드 입력 시 Plus 첫 결제가 20% 할인됩니다.</p>
    </div>

    <div class="mt-6">
      <%= form.submit "가입하기", disabled: true, data: { phone_verification_target: "submit" },
            class: "w-full cursor-pointer rounded-xl bg-emerald-800 px-6 py-3 text-base font-bold text-white shadow-sm transition enabled:hover:bg-emerald-900 disabled:cursor-not-allowed disabled:bg-stone-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      <p class="mt-2 text-center text-xs text-stone-400">휴대폰 인증 완료 후 가입할 수 있습니다.</p>
    </div>
  <% end %>

  <p class="mt-6 text-center text-sm text-stone-500">
    이미 계정이 있으신가요?
    <%= link_to "로그인", new_session_path, class: "font-semibold text-emerald-800 underline hover:no-underline" %>
  </p>
</div>
