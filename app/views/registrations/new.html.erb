<%# 회원가입 — AUTH-1 이메일/비밀번호, 가입 즉시 활성화(이메일 인증 링크 없음).
    UI 품질 기준(DESIGN) 적용 — 기능·라우팅·문구 불변. %>
<div class="mx-auto w-full max-w-md py-12">
  <h1 class="text-2xl font-bold tracking-tight text-emerald-900 sm:text-3xl">무료로 시작하기</h1>
  <p class="mt-2 text-sm text-stone-500">이메일과 비밀번호만으로 3분 만에 가입합니다. 무료 · 카드등록 없음</p>

  <% if @user.errors.any? %>
    <div class="mt-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-600" role="alert">
      <ul class="list-disc space-y-1 pl-5">
        <% @user.errors.messages.each_value do |messages| %>
          <% messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "mt-8 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm" do |form| %>
    <div>
      <%= form.label :email, "이메일", class: "block text-sm font-medium text-stone-700" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
            class: "mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
    </div>

    <div class="mt-4">
      <%= form.label :password, "비밀번호", class: "block text-sm font-medium text-stone-700" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
    </div>

    <div class="mt-4">
      <%= form.label :password_confirmation, "비밀번호 확인", class: "block text-sm font-medium text-stone-700" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
    </div>

    <div class="mt-6">
      <%= form.submit "가입하기",
            class: "w-full cursor-pointer rounded-xl bg-emerald-800 px-6 py-3 text-base font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    </div>
  <% end %>

  <p class="mt-6 text-center text-sm text-stone-500">
    이미 계정이 있으신가요?
    <%= link_to "로그인", new_session_path, class: "font-semibold text-emerald-800 underline hover:no-underline" %>
  </p>
</div>
