<%# 가입 직후 임시 화면(AUTH-1.3) — 표시명 미설정 시 프로필 설정 안내, 설정 완료 시 임시 완료 화면.
    /app 대시보드 본체는 후속 작업. %>
<div class="mx-auto w-full max-w-md py-12 text-center">
  <h1 class="text-3xl font-bold tracking-tight text-emerald-900">가입이 완료되었습니다</h1>

  <% if @user.display_name.blank? %>
    <p class="mt-4 text-base leading-relaxed text-stone-600">
      받을돈에 오신 것을 환영합니다!<br>
      청구서 발행 전에 프로필을 먼저 설정해 주세요.
    </p>

    <div class="mt-8 rounded-2xl border border-stone-200 bg-white p-6 text-left shadow-sm">
      <h2 class="text-base font-bold text-stone-800">시작 전에 프로필을 설정하세요</h2>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-stone-500">
        <li class="flex gap-2"><span class="font-bold text-emerald-700">·</span>청구서에 표기될 표시명(또는 상호)</li>
        <li class="flex gap-2"><span class="font-bold text-emerald-700">·</span>사업자 유형 — 프리랜서는 3.3% 원천징수 표기</li>
        <li class="flex gap-2"><span class="font-bold text-emerald-700">·</span>입금받을 은행·계좌 정보</li>
      </ul>
      <%= link_to "프로필 설정 시작하기", edit_app_profile_path,
            class: "mt-5 block rounded-xl bg-emerald-800 px-6 py-3 text-center text-base font-bold text-white shadow-sm transition hover:bg-emerald-900" %>
    </div>
  <% else %>
    <p class="mt-4 text-base leading-relaxed text-stone-600">
      프로필 설정이 완료되었습니다.<br>
      청구서·거래처 관리 대시보드를 준비 중입니다.<br>
      준비되는 대로 이 화면에서 바로 시작할 수 있습니다.
    </p>

    <div class="mt-6">
      <%# AUTH-1.3 — 프로필 완료 후 재진입 경로(모두 이후 수정 가능 관측화). /app 대시보드 구축 시 대체 %>
      <%= link_to "프로필 수정", edit_app_profile_path,
            class: "inline-block rounded-xl border border-emerald-800 px-6 py-3 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-800 hover:text-white" %>
    </div>
  <% end %>

  <div class="mt-8">
    <%= button_to "로그아웃", session_path, method: :delete,
          class: "cursor-pointer rounded-xl border border-emerald-800 px-6 py-2.5 text-base font-semibold text-emerald-800 transition hover:bg-emerald-800 hover:text-white" %>
  </div>
</div>
