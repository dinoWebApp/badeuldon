<%# LP-10 최종 CTA·푸터 — 히어로 메시지 반복 + 주 CTA 1회(동일 링크).
    푸터는 사업자 정보 확정 전까지 문의 채널 중심 표기(결정 #5 — 약관·개인정보 링크는 법무 검토 후 추가). %>
<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-4 sm:px-6 sm:pb-24">
    <div class="rounded-3xl bg-emerald-900 px-6 py-16 text-center shadow-xl shadow-emerald-900/20 sm:px-12">
      <h2 class="text-2xl leading-snug font-extrabold tracking-tight text-white sm:text-4xl">
        말하기 어려운 ‘돈 다오’,<br>
        받을돈이 대신합니다
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-emerald-100/90 sm:text-base">
        청구 링크 → 열람 추적 → 자동 리마인더 → 입금 약속 수집까지, 수금 루프 전체를 받을돈이 대신합니다.
      </p>
      <%= link_to new_registration_path,
            class: "mt-8 inline-block rounded-xl bg-white px-8 py-4 text-lg font-bold text-emerald-900 shadow-sm transition hover:-translate-y-0.5 hover:bg-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white active:translate-y-0" do %>
        무료로 시작하기
      <% end %>
      <p class="mt-3 text-sm font-medium text-emerald-200">무료 · 카드등록 없음 · 3분</p>
    </div>
  </div>
</section>

<footer class="border-t border-stone-200 bg-cream">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-10 sm:flex-row sm:items-end sm:justify-between sm:px-6">
    <div>
      <p class="text-base font-extrabold tracking-tight text-emerald-900">받을돈</p>
      <p class="mt-1 text-xs leading-relaxed text-stone-500">
        프리랜서 수금 자동화 서비스 · 서비스 문의: 카카오톡 채널 ‘받을돈’
      </p>
    </div>
    <p class="text-xs text-stone-500">© 2026 받을돈</p>
  </div>
</footer>
