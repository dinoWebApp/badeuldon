<%# LP-14 "모든 상황, 자동으로" — 시퀀스 바깥의 상황 대응 6종을 benefit-first로 소개.
    ① 약속 재조정(PROMISE-3) ② 열람 분기(REM-4·SHARE-5) ③ 부분입금(PAY-2) ④ 입금 회신 정지(PROMISE-7)
    ⑤ 발행 안내(SHARE-6·P2) ⑥ 마침 알림(PAY-4). 카드 그리드 아래 U1 향 진행 알림 스트립(SHARE-4·PROMISE-4·PROMISE-7·NOTI-1).
    미니 메시지 목업은 실제 알림톡 버블(#FEE500)과 구분되는 중립 버블 스타일 —
    LP-5 실제 발신 문구와 혼동되지 않게 상단에 '상황 미리보기' 라벨 표기.
    LP-12 — 과장·수치 인용·공포 조장 없음, 기능 사실만 서술. 정적 마크업(쿼리 없음, SURF-6),
    앵커·버튼 인터랙션 없음(SURF-4). %>
<section class="bg-[#f4f2ea]">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="text-sm font-bold text-emerald-700">상황별 대응</p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl">
      모든 상황, 자동으로
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-500">
      일정이 어긋나거나, 일부만 받거나, 상황이 달라져도 — 시퀀스는 그에 맞춰 조용히 이어갑니다.
    </p>

    <% scenarios = [
         { badge: "약속 재조정",
           benefit: "거래처가 ‘이번 주까지’라고 답하면, 리마인더 일정이 그 약속에 맞춰 다시 짜입니다.",
           detail: "등록된 약속일 하루 전에 안내하고, 약속이 지나가면 다음 날 한 번 다시 여웁니다.",
           mock_label: "약속일 하루 전",
           mock_body: "약속해주신 입금 예정일이 내일입니다. 오늘까지 확인 부탁드립니다." },
         { badge: "열람 분기",
           benefit: "열어본 거래처와 아직 못 본 거래처, 받는 안내가 다릅니다.",
           detail: "아직 못 연 거래처에게는 확인 요청이, 이미 열어본 거래처에게는 입금 안내가 갑니다.",
           mock_label: "열어본 거래처에게",
           mock_body: "‘오즈디자인’의 입금이 아직 확인되지 않았습니다. — 확인하신 내역 기준으로 안내드립니다" },
         { badge: "부분입금",
           benefit: "일부만 받았어도, 잔액 기준으로 조용히 이어갑니다.",
           detail: "받은 금액은 기록에 반영되고, 남은 잔액 기준으로만 안내가 이어집니다.",
           mock_label: "부분입금 확인 후",
           mock_body: "일부 입금이 확인되었습니다. 남은 잔액 기준으로 안내드리겠습니다." },
         { badge: "입금 회신",
           benefit: "거래처가 ‘이미 입금했어요’를 누르면 발송이 즉시 멈춥니다. 마감은 당신의 확인으로만.",
           detail: "회신은 발행인에게 전달되고, 수금 완료 처리는 발행인의 확인으로 이뤄집니다.",
           mock_label: "입금 회신 직후",
           mock_body: "‘이미 입금했어요’ 응답을 받았습니다. 자동 발송을 멈추고 발행인님께 전달드립니다." },
         { badge: "발행 안내",
           benefit: "청구서를 보내는 첫 안내도, 받을돈 명의로 대신합니다.",
           detail: "발행할 때 직접 카톡으로 보내거나, 받을돈 명의의 안내로 보낼지 선택할 수 있습니다. 내 번호는 노출되지 않습니다.",
           mock_label: "발행 직후",
           mock_body: "청구서를 안내드립니다. 아래 버튼에서 내용을 확인하실 수 있습니다." },
         { badge: "마침 알림",
           benefit: "수금이 끝나면, 정중한 마무리 인사까지 대신합니다.",
           detail: "마감 처리하면 거래처에게 확인·감사 안내가 발송됩니다. 기본으로 켜져 있고, 원하면 끌 수 있습니다.",
           mock_label: "마감 처리 후",
           mock_body: "입금이 확인되었습니다. 감사합니다." }
       ] %>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-6">
      <% scenarios.each do |scenario| %>
        <article class="flex flex-col rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:p-6">
          <p class="inline-flex w-fit items-center rounded-full bg-emerald-800/10 px-2.5 py-1 text-xs font-bold text-emerald-800"><%= scenario[:badge] %></p>
          <h3 class="mt-3 text-base leading-snug font-bold text-stone-800 sm:text-lg"><%= scenario[:benefit] %></h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-500"><%= scenario[:detail] %></p>

          <%# 미니 메시지 목업 — 상황차를 한눈에 보이게 하는 표시 전용 버블(링크·인터랙션 없음) %>
          <div class="mt-5 rounded-xl bg-cream p-3.5">
            <p class="text-[11px] font-bold tracking-wide text-stone-400">상황 미리보기 · <%= scenario[:mock_label] %></p>
            <div class="mt-2.5 flex items-start gap-2">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-800 text-xs font-bold text-white" aria-hidden="true">받</span>
              <p class="min-w-0 flex-1 rounded-2xl rounded-tl-sm border border-stone-200 bg-white px-3.5 py-2.5 text-[13px] leading-relaxed font-medium text-stone-700">
                <%= scenario[:mock_body] %>
              </p>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <%# U1 향 진행 알림 스트립 — 열람·약속·입금 회신 접수 알림(SHARE-4·PROMISE-4·PROMISE-7·NOTI-1)을 한 줄로 안내 %>
    <div class="mt-4 flex items-center gap-3 rounded-2xl border border-stone-200 bg-white px-5 py-4 shadow-sm sm:mt-6 sm:px-6">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-800/10 text-emerald-800" aria-hidden="true">
        <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
      </span>
      <p class="text-sm leading-relaxed text-stone-600">
        <span class="font-bold text-stone-800">진행 상황도 알림으로</span> — 열람·약속·입금 회신이 접수되면 바로 알려드립니다.
      </p>
    </div>
  </div>
</section>
