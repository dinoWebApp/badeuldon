<%# LP-16 영업 추천 프로그램 어필 — F-SALES(SALES-1/2/4/5) 확정 조건의 사실 서술.
    ① 추천 코드 주간 자동 갱신(SALES-2) ② 피추천인 Plus 첫 결제 20% 할인·첫 달 7,920원(SALES-4)
    ③ 수수료 정산 — 영업 파트너 20%·12개월 / 지인 추천 15%·무기한(SALES-1)·월 정산·원천징수 3.3%(SALES-5).
    참여 CTA는 텍스트 안내(카카오톡 채널) — /sales는 영업 직원 전용 로그인 표면(SALES-6·noindex)이라
    공개 진입 경로가 없고, SURF-4(② 진입 링크는 가입·로그인·법적 고지·블로그만)에 따라 앵커를 만들지 않는다.
    섹션 끝 가입 CTA는 일반 방문자용(uibowl 관찰 — CTA 반복). LP-12 — 수치는 PRD 확정치만 표기. %>
<section class="bg-[#f4f2ea]">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="text-sm font-bold text-emerald-700">추천 프로그램</p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl">
      지인에게 계정을 주고, 첫 달 20% 할인으로 시작하게 하세요
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-500">
      추천 코드로 가입한 지인은 Plus 첫 결제가 할인되고, 추천해 주신 분께는 결제액 기준 수수료가 매달 정산됩니다.
    </p>

    <% program_steps = [
         { no: 1, title: "추천 코드는 매주 새로 발급됩니다",
           desc: "보안을 위해 추천 코드는 매주 월요일 자동으로 새 코드로 갱신됩니다. 가입할 때 현재 유효한 코드를 입력하면 연결됩니다." },
         { no: 2, title: "지인의 첫 결제가 20% 할인됩니다",
           desc: "추천 코드로 가입한 지인은 Plus 첫 결제 20% 할인(첫 달 7,920원)으로 시작하고, 다음 달부터 정상가로 결제합니다." },
         { no: 3, title: "수수료가 매달 정산됩니다",
           desc: "추천해 주신 분께 결제액 기준 수수료를 정산합니다. 영업 파트너는 20%(12개월), 지인 추천은 15%(무기한)입니다." }
       ] %>
    <div class="mt-10 grid gap-4 sm:grid-cols-3 sm:gap-6">
      <% program_steps.each do |program_step| %>
        <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
          <p class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-800 text-xs font-bold text-white" aria-hidden="true"><%= program_step[:no] %></p>
          <h3 class="mt-3 text-base leading-snug font-bold text-stone-800"><%= program_step[:title] %></h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-500"><%= program_step[:desc] %></p>
        </div>
      <% end %>
    </div>

    <%# 정산 조건 보충 — 월 정산·원천징수(SALES-5 사실 서술, LP-12) %>
    <div class="mt-6 rounded-2xl border border-stone-200 bg-white px-5 py-4 shadow-sm sm:px-6">
      <p class="text-sm leading-relaxed text-stone-600">
        <span class="font-bold text-stone-800">정산 방식</span> — 유치 계정의 결제액을 매달 집계해 다음 달에 정산하며, 수수료 지급 시 원천징수(3.3%)가 적용됩니다.
      </p>
    </div>

    <%# 참여 문의 — 공개 가입 경로가 없어 텍스트 안내로 제공(앵커 없음 — SURF-4) %>
    <div class="mt-10 flex flex-col items-center justify-between gap-6 rounded-3xl border border-emerald-800/15 bg-white px-6 py-8 shadow-sm sm:flex-row sm:px-8">
      <div class="text-center sm:text-left">
        <p class="text-base font-bold text-stone-800">프로그램 참여는 관리자에게 문의해 주세요</p>
        <p class="mt-1 text-sm text-stone-500">문의 채널: 카카오톡 채널 ‘받을돈’</p>
      </div>
      <%= link_to new_registration_path,
            class: "shrink-0 rounded-xl bg-emerald-800 px-7 py-3.5 text-base font-bold text-white shadow-lg shadow-emerald-900/15 transition hover:-translate-y-0.5 hover:bg-emerald-900 hover:shadow-xl hover:shadow-emerald-900/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 active:translate-y-0" do %>
        무료로 시작하기
      <% end %>
    </div>
  </div>
</section>
