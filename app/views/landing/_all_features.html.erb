    <ul class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      <% features.each do |feature| %>
        <li class="flex flex-col rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-800/10 text-emerald-800" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <% feature[:icon].each do |icon_path| %>
                  <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon_path %>" />
                <% end %>
              </svg>
            </span>
            <h3 class="min-w-0 flex-1 text-base leading-snug font-bold text-stone-800"><%= feature[:title] %></h3>
            <% if feature[:badge] %>
              <% if feature[:badge] == "신규" %>
                <span class="shrink-0 rounded-full bg-emerald-800 px-2 py-0.5 text-[11px] font-bold text-white"><%= feature[:badge] %></span>
              <% else %>
                <span class="shrink-0 rounded-full bg-stone-100 px-2 py-0.5 text-[11px] font-bold text-stone-500"><%= feature[:badge] %></span>
              <% end %>
            <% end %>
          </div>
          <%# 혜택 체크리스트 — 이용자가 얻는 결과를 체크 아이콘과 나열(uibowl 관찰) %>
          <p class="mt-3 flex gap-2 text-sm leading-relaxed font-bold text-stone-700">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.75l6 6 9-13.5"/></svg>
            <span><%= feature[:benefit] %></span>
          </p>
          <p class="mt-2 text-sm leading-relaxed text-stone-500"><%= feature[:detail] %></p>
        </li>
      <% end %>
    </ul>

    <%# 섹션 끝 CTA 재노출(uibowl 관찰 — SURF-4 가입 단일 진입 유지) %>
    <div class="mt-12 text-center">
      <%= link_to new_registration_path,
            class: "inline-block rounded-xl bg-emerald-800 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-emerald-900/15 transition hover:-translate-y-0.5 hover:bg-emerald-900 hover:shadow-xl hover:shadow-emerald-900/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 active:translate-y-0" do %>
        이 모든 기능, 무료로 시작하기
      <% end %>
      <p class="mt-3 text-sm font-medium text-emerald-800">무료 · 카드등록 없음 · 3분</p>
    </div>
  </div>
</section>
