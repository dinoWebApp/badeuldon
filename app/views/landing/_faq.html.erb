<%# LP-8 FAQ — PRD 지정 8항목(details/summary, JS 없이 동작). 문구는 LP-12 준칙 내 신규 작성(Reviewer 검증 대상). %>
<section class="bg-white">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="text-center text-sm font-bold text-emerald-700">자주 묻는 질문</p>
    <h2 class="mt-2 text-center text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl">궁금한 점이 남아 있다면</h2>

    <div class="mt-10 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white shadow-sm">
      <% faqs = [
           { q: "추심·법무 대행 서비스인가요?",
             a: "아니요. 받을돈은 프리랜서가 직접 발행한 청구서를 안내하고 만기 전후 리마인더를 대신 보내는 도구입니다. 채권 추심 업무를 수행하지 않으며, 모든 메시지는 ‘받을돈’ 명의의 정중한 안내로 발송됩니다." },
           { q: "거래처가 불쾌해하지 않을까요?",
             a: "리마인더는 만기 전날 예고부터 시작해 부드러운 안내 톤을 유지하도록 설계되어 있습니다. 거래처는 메시지 속 링크에서 입금 예정일을 직접 제안할 수 있어, 일방적인 독촉이 아닌 조율로 이어집니다. 실제 발송 문구는 이 페이지의 ‘발신 문구’ 섹션에서 미리 볼 수 있습니다." },
           { q: "내 개인 번호·이름이 노출되나요?",
             a: "아니요. 모든 리마인더는 서비스 ‘받을돈’ 명의로 발송되며, 발행인의 개인 연락처는 메시지에 표시되지 않습니다." },
           { q: "상대방도 앱을 깔거나 가입해야 하나요?",
             a: "아니요. 거래처는 카카오톡으로 받은 링크를 열어 모바일 화면에서 청구서를 확인하고 버튼으로 응답합니다. 가입·설치·개인정보 입력은 필요하지 않습니다." },
           { q: "알림톡 발송 비용은 별도인가요?",
             a: "발송 채널 운영 비용은 받을돈이 부담합니다. 자동 시퀀스는 청구 건당 최대 5통(대체 SMS 포함)으로 제한되어, 과도한 발송이 일어나지 않도록 설계되어 있습니다." },
           { q: "계좌·거래처 정보는 안전하게 관리되나요?",
             a: "청구서 링크는 추측할 수 없는 고유 주소로 발급되며, 대시보드는 로그인한 계정으로만 접근할 수 있습니다. 입력한 정보는 청구서 발송과 기록을 위해서만 사용됩니다." },
           { q: "유료 구독은 어떻게 해지하나요?",
             a: "언제든 해지할 수 있으며, 해지해도 이미 결제한 기간이 끝나는 날까지 Plus 기능을 계속 이용할 수 있습니다." },
           { q: "사업자가 아닌 프리랜서도 쓸 수 있나요?",
             a: "네. 프로필에서 사업자 유형을 ‘프리랜서’로 선택하면 청구서에 3.3% 원천징수 표기를 적용해 발행할 수 있습니다." }
         ] %>
      <% faqs.each do |faq| %>
        <details class="group px-5 sm:px-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-sm font-bold text-stone-800 transition hover:text-emerald-800 [&::-webkit-details-marker]:hidden">
            <%= faq[:q] %>
            <span class="shrink-0 text-lg leading-none text-emerald-800 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="pb-5 pr-8 text-sm leading-relaxed text-stone-500"><%= faq[:a] %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>
