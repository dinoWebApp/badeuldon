<% content_for :title, "대시보드 — 받을돈" %>

<%# 표면 ② 대시보드 — DASH-1 요약 실데이터(F-INV 전환), DASH-2 빈 상태(REM·PROMISE 이벤트 부재),
    ONB-1 CTA 실링크(청구서 유무에 따라 발행·목록으로 전환), DASH-4 목록(연체일 내림차순 상위 5건).
    청구서 0건 사용자는 기존 빈 상태를 유지한다(거짓 0원 금지 — 02_prd_update 결정). %>
<div class="py-8">
  <header>
    <h1 class="text-2xl font-bold tracking-tight text-emerald-900">대시보드</h1>
    <p class="mt-2 text-sm leading-relaxed text-stone-500">
      <%= @user.display_name %>님의 수금 현황입니다.
    </p>
  </header>

  <%# ── DASH-1 상단 요약 — 미수 총액·연체 건수·금액·7일 내 만기(DESIGN-5 큰 숫자 카드) ── %>
  <section aria-labelledby="dash-summary" class="mt-8">
    <h2 id="dash-summary" class="text-base font-bold text-stone-800">수금 요약</h2>
    <div class="mt-3 grid gap-4 sm:grid-cols-3">
      <% if @has_invoices %>
        <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
          <h3 class="flex items-center gap-2 text-sm font-semibold text-stone-500">
            <span class="h-2 w-2 rounded-full bg-emerald-700" aria-hidden="true"></span>
            미수 총액
          </h3>
          <p class="mt-3 text-4xl font-extrabold tracking-tight tabular-nums text-stone-800">
            <%= won(@unsettled_total) %>
          </p>
          <p class="mt-3 text-sm leading-relaxed text-stone-500">발행 후 수금이 완료되지 않은 청구 금액 합계입니다.</p>
        </article>
        <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
          <h3 class="flex items-center gap-2 text-sm font-semibold text-stone-500">
            <span class="h-2 w-2 rounded-full bg-orange-500" aria-hidden="true"></span>
            연체 건수·금액
          </h3>
          <p class="mt-3 text-4xl font-extrabold tracking-tight tabular-nums text-orange-600">
            <%= number_with_delimiter(@overdue_count) %>건
          </p>
          <p class="mt-3 text-sm leading-relaxed text-stone-500">
            연체 금액 <span class="font-bold tabular-nums text-orange-600"><%= won(@overdue_total) %></span>
          </p>
        </article>
        <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
          <h3 class="flex items-center gap-2 text-sm font-semibold text-stone-500">
            <span class="h-2 w-2 rounded-full bg-stone-400" aria-hidden="true"></span>
            7일 내 만기
          </h3>
          <p class="mt-3 text-4xl font-extrabold tracking-tight tabular-nums text-stone-800">
            <%= number_with_delimiter(@due_soon_count) %>건
          </p>
          <p class="mt-3 text-sm leading-relaxed text-stone-500">일주일 안에 만기가 도래하는 미수 청구입니다.</p>
        </article>
      <% else %>
        <%# 청구서 0건 — 빈 상태 유지(수치 슬롯 대시, 0원 미표기) %>
        <% [ "bg-emerald-700", "bg-orange-500", "bg-stone-400" ].each_with_index do |dot, index| %>
          <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
            <h3 class="flex items-center gap-2 text-sm font-semibold text-stone-500">
              <span class="h-2 w-2 rounded-full <%= dot %>" aria-hidden="true"></span>
              <%= [ "미수 총액", "연체 건수·금액", "7일 내 만기" ][index] %>
            </h3>
            <p class="mt-3 text-4xl font-extrabold tracking-tight tabular-nums text-stone-300" aria-hidden="true">—</p>
            <p class="mt-3 text-sm leading-relaxed text-stone-500">청구서를 발행하면 여기에 표시됩니다.</p>
          </article>
        <% end %>
      <% end %>
    </div>
  </section>

  <%# ── DASH-2 오늘의 액션 — REM·PROMISE 이벤트 도메인 확정 전까지 빈 상태 유지 ── %>
  <section aria-labelledby="dash-actions" class="mt-8">
    <h2 id="dash-actions" class="text-base font-bold text-stone-800">오늘의 액션</h2>
    <article class="mt-3 rounded-2xl border border-dashed border-stone-300 bg-white/60 p-6 text-center sm:p-8">
      <p class="text-base font-bold text-stone-800">오늘 할 일이 없습니다</p>
      <p class="mt-2 text-sm leading-relaxed text-stone-500">
        첫 청구서를 발행하면 오늘 발송 예정·약속일 도래 같은 처리할 일이 카드로 표시됩니다.
      </p>
    </article>
  </section>

  <%# ── ONB-1 CTA — 청구서 0건이면 첫 발행, 이후에는 목록으로 자연 전환(준비 중 배지 제거) ── %>
  <section aria-labelledby="dash-onboarding" class="mt-8 rounded-3xl bg-emerald-900 px-6 py-12 text-center shadow-xl shadow-emerald-900/20 sm:px-12">
    <% if @has_invoices %>
      <h2 id="dash-onboarding" class="text-xl font-extrabold tracking-tight text-white sm:text-2xl">발행한 청구서를 관리합니다</h2>
      <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-emerald-100/90">
        연체일이 긴 청구서부터 목록에서 확인하고, 초안을 발행해 다음 수금 루프를 시작하세요.
      </p>
      <div class="mt-7">
        <%= link_to "청구서 전체 보기", app_invoices_path,
              class: "inline-flex min-h-11 items-center rounded-xl bg-white px-8 text-lg font-bold text-emerald-900 shadow-sm transition hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" %>
      </div>
    <% else %>
      <h2 id="dash-onboarding" class="text-xl font-extrabold tracking-tight text-white sm:text-2xl">3분이면 첫 청구서를 발행합니다</h2>
      <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-emerald-100/90">
        프로필의 표시명·계좌가 자동으로 채워지고, 품목 예시와 만기일(기본 30일)은 몇 번의 클릭으로 완성됩니다.
      </p>
      <div class="mt-7">
        <%= link_to "첫 청구서 발행하기", new_app_invoice_path,
              class: "inline-flex min-h-11 items-center rounded-xl bg-white px-8 text-lg font-bold text-emerald-900 shadow-sm transition hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" %>
      </div>
    <% end %>
  </section>

  <%# ── DASH-4 청구서 목록 — 연체일 내림차순(만기일 오름차순) 상위 5건 ── %>
  <section aria-labelledby="dash-invoices" class="mt-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="dash-invoices" class="text-base font-bold text-stone-800">청구서</h2>
      <div class="flex flex-wrap items-center gap-4">
        <%# DESIGN-2 상태색 3종 범례 — 연체 주황·대기 중립·수금 완료 녹색 %>
        <ul class="flex items-center gap-4 text-xs font-medium text-stone-500">
          <li class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-orange-500" aria-hidden="true"></span>연체</li>
          <li class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-stone-400" aria-hidden="true"></span>대기·약속</li>
          <li class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-green-600" aria-hidden="true"></span>수금 완료</li>
        </ul>
        <% if @has_invoices %>
          <%= link_to "전체 보기", app_invoices_path, class: "text-xs font-bold text-emerald-800 transition hover:underline" %>
        <% end %>
      </div>
    </div>

    <% if @has_invoices %>
      <div class="mt-3">
        <%= render "app/invoices/table", invoices: @invoices %>
      </div>
    <% else %>
      <div class="mt-3 rounded-2xl border border-stone-200 bg-white p-10 text-center shadow-sm sm:p-14">
        <p class="text-base font-bold text-stone-800">아직 발행된 청구서가 없습니다</p>
        <p class="mt-2 text-sm leading-relaxed text-stone-500">
          발행된 청구서는 연체일이 긴 순서부터 표시됩니다.
        </p>
      </div>
    <% end %>
  </section>
</div>
