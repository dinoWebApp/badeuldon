<%# 품목 카드(CLIENT-2) — 품목명 + 단가(DESIGN-3 — 금액은 tabular numerals로 강조).
    삭제는 파괴적 동작이므로 button_to + 확인 대화상자(규약 §7.4). %>
<li>
  <article class="flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition hover:border-stone-300 sm:p-6">
    <div class="min-w-0">
      <h3 class="truncate text-base font-bold text-stone-800">
        <%= link_to item.name, app_item_path(item), class: "transition hover:text-emerald-800" %>
      </h3>
      <%# DESIGN-3 — 단가는 tabular numerals 큰 숫자로 강조(표면 ② 공통) %>
      <p class="mt-2 text-2xl font-extrabold tracking-tight tabular-nums text-stone-800">
        <%= number_with_delimiter(item.unit_price) %>원
      </p>
    </div>

    <div class="mt-4 flex items-center justify-end gap-2 border-t border-stone-100 pt-4">
      <%= link_to "수정", edit_app_item_path(item),
            class: "inline-flex min-h-11 items-center rounded-lg border border-stone-300 bg-white px-3.5 text-sm font-semibold text-stone-600 transition hover:border-stone-400 hover:text-stone-800" %>
      <%= button_to "삭제", app_item_path(item), method: :delete,
            data: { turbo_confirm: "이 품목을 삭제하시겠습니까?" },
            class: "inline-flex min-h-11 cursor-pointer items-center rounded-lg border border-stone-300 bg-white px-3.5 text-sm font-semibold text-stone-500 transition hover:border-red-300 hover:text-red-600" %>
    </div>
  </article>
</li>
