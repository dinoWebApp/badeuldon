<%# 품목 등록·수정 공용 폼(CLIENT-2) — 실패 재렌더는 422(규약 §3.3), 성공은 303 리다이렉트로 목록에 반영한다. %>
<%= form_with model: [:app, item], class: "mt-8 space-y-6" do |form| %>
  <% if item.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-600" role="alert">
      <ul class="list-disc space-y-1 pl-5">
        <% item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-base font-bold text-stone-800">품목 정보</h2>

    <div class="mt-5">
      <%= form.label :name, "품목명", class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_field :name, required: true, autofocus: true, maxlength: 50,
            placeholder: "예) 웹 디자인 시안 1식",
            class: form_input_classes(item, :name) %>
      <% if form_error_message(item, :name) %>
        <p class="mt-1.5 text-xs font-medium text-red-600"><%= form_error_message(item, :name) %></p>
      <% end %>
    </div>

    <div class="mt-6">
      <%= form.label :unit_price, "단가", class: "block text-sm font-medium text-stone-700" %>
      <%= form.number_field :unit_price, required: true, min: 0, max: Item::MAX_UNIT_PRICE, step: 1,
            inputmode: "numeric",
            placeholder: "예) 150000",
            class: form_input_classes(item, :unit_price) %>
      <p class="mt-1.5 text-xs text-stone-500">단위는 원이며 0 이상의 정수로 입력합니다. 부가세 구분은 청구서 발행 때 선택합니다.</p>
      <% if form_error_message(item, :unit_price) %>
        <p class="mt-1.5 text-xs font-medium text-red-600"><%= form_error_message(item, :unit_price) %></p>
      <% end %>
    </div>
  </section>

  <div class="border-t border-stone-200 pt-6">
    <%= form.submit "저장",
          class: "w-full cursor-pointer rounded-xl bg-emerald-800 px-6 py-3 text-base font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    <%= link_to "취소", app_items_path,
          class: "mt-3 block w-full rounded-xl border border-stone-300 bg-white px-6 py-3 text-center text-sm font-semibold text-stone-600 transition hover:border-stone-400 hover:text-stone-800" %>
  </div>
<% end %>
