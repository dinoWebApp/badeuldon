<%# ADMIN-7 — 대시보드 상단 일반 공지 배너(미읽음 것만, 게시 기간 내). 닫기 = 읽음 기록
    (SEC-5 멱등 POST) → 303 리다이렉트로 재노출되지 않는다. 닫기 외에 제목 클릭 시 상세 열람. %>
<% notices.each do |notice| %>
  <div class="mb-4 flex items-start justify-between gap-3 rounded-2xl border border-emerald-700/20 bg-emerald-50/70 p-4" role="region" aria-label="서비스 공지">
    <div class="min-w-0">
      <p class="text-xs font-bold text-emerald-700">공지</p>
      <p class="mt-1 text-sm font-semibold text-stone-800">
        <%= link_to notice.title, app_notice_path(notice), class: "hover:text-emerald-800 hover:underline" %>
      </p>
    </div>
    <%= button_to "닫기", mark_read_app_notice_path(notice), method: :post, form: { class: "shrink-0" },
          aria: { label: "#{notice.title} 공지 닫기" },
          class: "inline-flex min-h-11 cursor-pointer items-center rounded-lg border border-emerald-700/30 bg-white px-3 text-xs font-semibold text-emerald-800 transition hover:bg-emerald-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
  </div>
<% end %>
