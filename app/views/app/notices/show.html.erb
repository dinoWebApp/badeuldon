<% content_for :title, "#{@notice.title} — 받을돈" %>

<%# ADMIN-7 — 공지 상세. 제목·중요도 배지·게시 기간·본문. %>
<div class="py-8">
  <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
    <header>
      <div class="flex items-center gap-2">
        <% if @notice.important? %>
          <span class="rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-bold text-red-600 ring-1 ring-inset ring-red-200">중요</span>
        <% else %>
          <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-bold text-emerald-700 ring-1 ring-inset ring-emerald-200">일반</span>
        <% end %>
        <span class="text-xs tabular-nums text-stone-400">
          <%= l(@notice.published_at.to_date, format: :long) %>
          <% unless @notice.expires_at.nil? %> · ~ <%= l(@notice.expires_at.to_date, format: :long) %><% end %>
        </span>
      </div>
      <h1 class="mt-3 text-xl font-bold tracking-tight text-stone-900 sm:text-2xl"><%= @notice.title %></h1>
    </header>

    <div class="mt-5 whitespace-pre-line text-sm leading-relaxed text-stone-700"><%= @notice.body %></div>

    <footer class="mt-8 flex items-center justify-between border-t border-stone-100 pt-5">
      <%= link_to "목록으로", app_notices_path, class: "text-sm font-semibold text-emerald-700 hover:text-emerald-900" %>
      <% unless @read %>
        <%= button_to "확인했습니다", mark_read_app_notice_path(@notice), method: :post,
              class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      <% end %>
    </footer>
  </article>
</div>
