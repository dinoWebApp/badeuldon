<% content_for :title, "공지 — 받을돈" %>

<%# ADMIN-7 — 게시 중 공지 목록. 제목·중요도 배지·게시 기간·읽음 여부. %>
<div class="py-8">
  <header>
    <h1 class="text-2xl font-bold tracking-tight text-emerald-900">공지</h1>
    <p class="mt-2 text-sm leading-relaxed text-stone-500">받을돈 서비스 공지사항입니다.</p>
  </header>

  <div class="mt-6 divide-y divide-stone-100 rounded-2xl border border-stone-200 bg-white shadow-sm">
    <% @notices.each do |notice| %>
      <%= link_to app_notice_path(notice),
            class: "flex items-center gap-3 px-5 py-4 transition hover:bg-stone-50" do %>
        <% if notice.important? %>
          <span class="shrink-0 rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-bold text-red-600 ring-1 ring-inset ring-red-200">중요</span>
        <% else %>
          <span class="shrink-0 rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-bold text-emerald-700 ring-1 ring-inset ring-emerald-200">일반</span>
        <% end %>
        <span class="min-w-0 flex-1 truncate text-sm font-semibold text-stone-800"><%= notice.title %></span>
        <% if @read_notice_ids.exclude?(notice.id) %>
          <span class="shrink-0 rounded-full bg-emerald-700 px-1.5 py-0.5 text-[10px] font-bold text-white">N</span>
        <% end %>
        <span class="shrink-0 text-xs tabular-nums text-stone-400"><%= l(notice.published_at.to_date, format: :long) %></span>
      <% end %>
    <% end %>
    <% if @notices.empty? %>
      <p class="px-5 py-10 text-center text-sm text-stone-400">게시 중인 공지가 없습니다.</p>
    <% end %>
  </div>
</div>
