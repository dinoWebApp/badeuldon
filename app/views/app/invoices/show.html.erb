<% content_for :title, "#{@invoice.issue_number || "청구서 초안"} — 받을돈" %>

<%# 청구서 상세(INV) — 품목 표·금액 내역(INV-2 분해 표기)·상태 전환 액션.
    발행 상태별 액션: 초안 → 발행·수정·삭제(INV-5 초안만), 발행 계열 → 무효(INV-6).
    공유 링크는 발행 계열에서 노출한다(표면 ③ 개봉 — SHARE-1/2/6, voided는 INV-6 폐기로 미노출). %>
<div class="py-8">
  <header>
    <%= link_to "← 청구서 목록", app_invoices_path,
          class: "text-sm font-semibold text-stone-500 transition hover:text-emerald-800" %>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <h1 class="text-2xl font-bold tracking-tight text-emerald-900">
        <%= @invoice.issue_number || "청구서 초안" %>
      </h1>
      <%= invoice_status_badge(@invoice) %>
    </div>
    <p class="mt-2 text-sm leading-relaxed text-stone-500">
      <%# INV-6 — 무효 건은 voided_at이 항상 issued_at 이후에 기록되므로 무효 분기를 먼저 본다.
          issued 계열→무효 순서로 두면 issued_at이 존재해 무효 일자가 안내되지 않는다. %>
      <% if @invoice.voided_at.present? %>
        <%= display_date(@invoice.voided_at) %>에 무효 처리했습니다.
      <% elsif @invoice.issued_at.present? %>
        <%= display_date(@invoice.issued_at) %>에 발행했습니다.
      <% else %>
        초안입니다. 발행 전까지 언제든 수정할 수 있습니다.
      <% end %>
    </p>
  </header>

  <%# ── 상태 전환 액션 — 파괴적 동작은 button_to + turbo_confirm(규약 §7.4) ── %>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    <% if @invoice.draft? %>
      <%# 발행(INV-4) + SHARE-6 — 첫 안내 발송 방식 선택(기본 체크 — LP-14 카드⑤ 톤 준용 문구).
          422 재렌더 시에도 체크 상태를 params로 복원한다. hidden 0 + checked 1 쌍으로
          "해제"가 명시 전송되며, 파라미터 부재는 컨트롤러가 기본 켬으로 해석한다. %>
      <div class="w-full rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
        <p class="text-sm font-bold text-stone-800">발행하기</p>
        <p class="mt-1 text-xs leading-relaxed text-stone-500">
          발행하면 공유 링크가 만들어지고 청구 내용은 수정할 수 없습니다.
        </p>
        <%= form_with url: issue_app_invoice_path(@invoice), method: :patch, class: "mt-4" do %>
          <label class="flex cursor-pointer items-start gap-3 rounded-xl bg-emerald-50/60 p-4 transition hover:bg-emerald-50">
            <%= hidden_field_tag :send_notice, "0" %>
            <%= check_box_tag :send_notice, "1", params[:send_notice] != "0",
                  class: "mt-0.5 h-5 w-5 rounded border-stone-300 text-emerald-700 focus:ring-emerald-700/30" %>
            <span class="min-w-0">
              <span class="block text-sm font-bold text-stone-800">받을돈 명의로 첫 안내 보내기</span>
              <span class="mt-1 block text-xs leading-relaxed text-stone-500">
                청구서를 보내는 첫 안내도 받을돈 명의로 대신합니다. 내 번호는 노출되지 않습니다.
                선택 해제 시 청구서 링크를 직접 전달하면 됩니다.
              </span>
            </span>
          </label>
          <div class="mt-4">
            <%= submit_tag "발행하기",
                  data: { turbo_confirm: "발행 후에는 내용을 수정할 수 없습니다. 발행하시겠습니까?" },
                  class: "inline-flex min-h-11 w-full cursor-pointer items-center justify-center rounded-xl bg-emerald-800 px-6 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 sm:w-auto" %>
          </div>
        <% end %>
      </div>
      <div class="mt-1 flex flex-wrap items-center gap-3">
        <%= link_to "수정", edit_app_invoice_path(@invoice),
              class: "inline-flex min-h-11 items-center rounded-xl border border-stone-300 bg-white px-5 text-sm font-semibold text-stone-600 transition hover:border-stone-400 hover:text-stone-800" %>
        <%= button_to "삭제", app_invoice_path(@invoice), method: :delete,
              data: { turbo_confirm: "이 초안을 삭제하시겠습니까?" },
              class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl border border-stone-300 bg-white px-5 text-sm font-semibold text-stone-500 transition hover:border-red-300 hover:text-red-600" %>
      </div>
    <% elsif @invoice.voidable? %>
      <%= button_to "무효 처리", void_app_invoice_path(@invoice), method: :patch,
            data: { turbo_confirm: "무효 처리한 청구서는 되돌릴 수 없습니다. 무효 처리하시겠습니까?" },
            class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl border border-stone-300 bg-white px-5 text-sm font-semibold text-stone-500 transition hover:border-red-300 hover:text-red-600" %>
    <% elsif @invoice.voided? %>
      <p class="text-sm text-stone-500">무효 처리된 청구서입니다. 필요하면 새 초안을 만들어 다시 발행하세요.</p>
    <% end %>
  </div>

  <%# ── 공유 링크(SHARE-1/2/6 — 표면 ③ 개봉). voided는 INV-6 폐기로 영역 미노출 ── %>
  <% if @invoice.token.present? %>
    <% expiry = link_expiry_notice(@invoice) %>
    <section class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6"
             data-controller="clipboard"
             data-clipboard-text-value="<%= viewer_url(@invoice.token) %>">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-base font-bold text-stone-800">청구서 링크</h2>
        <% if expiry %>
          <span class="text-xs font-bold <%= expiry[:tone] %>"><%= expiry[:label] %></span>
        <% end %>
      </div>
      <p class="mt-1 text-xs leading-relaxed text-stone-500">
        링크를 복사해 거래처 담당자에게 카카오톡 등으로 직접 전달하세요(SHARE-6). 상대가 열람하면
        상태가 「열람」으로 바뀌고 이력이 기록됩니다.
      </p>
      <div class="mt-3 flex flex-col gap-2 sm:flex-row">
        <%# readonly 입력 — 전체 URL 표시 겸 클립보드 fallback 수동 선택 소스 %>
        <input type="text" readonly value="<%= viewer_url(@invoice.token) %>"
               data-clipboard-target="source" aria-label="청구서 링크 URL"
               class="min-w-0 flex-1 select-all rounded-xl border border-stone-300 bg-stone-50 px-3.5 py-2.5 text-sm text-stone-700 shadow-sm focus:outline-none" />
        <div class="flex gap-2">
          <button type="button" data-action="clipboard#copy"
                  class="inline-flex min-h-11 flex-1 cursor-pointer items-center justify-center rounded-xl bg-emerald-800 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 sm:flex-none">
            <span data-clipboard-target="label">복사</span>
          </button>
          <%# SHARE-2 수동 재발급 — 기존 링크 즉시 무효, 유효기간(만기일+60일)은 유지 %>
          <%= button_to "재발급", regenerate_token_app_invoice_path(@invoice), method: :patch,
                data: { turbo_confirm: "기존 링크는 즉시 무효화됩니다. 재발급하시겠습니까?" },
                class: "inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl border border-stone-300 bg-white px-5 text-sm font-semibold text-stone-600 transition hover:border-stone-400 hover:text-stone-800" %>
        </div>
      </div>
      <% if expiry %>
        <p class="mt-2 text-xs leading-relaxed <%= expiry[:tone] %>"><%= expiry[:text] %></p>
      <% end %>
    </section>
  <% end %>

  <%# ── 열람 이력 요약(SHARE-3 — U1 가시화: 최초·최근 열람·횟수) ── %>
  <% if @view_events.any? %>
    <section class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">열람 이력</h2>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-stone-400">최초 열람</dt>
          <dd class="mt-0.5 font-medium tabular-nums text-stone-700"><%= display_datetime(@view_events.first.viewed_at) %></dd>
        </div>
        <div>
          <dt class="text-stone-400">최근 열람</dt>
          <dd class="mt-0.5 font-medium tabular-nums text-stone-700"><%= display_datetime(@view_events.last.viewed_at) %></dd>
        </div>
        <div>
          <dt class="text-stone-400">열람 횟수</dt>
          <dd class="mt-0.5 font-medium tabular-nums text-stone-700"><%= @view_events.size %>회</dd>
        </div>
      </dl>
    </section>
  <% end %>

  <%# ── 응답·약속 이력(F-PROMISE — 최신 우선. 청구서 약속 표시는 최신 응답 기준) ── %>
  <% if @promises.any? %>
    <section class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">응답·약속 이력</h2>
      <p class="mt-1 text-xs leading-relaxed text-stone-400">
        거래처가 청구서 링크에서 보낸 응답입니다. 가장 최근 응답이 현재 약속 기준입니다.
      </p>
      <ol class="mt-4 space-y-3">
        <% @promises.each_with_index do |promise, index| %>
          <li class="rounded-xl border border-stone-200 p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="text-sm font-bold text-stone-800">
                <%= promise_kind_label(promise) %>
                <% if index.zero? %>
                  <span class="ml-1.5 inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-bold text-emerald-800 ring-1 ring-inset ring-emerald-200">최신</span>
                <% end %>
              </p>
              <p class="text-xs tabular-nums text-stone-400"><%= display_datetime(promise.created_at) %> 접수</p>
            </div>
            <% if promise.promised_on.present? %>
              <p class="mt-1.5 text-sm text-stone-600">
                약속일 <span class="font-semibold tabular-nums text-stone-800"><%= display_date(promise.promised_on) %></span>
              </p>
            <% end %>
            <% if promise.inquiry? %>
              <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-stone-600"><%= promise.memo %></p>
              <% if promise.answered_at? %>
                <%# PROMISE-6 — 답변 완료. 채무자는 뷰어 「발행인 답변」에서 이 내용을 확인한다(P2 — 연락처 미노출). %>
                <div class="mt-3 rounded-lg bg-stone-50 p-3 ring-1 ring-inset ring-stone-200">
                  <p class="text-xs font-bold text-stone-500">
                    답변 완료 · <%= display_datetime(promise.answered_at) %>
                  </p>
                  <p class="mt-1 whitespace-pre-line text-sm leading-relaxed text-stone-800"><%= promise.answer %></p>
                </div>
              <% else %>
                <%# PROMISE-6 — 무답변 문의 답변 폼. 성공 303 / 실패 422(재렌더 — 작성 내용 보존). %>
                <%= form_with model: promise, url: answer_app_promise_path(promise), method: :patch, class: "mt-3" do |form| %>
                  <%= form.text_area :answer, rows: 3,
                        placeholder: "답변을 입력하면 거래처가 청구서 링크에서 확인합니다.",
                        aria_label: "답변 내용",
                        class: form_input_classes(promise, :answer) %>
                  <% if promise.errors.key?(:answer) %>
                    <p class="mt-1 text-xs font-semibold text-red-600"><%= form_error_message(promise, :answer) %></p>
                  <% end %>
                  <%= form.submit "답변 등록",
                        class: "mt-2 inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-emerald-800 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
                <% end %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

  <%# ── 자동 안내 현황(F-REM — REM-6/7/8·VIEW-7). 초안은 발송 대상이 아니므로 미노출.
      버튼 가시성은 상태 기준: 활성 → 보류 버튼, 청구 보류 → 재개 버튼, 수신거부·종결 → 안내만.
      수동 발송은 가드(보류·수신거부·종결)가 통과할 때만 노출해 죽은 버튼을 만들지 않는다 ── %>
  <% unless @invoice.draft? %>
    <section class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-base font-bold text-stone-800">자동 안내 현황</h2>
        <%= reminder_state_badges(@invoice) %>
      </div>
      <p class="mt-1 text-xs leading-relaxed text-stone-500">
        받을돈 명의로 거래처에게 단계별 안내를 대신 보냅니다. 평일 오전 9시~오후 6시에만 발송됩니다.
      </p>

      <% if @invoice.client.refused? %>
        <%# VIEW-7 — 수신 거부 접수 안내(noti_refusal과 같은 「즉시 중단」 명시 톤).
            재개 경로가 없다 — 채무자 의사 표현이며 P1상 U1이 되돌리지 않는다. %>
        <div class="mt-3 rounded-xl bg-stone-50 p-4 ring-1 ring-inset ring-stone-200" role="status">
          <p class="text-sm font-bold text-stone-700">이 거래처가 추가 안내 수신을 거부했습니다</p>
          <p class="mt-1 text-xs leading-relaxed text-stone-500">
            해당 번호의 모든 자동 안내는 즉시 중단되었습니다. 이후 진행은 거래처와의 직접 소통으로 확인해 주세요.
          </p>
        </div>
      <% elsif @invoice.reminders_suspended? || @invoice.client.reminders_suspended? %>
        <div class="mt-3 rounded-xl bg-amber-50 p-4 ring-1 ring-inset ring-amber-200" role="status">
          <p class="text-sm font-bold text-stone-800">자동 안내가 보류 중입니다</p>
          <p class="mt-1 text-xs leading-relaxed text-stone-500">
            <%= @invoice.client.reminders_suspended? ? "거래처 단위로 보류 중입니다 — 거래처 화면에서 재개할 수 있습니다." : "재개하면 다음 단계 안내부터 이어집니다." %>
          </p>
        </div>
      <% elsif @invoice.sequence_finished? %>
        <%# REM-12·13 — 시퀀스 자동 종결(final_d14·promise_overdue 발송 성공·수신거부·무효).
            재개는 U1의 수동 재요청으로만 가능하다(자동 재개 없음 — 아래 「안내 다시 보내기」). %>
        <div class="mt-3 rounded-xl bg-stone-50 p-4 ring-1 ring-inset ring-stone-200" role="status">
          <p class="text-sm font-bold text-stone-700">정기 안내를 마무리했습니다</p>
          <p class="mt-1 text-xs leading-relaxed text-stone-500">
            단계별 자동 안내가 종결되었습니다. 이후 진행은 응답·입금 기록으로 확인해 주세요.
            필요하면 「안내 다시 보내기」로 남은 단계를 다시 진행할 수 있습니다.
          </p>
        </div>
      <% end %>

      <% if @invoice.unsettled? %>
        <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-stone-100 pt-4">
          <% if @invoice.reminders_active? %>
            <%= button_to "안내 보류하기", suspend_reminders_app_invoice_path(@invoice), method: :patch,
                  data: { turbo_confirm: "이 청구서의 자동 안내를 멈춥니다. 보류하시겠습니까?" },
                  class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl border border-stone-300 bg-white px-5 text-sm font-semibold text-stone-600 transition hover:border-stone-400 hover:text-stone-800" %>
            <%= button_to "지금 1통 보내기", remind_app_invoice_path(@invoice), method: :post,
                  data: { turbo_confirm: "현재 상황에 맞는 안내 1통을 거래처에게 보냅니다. 발송하시겠습니까?" },
                  class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl bg-emerald-800 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
            <%# C-2 — 참인 안내 문구가 없는 창(만기 도과 + 약속 전날 이전)은 nil이라 라벨 행을 생략한다 %>
            <% if @manual_template_key %>
              <p class="text-xs text-stone-400">
                다음 안내: <span class="font-bold text-stone-600"><%= message_template_label(@manual_template_key) %></span>
              </p>
            <% end %>
          <% elsif @invoice.reminders_suspended? %>
            <%= button_to "안내 재개하기", resume_reminders_app_invoice_path(@invoice), method: :patch,
                  class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl border border-emerald-700/40 bg-emerald-50 px-5 text-sm font-bold text-emerald-800 transition hover:bg-emerald-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
          <% elsif @invoice.sequence_finished? %>
            <%# REM-12·13 — 시퀀스 수동 재개 진입점(자동 재개 없음). 종결 해소 후 다음 평일
                스캔이 남은 미발송 단계부터 이어서 보낸다(소급 창 밖 단계는 차단). %>
            <%= button_to "안내 다시 보내기", restart_reminders_app_invoice_path(@invoice), method: :post,
                  data: { turbo_confirm: "정기 안내를 다시 진행합니다. 남은 단계부터 이어서 발송됩니다. 다시 진행하시겠습니까?" },
                  class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl border border-emerald-700/40 bg-emerald-50 px-5 text-sm font-bold text-emerald-800 transition hover:bg-emerald-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
            <p class="text-xs text-stone-400">
              종결 시점에 남아 있던 단계부터 이어서 안내합니다. 더 이상 보낼 단계가 없으면 안내하지 않습니다.
            </p>
          <% end %>
        </div>
        <% unless @reminder_eligible %>
          <%# REM-8 — 무료 플랜은 자동 발송이 없다(수동 버튼이 유일한 발송 경로) %>
          <p class="mt-2 text-xs leading-relaxed text-stone-500">
            무료 플랜은 자동 발송이 없습니다 — 「지금 1통 보내기」로 원할 때 직접 안내할 수 있습니다.
          </p>
        <% end %>
      <% end %>

      <%# REM-6 — 발송 이력(최신 우선). 성공·실패·제외 모든 시도의 영구 기록(P4 — 삭제 경로 없음) %>
      <% if @message_logs.any? %>
        <div class="mt-4 border-t border-stone-100 pt-4">
          <h3 class="text-sm font-bold text-stone-800">발송 이력</h3>
          <ul class="mt-2 divide-y divide-stone-100">
            <% @message_logs.each do |log| %>
              <li class="flex flex-wrap items-center justify-between gap-2 py-2.5 text-sm">
                <div class="min-w-0">
                  <p class="font-medium text-stone-700"><%= message_template_label(log.template_key) %></p>
                  <p class="mt-0.5 text-xs tabular-nums text-stone-400">
                    <%= display_datetime(log.sent_at || log.created_at) %> · <%= message_log_channel_label(log) %>
                    <% if log.pending? && log.scheduled_at.present? %>
                      · <%= display_datetime(log.scheduled_at) %> 예약
                    <% end %>
                  </p>
                  <% if log.skipped? %>
                    <p class="mt-0.5 text-xs text-stone-500"><%= message_log_skip_reason(log.error_code) %></p>
                  <% elsif log.failed? %>
                    <p class="mt-0.5 text-xs text-orange-600"><%= log.error_message.presence || "발송에 실패했습니다" %></p>
                  <% end %>
                </div>
                <%= message_log_status_badge(log) %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# ── 청구 기본 정보·입금 계좌(INV-1 스냅샷) ── %>
  <div class="mt-6 grid gap-4 lg:grid-cols-2">
    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">청구 정보</h2>
      <dl class="mt-4 space-y-2.5 text-sm">
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-stone-400">거래처</dt>
          <dd class="min-w-0 font-medium text-stone-700"><%= @invoice.client.name %></dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-stone-400">담당자</dt>
          <dd class="font-medium text-stone-700"><%= @invoice.client.contact_name %> 님</dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-stone-400">만기일</dt>
          <dd class="font-medium tabular-nums text-stone-700">
            <%= display_date(@invoice.due_on) %>
            <% if @invoice.days_overdue.positive? %>
              <span class="ml-1.5 font-bold text-orange-600">연체 <%= @invoice.days_overdue %>일</span>
            <% end %>
          </dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-stone-400">발행자</dt>
          <dd class="font-medium text-stone-700"><%= @invoice.issuer_display_name %></dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-stone-400">부가세</dt>
          <dd class="font-medium text-stone-700"><%= @invoice.separate? ? "별도" : "포함" %></dd>
        </div>
      </dl>
    </section>

    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">입금 계좌</h2>
      <dl class="mt-4 space-y-2.5 text-sm">
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-stone-400">은행</dt>
          <dd class="font-medium text-stone-700"><%= @invoice.bank_name %></dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-stone-400">계좌번호</dt>
          <dd class="font-medium tabular-nums text-stone-700"><%= @invoice.account_number %></dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-stone-400">예금주</dt>
          <dd class="font-medium text-stone-700"><%= @invoice.account_holder %></dd>
        </div>
      </dl>
    </section>
  </div>

  <%# ── 품목 표(INV-1 복수 행) ── %>
  <section class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-base font-bold text-stone-800">품목</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[560px] text-left text-sm">
        <thead>
          <tr class="border-b border-stone-200 text-xs font-bold text-stone-500">
            <th scope="col" class="py-2.5 pr-4">품목</th>
            <th scope="col" class="py-2.5 pr-4 text-right">수량</th>
            <th scope="col" class="py-2.5 pr-4 text-right">단가</th>
            <th scope="col" class="py-2.5 text-right">금액</th>
          </tr>
        </thead>
        <tbody>
          <% @invoice.items.each do |item| %>
            <tr class="border-b border-stone-100 last:border-0">
              <td class="py-3 pr-4 font-medium text-stone-700"><%= item.description %></td>
              <td class="py-3 pr-4 text-right tabular-nums text-stone-600"><%= number_with_delimiter(item.quantity) %></td>
              <td class="py-3 pr-4 text-right tabular-nums text-stone-600"><%= won(item.unit_price) %></td>
              <td class="py-3 text-right font-bold tabular-nums text-stone-800"><%= won(item.quantity * item.unit_price) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <%# ── 금액 내역(INV-2 — 공급가액·원천징수액·실수령액 분해 표기) ── %>
  <section class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-base font-bold text-stone-800">금액 내역</h2>
    <dl class="mt-4 max-w-md space-y-2.5 text-sm">
      <div class="flex items-baseline justify-between gap-4">
        <dt class="text-stone-500">공급가액</dt>
        <dd class="font-medium tabular-nums text-stone-800"><%= won(@invoice.subtotal) %></dd>
      </div>
      <div class="flex items-baseline justify-between gap-4">
        <dt class="text-stone-500">부가세<%= @invoice.separate? ? "" : " (총액 포함 — 역산)" %></dt>
        <dd class="font-medium tabular-nums text-stone-800"><%= won(@invoice.tax_amount) %></dd>
      </div>
      <div class="flex items-baseline justify-between gap-4 border-t border-stone-200 pt-3">
        <dt class="font-bold text-stone-800">청구 총액</dt>
        <dd class="text-base font-extrabold tabular-nums text-emerald-900"><%= won(@invoice.total_amount) %></dd>
      </div>
      <% if @invoice.withholding_enabled? %>
        <div class="flex items-baseline justify-between gap-4">
          <dt class="text-orange-600">원천징수 (공급가액의 3.3%)</dt>
          <dd class="font-medium tabular-nums text-orange-600">−<%= won(@invoice.withholding_amount) %></dd>
        </div>
        <div class="flex items-baseline justify-between gap-4">
          <dt class="font-bold text-stone-800">실수령액</dt>
          <dd class="text-base font-extrabold tabular-nums text-stone-900"><%= won(@invoice.net_amount) %></dd>
        </div>
      <% end %>
    </dl>
    <% if @invoice.withholding_enabled? %>
      <p class="mt-4 text-xs leading-relaxed text-stone-400">
        공급가액의 3.3% 원천징수 후 실수령액 기준으로 안내됩니다.
      </p>
    <% end %>
  </section>

  <%# ── 입금(F-PAY — PAY-1 원클릭 마감·PAY-2 부분입금). 초안은 입금 대상이 아니므로 미노출.
      무효는 이력 열람만(P4 기록 보존). 마감·기록은 U1 전용(PROMISE-7 — 뷰어 ③ 변경 없음) ── %>
  <% unless @invoice.draft? %>
    <section class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-base font-bold text-stone-800">입금</h2>
        <p class="text-sm text-stone-500">
          잔액
          <span class="ml-1 text-lg font-extrabold tabular-nums <%= @invoice.paid? ? "text-green-700" : "text-stone-800" %>">
            <%= won(@invoice.remaining_amount) %>
          </span>
        </p>
      </div>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-stone-400">청구 총액</dt>
          <dd class="mt-0.5 font-medium tabular-nums text-stone-700"><%= won(@invoice.total_amount) %></dd>
        </div>
        <div>
          <dt class="text-stone-400">입금 누계</dt>
          <dd class="mt-0.5 font-medium tabular-nums text-stone-700"><%= won(@invoice.payments_total) %></dd>
        </div>
        <div>
          <dt class="text-stone-400">잔액</dt>
          <dd class="mt-0.5 font-bold tabular-nums <%= @invoice.paid? ? "text-green-700" : "text-stone-800" %>">
            <%= won(@invoice.remaining_amount) %>
          </dd>
        </div>
      </dl>

      <%# PAY-1 — 수금 완료 확정 표시(DESIGN-2 완료 녹색). 마감 버튼·폼은 미노출 %>
      <% if @invoice.paid? %>
        <div class="mt-4 rounded-xl bg-green-50 p-4 ring-1 ring-inset ring-green-200">
          <p class="text-sm font-bold text-green-700">수금이 완료되었습니다</p>
          <% if @payments.any? %>
            <p class="mt-1 text-xs leading-relaxed text-green-700/80">
              <%= display_date(@payments.first.paid_on) %> 입금 분까지 확인되어 마감했습니다.
            </p>
          <% end %>
        </div>
      <% elsif @invoice.unsettled? %>
        <%# PAY-1 — 원클릭 마감: 잔액 전액 1건 기록 + 마감 전이(금액은 서버가 잔액 기준값으로
            계산 — 폼은 날짜만 제출). 되돌릴 수 없는 전이 — turbo_confirm(규약 §7.4) %>
        <div class="mt-4 rounded-xl bg-emerald-50/60 p-4 ring-1 ring-inset ring-emerald-100">
          <p class="text-sm font-bold text-emerald-900">원클릭 마감</p>
          <p class="mt-1 text-xs leading-relaxed text-stone-500">
            잔액 <%= won(@invoice.remaining_amount) %>을 입금 확인 처리하고 수금을 마감합니다.
          </p>
          <%= form_with model: @payment, url: app_invoice_payments_path(@invoice), class: "mt-3" do |form| %>
            <%# PAY-4 — 마감 감사 알림(기본 켬). hidden 0 + checked 1 쌍이므로 해제가 명시 전송되고,
                파라미터 미전송도 컨트롤러가 켬으로 해석한다. %>
            <label class="flex cursor-pointer items-start gap-3 rounded-xl bg-white p-3.5 ring-1 ring-inset ring-stone-200 transition hover:ring-stone-300">
              <%= form.check_box :send_thanks, checked: true,
                    class: "mt-0.5 h-5 w-5 rounded border-stone-300 text-emerald-700 focus:ring-emerald-700/30" %>
              <span class="min-w-0">
                <span class="block text-sm font-bold text-stone-800">거래처에게 확인·감사 안내 보내기</span>
                <span class="mt-1 block text-xs leading-relaxed text-stone-500">
                  마감 확인 알림톡을 받을돈 명의로 보냅니다. 거래 마무리를 부드럽게 남깁니다.
                </span>
              </span>
            </label>
            <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-end">
              <div>
                <%= form.label :paid_on, "입금일", class: "text-xs font-bold text-stone-500" %>
                <%= form.date_field :paid_on, class: form_input_classes(@payment, :paid_on) + " sm:w-44" %>
                <% if @payment.errors.key?(:paid_on) %>
                  <p class="mt-1 text-xs font-semibold text-red-600"><%= form_error_message(@payment, :paid_on) %></p>
                <% end %>
              </div>
              <%= form.submit "입금 확인하고 마감",
                    data: { turbo_confirm: "마감하면 되돌릴 수 없습니다. 입금을 확인하고 마감하시겠습니까?" },
                    class: "inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-emerald-800 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
            </div>
          <% end %>
        </div>
        <%# PAY-2 — 부분입금 기록: 금액·날짜. 잔액 이하만 허용(초과 422 — 결정 #3) %>
        <div class="mt-4 border-t border-stone-100 pt-4">
          <p class="text-sm font-bold text-stone-800">부분입금 기록</p>
          <p class="mt-1 text-xs leading-relaxed text-stone-500">
            나눠 받은 금액을 기록하면 잔액이 자동으로 재계산됩니다.
          </p>
          <%= form_with model: @payment, url: app_invoice_payments_path(@invoice),
                class: "mt-3 flex flex-col gap-2 sm:flex-row sm:items-end" do |form| %>
            <div class="flex-1">
              <%= form.label :amount, "입금 금액", class: "text-xs font-bold text-stone-500" %>
              <%= form.number_field :amount, min: 1, step: 1, inputmode: "numeric",
                    placeholder: "예: 50000", aria_label: "입금 금액(원)",
                    class: form_input_classes(@payment, :amount) %>
              <% if @payment.errors.key?(:amount) %>
                <p class="mt-1 text-xs font-semibold text-red-600"><%= form_error_message(@payment, :amount) %></p>
              <% end %>
            </div>
            <div>
              <%= form.label :paid_on, "입금일", class: "text-xs font-bold text-stone-500" %>
              <%= form.date_field :paid_on, class: form_input_classes(@payment, :paid_on) + " sm:w-44" %>
              <% if @payment.errors.key?(:paid_on) %>
                <p class="mt-1 text-xs font-semibold text-red-600"><%= form_error_message(@payment, :paid_on) %></p>
              <% end %>
            </div>
            <%= form.submit "부분입금 기록",
                  class: "inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl border border-stone-300 bg-white px-5 text-sm font-semibold text-stone-600 transition hover:border-stone-400 hover:text-stone-800" %>
          <% end %>
        </div>
      <% end %>

      <%# 입금 이력 — 입금일 내림차순(PAY-2 잔액 재계산의 근거 이력·P4 영구 기록) %>
      <% if @payments.any? %>
        <div class="mt-4 border-t border-stone-100 pt-4">
          <h3 class="text-sm font-bold text-stone-800">입금 이력</h3>
          <ul class="mt-2 divide-y divide-stone-100">
            <% @payments.each do |payment| %>
              <li class="flex items-center justify-between gap-3 py-2.5 text-sm">
                <span class="tabular-nums text-stone-600"><%= display_date(payment.paid_on) %></span>
                <span class="font-bold tabular-nums text-stone-800"><%= won(payment.amount) %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
