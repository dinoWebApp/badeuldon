<%# 청구서 초안 작성·수정 폼(INV-1~3) — 거래처 선택·품목 행 동적 편집(CLIENT-2 프리필)·
    부가세 모드·원천징수(INV-2)·만기일(INV-3)·계좌(프로필 프리필)·금액 실시간 요약.
    실시간 계산은 서버 산식(Invoice.compute_amounts)과 동일 규칙이며 최종값은 서버 계산 기준이다. %>
<%= form_with model: [:app, invoice],
      data: { controller: "invoice-form",
              invoice_form_items_value: invoice_library_json(items),
              invoice_form_max_items_value: Invoice::MAX_ITEMS },
      class: "mt-8" do |form| %>

  <%# 검증 실패 — 품목 행 오류는 각 행 안내로 이동시켜 중복 표기를 피한다 %>
  <% header_errors = invoice.errors.reject { |e| e.attribute.to_s.start_with?("items") } %>
  <% if header_errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-600" role="alert">
      <ul class="list-disc space-y-1 pl-5">
        <% header_errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
      <%# ── 기본 정보 ── %>
      <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
        <h2 class="text-base font-bold text-stone-800">기본 정보</h2>

        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :client_id, "거래처", class: "block text-sm font-medium text-stone-700" %>
            <%= form.collection_select :client_id, clients, :id, :name, { prompt: "거래처 선택" },
                  class: form_input_classes(invoice, :client_id) %>
            <p class="mt-1.5 text-xs text-stone-500">거래처가 없으면 먼저 등록해 주세요.</p>
            <% if form_error_message(invoice, :client_id) %>
              <p class="mt-1.5 text-xs font-medium text-red-600"><%= form_error_message(invoice, :client_id) %></p>
            <% end %>
          </div>
          <div>
            <%= form.label :due_on, "만기일", class: "block text-sm font-medium text-stone-700" %>
            <%= form.date_field :due_on, required: true,
                  class: form_input_classes(invoice, :due_on) %>
            <p class="mt-1.5 text-xs text-stone-500">기본값은 30일 후입니다(INV-3).</p>
            <% if form_error_message(invoice, :due_on) %>
              <p class="mt-1.5 text-xs font-medium text-red-600"><%= form_error_message(invoice, :due_on) %></p>
            <% end %>
          </div>
        </div>
      </section>

      <%# ── 품목 — 행 동적 편집(Stimulus invoice-form 1개: 추가·제거·프리필·요약 계산) ── %>
      <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-base font-bold text-stone-800">품목</h2>
          <button type="button" data-action="invoice-form#addRow" data-invoice-form-target="addRowButton"
                  class="inline-flex min-h-11 items-center rounded-xl border border-emerald-700/40 bg-emerald-50 px-4 text-sm font-bold text-emerald-800 transition hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-40">
            + 품목 행 추가
          </button>
        </div>

        <div data-invoice-form-target="rows" class="mt-4 space-y-3">
          <%= form.fields_for :items do |item_form| %>
            <%= render "item_fields", form: item_form, library_items: items %>
          <% end %>
        </div>

        <%# 추가 행 템플릿 — __ROW_INDEX__ 자리표를 Stimulus가 고유 인덱스로 치환해 붙인다 %>
        <template data-invoice-form-target="rowTemplate">
          <%= form.fields_for :items, InvoiceItem.new, child_index: "__ROW_INDEX__" do |item_form| %>
            <%= render "item_fields", form: item_form, library_items: items %>
          <% end %>
        </template>

        <% if invoice.errors.any? { |e| e.attribute.to_s.start_with?("items") } %>
          <p class="mt-3 text-xs font-medium text-red-600">입력하지 않은 품목 행이 있습니다. 각 행의 안내를 확인해 주세요.</p>
        <% end %>
      </section>

      <%# ── 세금 설정 ── %>
      <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
        <h2 class="text-base font-bold text-stone-800">세금 설정</h2>

        <fieldset class="mt-5">
          <legend class="text-sm font-medium text-stone-700">부가세</legend>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <div class="relative">
              <%= form.radio_button :tax_mode, "separate", checked: invoice.separate?, class: "peer sr-only" %>
              <%= form.label :tax_mode, value: "separate",
                    class: "block h-full cursor-pointer rounded-xl border border-stone-300 bg-white p-4 transition hover:border-stone-400 peer-checked:border-emerald-700 peer-checked:ring-2 peer-checked:ring-emerald-700/30 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-700/50" do %>
                <span class="block text-sm font-bold text-stone-800">별도</span>
                <span class="mt-1 block text-xs leading-relaxed text-stone-500">공급가액에 부가세 10%를 더해 청구합니다.</span>
              <% end %>
            </div>
            <div class="relative">
              <%= form.radio_button :tax_mode, "included", checked: invoice.included?, class: "peer sr-only" %>
              <%= form.label :tax_mode, value: "included",
                    class: "block h-full cursor-pointer rounded-xl border border-stone-300 bg-white p-4 transition hover:border-stone-400 peer-checked:border-emerald-700 peer-checked:ring-2 peer-checked:ring-emerald-700/30 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-700/50" do %>
                <span class="block text-sm font-bold text-stone-800">포함</span>
                <span class="mt-1 block text-xs leading-relaxed text-stone-500">입력 금액에 부가세가 포함된 총액으로 청구합니다.</span>
              <% end %>
            </div>
          </div>
        </fieldset>

        <div class="mt-5 flex items-start gap-3 rounded-xl bg-stone-50 p-4">
          <%= form.check_box :withholding_enabled, data: { invoice_form_target: "withholdingCheckbox" },
                class: "mt-0.5 h-5 w-5 rounded border-stone-300 text-emerald-700 focus:ring-emerald-700/30" %>
          <div>
            <%= form.label :withholding_enabled, "원천징수 3.3% 표기", class: "text-sm font-bold text-stone-800" %>
            <p class="mt-1 text-xs leading-relaxed text-stone-500">
              공급가액의 3.3% 원천징수 후 실수령액 표기 — 프리랜서(사업자 없음) 유형에 해당합니다.
            </p>
          </div>
        </div>
      </section>

      <%# ── 입금 계좌 — 프로필 기본값 프리필, 건별 변경 가능(INV-1) ── %>
      <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
        <h2 class="text-base font-bold text-stone-800">입금 계좌</h2>
        <p class="mt-1 text-xs text-stone-500">프로필 계좌로 채워져 있습니다. 이 청구서 한 건에만 다른 계좌를 쓸 수 있습니다.</p>

        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :bank_name, "은행", class: "block text-sm font-medium text-stone-700" %>
            <%= form.select :bank_name, bank_options, { prompt: "은행 선택" },
                  class: form_input_classes(invoice, :bank_name) %>
            <% if form_error_message(invoice, :bank_name) %>
              <p class="mt-1.5 text-xs font-medium text-red-600"><%= form_error_message(invoice, :bank_name) %></p>
            <% end %>
          </div>
          <div>
            <%= form.label :account_holder, "예금주", class: "block text-sm font-medium text-stone-700" %>
            <%= form.text_field :account_holder, required: true, maxlength: 30,
                  class: form_input_classes(invoice, :account_holder) %>
            <% if form_error_message(invoice, :account_holder) %>
              <p class="mt-1.5 text-xs font-medium text-red-600"><%= form_error_message(invoice, :account_holder) %></p>
            <% end %>
          </div>
        </div>

        <div class="mt-5">
          <%= form.label :account_number, "계좌번호", class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field :account_number, required: true, inputmode: "numeric", autocomplete: "off", maxlength: 24,
                data: { controller: "account-number" },
                class: form_input_classes(invoice, :account_number) %>
          <p class="mt-1.5 text-xs text-stone-500">숫자만 입력해도 하이픈이 자동으로 붙습니다.</p>
          <% if form_error_message(invoice, :account_number) %>
            <p class="mt-1.5 text-xs font-medium text-red-600"><%= form_error_message(invoice, :account_number) %></p>
          <% end %>
        </div>
      </section>
    </div>

    <%# ── 금액 실시간 요약 — 최종값은 저장 시 서버 계산 기준 ── %>
    <aside class="lg:col-span-1">
      <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm lg:sticky lg:top-20 sm:p-6" aria-label="금액 요약">
        <h2 class="text-base font-bold text-stone-800">금액 요약</h2>
        <dl class="mt-4 space-y-2.5 text-sm" data-action="input->invoice-form#recalculate change->invoice-form#recalculate">
          <div class="flex items-baseline justify-between gap-4">
            <dt class="text-stone-500">공급가액</dt>
            <dd class="font-medium tabular-nums text-stone-800" data-invoice-form-target="subtotalValue">0원</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4">
            <dt class="text-stone-500">부가세</dt>
            <dd class="font-medium tabular-nums text-stone-800" data-invoice-form-target="taxValue">0원</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-t border-stone-200 pt-3">
            <dt class="font-bold text-stone-800">청구 총액</dt>
            <dd class="text-lg font-extrabold tabular-nums text-emerald-900" data-invoice-form-target="totalValue">0원</dd>
          </div>
          <div data-invoice-form-target="withholdingBlock" class="hidden space-y-2.5">
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-orange-600">원천징수 (3.3%)</dt>
              <dd class="font-medium tabular-nums text-orange-600" data-invoice-form-target="withholdingValue">0원</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="font-bold text-stone-800">실수령액</dt>
              <dd class="font-extrabold tabular-nums text-stone-900" data-invoice-form-target="netValue">0원</dd>
            </div>
          </div>
        </dl>
        <p class="mt-4 text-xs leading-relaxed text-stone-400">
          부가세는 반올림, 원천징수는 공급가액의 3.3% 내림으로 계산됩니다. 최종 금액은 저장 시 서버 계산 기준입니다.
        </p>
      </section>
    </aside>
  </div>

  <div class="mt-8 border-t border-stone-200 pt-6">
    <%= form.submit "초안 저장",
          class: "w-full cursor-pointer rounded-xl bg-emerald-800 px-6 py-3 text-base font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 sm:w-auto" %>
    <%= link_to invoice.persisted? ? app_invoice_path(invoice) : app_invoices_path,
          class: "mt-3 block w-full rounded-xl border border-stone-300 bg-white px-6 py-3 text-center text-sm font-semibold text-stone-600 transition hover:border-stone-400 hover:text-stone-800 sm:mt-0 sm:inline-block sm:w-auto" do %>
      취소
    <% end %>
  </div>
<% end %>
