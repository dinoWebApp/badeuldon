<%# 청구서 목록 행 — index·대시보드(DASH-4) 공용. 상태 뱃지(DESIGN-2)·연체일 수치 강조(DESIGN-5). %>
<tr class="border-b border-stone-100 transition last:border-0 hover:bg-stone-50">
  <td class="whitespace-nowrap px-4 py-3.5 text-sm font-semibold text-stone-700">
    <%= link_to invoice.issue_number || "초안", app_invoice_path(invoice), class: "transition hover:text-emerald-800" %>
  </td>
  <td class="max-w-36 truncate px-4 py-3.5 text-sm text-stone-600"><%= invoice.client.name %></td>
  <td class="whitespace-nowrap px-4 py-3.5 text-sm tabular-nums text-stone-600"><%= display_date(invoice.due_on) %></td>
  <td class="px-4 py-3.5"><%= invoice_status_badge(invoice) %></td>
  <td class="whitespace-nowrap px-4 py-3.5 text-sm">
    <% if invoice.days_overdue.positive? %>
      <span class="font-bold tabular-nums text-orange-600"><%= invoice.days_overdue %>일</span>
    <% else %>
      <span class="text-stone-300" aria-hidden="true">—</span>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-4 py-3.5 text-right text-sm font-bold tabular-nums text-stone-800">
    <%= won(invoice.total_amount) %>
  </td>
</tr>
