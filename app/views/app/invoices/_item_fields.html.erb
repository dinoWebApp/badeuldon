<%# 청구서 품목 행 필드 — 작성·수정 폼의 한 행. 라이브러리 select는 전송값이 없는 보조 UI이며
    선택 시 Stimulus(invoice-form)가 설명·단가를 프리필한다(CLIENT-2). 행 제거는 초안 본문 편집이다. %>
<div data-invoice-form-target="row"
     class="grid grid-cols-2 gap-3 rounded-xl border border-stone-200 bg-stone-50/50 p-3 sm:grid-cols-12">
  <div class="col-span-2 sm:col-span-3">
    <select aria-label="품목 라이브러리에서 선택"
            data-invoice-form-target="itemSelect"
            data-action="invoice-form#prefillFromLibrary"
            class="block w-full rounded-xl border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-800 shadow-sm transition hover:border-stone-400 focus:outline-none focus:ring-2 focus:border-emerald-700 focus:ring-emerald-700/30">
      <option value="">라이브러리에서 선택</option>
      <%= options_from_collection_for_select(library_items, :id, :name) %>
    </select>
  </div>

  <div class="col-span-2 sm:col-span-4">
    <%= form.label :description, "품목 설명", class: "block text-xs font-medium text-stone-500" %>
    <%= form.text_field :description, required: true, maxlength: 100,
          placeholder: "예) 랜딩 페이지 디자인",
          class: form_input_classes(form.object, :description) %>
    <% if form_error_message(form.object, :description) %>
      <p class="mt-1 text-xs font-medium text-red-600"><%= form_error_message(form.object, :description) %></p>
    <% end %>
  </div>

  <div class="sm:col-span-2">
    <%= form.label :quantity, "수량", class: "block text-xs font-medium text-stone-500" %>
    <%= form.number_field :quantity, required: true, min: 1, max: InvoiceItem::MAX_QUANTITY, step: 1,
          inputmode: "numeric", data: { role: "quantity" },
          class: form_input_classes(form.object, :quantity) %>
    <% if form_error_message(form.object, :quantity) %>
      <p class="mt-1 text-xs font-medium text-red-600"><%= form_error_message(form.object, :quantity) %></p>
    <% end %>
  </div>

  <div class="sm:col-span-2">
    <%= form.label :unit_price, "단가(원)", class: "block text-xs font-medium text-stone-500" %>
    <%= form.number_field :unit_price, required: true, min: 0, max: InvoiceItem::MAX_UNIT_PRICE, step: 1,
          inputmode: "numeric", data: { role: "unitPrice" },
          class: form_input_classes(form.object, :unit_price) %>
    <% if form_error_message(form.object, :unit_price) %>
      <p class="mt-1 text-xs font-medium text-red-600"><%= form_error_message(form.object, :unit_price) %></p>
    <% end %>
  </div>

  <div class="flex items-end justify-end sm:col-span-1">
    <%= form.check_box :_destroy, class: "hidden", data: { role: "destroyFlag" } %>
    <button type="button" data-action="invoice-form#removeRow" aria-label="품목 행 제거"
            class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-stone-400 transition hover:bg-red-50 hover:text-red-600">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
      </svg>
    </button>
  </div>
</div>
