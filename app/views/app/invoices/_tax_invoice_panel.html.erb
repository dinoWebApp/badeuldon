<%# TAX-1/2 — paid 청구 상세의 전자세금계산서 패널. 분기(@tax_invoice_guard)는
    App::InvoicesController#set_tax_invoice_context가 산출한다(뷰의 쿼리·모델 호출 금지):
    - 기존 발행 기록(@tax_invoice) 있음 → 승인번호·상태·발행일 표시(TAX-2·취소·실패 포함)
    - settings_missing → 발행 설정 안내 / client_missing → 거래처 사업자번호 안내
    - ready → 발행 요청(미리보기) 버튼 %>
<% if @invoice.paid? %>
  <% if @tax_invoice %>
    <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-900/5 p-4 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm font-bold text-emerald-900">전자세금계산서</p>
        <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-bold <%= @tax_invoice.issued? ? "bg-emerald-50 text-emerald-700" : "bg-orange-50 text-orange-600" %>">
          <%= @tax_invoice.status_label %>
        </span>
      </div>
      <dl class="mt-2 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-[9rem_1fr]">
        <dt class="text-stone-500">국세청 승인번호</dt>
        <dd class="tabular-nums font-medium text-stone-800"><%= @tax_invoice.nts_send_key.presence || "승인 대기 중" %></dd>
        <dt class="text-stone-500">작성일자</dt>
        <dd class="tabular-nums font-medium text-stone-800"><%= @tax_invoice.write_date ? display_date(@tax_invoice.write_date) : "-" %></dd>
      </dl>
      <%# W-6 — 발행 내역(TAX-2 상태·취소·승인번호)의 실제 조회 화면은 발행 주문 상세다(order optional — present 가드). %>
      <% if @tax_invoice.order_id.present? %>
        <%= link_to "발행 내역 보기", app_tax_invoice_path(@tax_invoice.order_id),
              class: "mt-3 inline-flex min-h-11 items-center rounded-xl border border-stone-300 bg-white px-4 py-2 text-sm font-bold text-stone-700 transition hover:bg-stone-50" %>
      <% end %>
    </div>
  <% elsif @tax_invoice_guard == :paid_pending %>
    <div class="mt-6 rounded-2xl border border-orange-200 bg-orange-50/50 p-4 shadow-sm">
      <p class="text-sm font-bold text-stone-800">전자세금계산서 발행 처리 확인</p>
      <p class="mt-0.5 text-xs leading-relaxed text-stone-500">
        발행 결제는 완료되었으나 발행 기록이 아직 생성되지 않았습니다. 기존 주문에서 상태를
        확인해 주세요(재결제는 필요 없습니다).
      </p>
      <%= link_to "발행 주문 확인", app_tax_invoice_path(@tax_invoice_order),
            class: "mt-3 inline-flex min-h-11 items-center rounded-xl border border-stone-300 bg-white px-4 py-2 text-sm font-bold text-stone-700 transition hover:bg-stone-50" %>
    </div>
  <% elsif @tax_invoice_guard == :ready %>
    <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-900/5 p-4 shadow-sm">
      <p class="text-sm font-bold text-emerald-900">전자세금계산서 발행</p>
      <p class="mt-0.5 text-xs leading-relaxed text-stone-500">
        수금이 마감된 청구를 전자세금계산서(정발행·영수)로 발행할 수 있습니다.
        건당 <%= won(TaxInvoice::ISSUE_FEE) %>.
      </p>
      <%= link_to "전자세금계산서 발행", new_app_tax_invoice_path(invoice_id: @invoice.id),
            class: "mt-3 inline-flex min-h-11 items-center rounded-xl bg-emerald-800 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900" %>
    </div>
  <% elsif @tax_invoice_guard == :settings_missing %>
    <div class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm">
      <p class="text-sm font-bold text-stone-800">전자세금계산서 발행 설정 필요</p>
      <p class="mt-0.5 text-xs leading-relaxed text-stone-500">
        사업자 정보와 공동인증서 등록을 완료하면 이 청구를 전자세금계산서로 발행할 수 있습니다
        (건당 <%= won(TaxInvoice::ISSUE_FEE) %>, 제휴사 바로빌 연동).
      </p>
      <%= link_to "발행 설정하기", app_tax_invoice_setting_path,
            class: "mt-3 inline-flex min-h-11 items-center rounded-xl border border-emerald-700 bg-white px-4 py-2 text-sm font-bold text-emerald-800 transition hover:bg-emerald-50" %>
    </div>
  <% elsif @tax_invoice_guard == :client_missing %>
    <div class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm">
      <p class="text-sm font-bold text-stone-800">전자세금계산서 발행 비대상</p>
      <p class="mt-0.5 text-xs leading-relaxed text-stone-500">
        거래처에 사업자번호가 등록되어 있지 않습니다. 개인 거래처는 전자세금계산서 발행 대상이
        아닙니다.
      </p>
      <%= link_to "거래처 정보 수정", edit_app_client_path(@invoice.client),
            class: "mt-3 inline-flex min-h-11 items-center rounded-xl border border-stone-300 bg-white px-4 py-2 text-sm font-bold text-stone-700 transition hover:bg-stone-50" %>
    </div>
  <% end %>
<% end %>
