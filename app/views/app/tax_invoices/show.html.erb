<%# TAX-1/2 — 발행 주문 상세. 결제 대기는 포트원 위젯 체크아웃(legal_documents/show 선례 —
    portone_payment Stimulus 재사용), 결제 완료 후는 발행 상태(TAX-2 — 국세청 승인번호)와
    취소 버튼을 노출한다. %>

<% content_for :head do %>
  <%= tag.script(src: "https://cdn.portone.io/v2/browser-sdk.js") %>
<% end %>

<div class="mx-auto max-w-2xl py-12">
  <p class="text-sm">
    <% if @invoice %>
      <%= link_to "← 청구서로 돌아가기", app_invoice_path(@invoice), class: "font-semibold text-stone-500 transition hover:text-stone-800" %>
    <% else %>
      <%= link_to "← 청구서 목록", app_invoices_path, class: "font-semibold text-stone-500 transition hover:text-stone-800" %>
    <% end %>
  </p>

  <header class="mt-4">
    <h1 class="text-2xl font-bold tracking-tight text-emerald-900 sm:text-3xl">전자세금계산서 발행</h1>
    <p class="mt-2 text-sm leading-relaxed text-stone-500">
      주문번호 <span class="tabular-nums"><%= @order.pg_order_id %></span> ·
      <span class="tabular-nums"><%= won(@order.amount) %></span>
    </p>
  </header>

  <% if @order.paid? %>
    <% if @tax_invoice.nil? %>
      <%# 결제 완료·발행 기록 미생성 — FulfillTaxInvoiceService 처리 중 또는 발행 실패(로그 추적).
          새로고침으로 상태를 재확인하게 안내한다. %>
      <section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-bold text-stone-800">결제가 완료되었습니다. 발행 처리 상태를 확인하는 중입니다.</p>
        <p class="mt-2 text-xs leading-relaxed text-stone-500">
          잠시 후 새로고침해도 상태가 표시되지 않으면 고객지원(문의)으로 연락해 주세요.
        </p>
      </section>
    <% else %>
      <section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm font-bold text-stone-800">발행 상태</p>
          <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-bold <%= @tax_invoice.issued? ? "bg-emerald-50 text-emerald-700" : "bg-orange-50 text-orange-600" %>">
            <%= @tax_invoice.status_label %>
          </span>
        </div>
        <dl class="mt-3 grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-[9rem_1fr]">
          <dt class="text-stone-500">청구서</dt>
          <dd class="font-medium text-stone-800"><%= @invoice&.issue_number %></dd>
          <dt class="text-stone-500">작성일자</dt>
          <dd class="tabular-nums font-medium text-stone-800"><%= @tax_invoice.write_date ? l(@tax_invoice.write_date, format: :long) : "-" %></dd>
          <dt class="text-stone-500">국세청 승인번호</dt>
          <dd class="tabular-nums font-medium text-stone-800"><%= @tax_invoice.nts_send_key.presence || "승인 대기 중" %></dd>
        </dl>
        <% if @tax_invoice.pending? %>
          <%= button_to "발급 취소", cancel_app_tax_invoice_path(@order), method: :patch,
                form: { data: { turbo_confirm: "발급을 취소할까요? 취소에도 바로빌 과금 정책상 비용이 발생할 수 있습니다." } },
                class: "mt-5 inline-flex min-h-11 items-center justify-center rounded-xl border border-orange-300 bg-white px-4 py-2 text-sm font-bold text-orange-800 transition hover:bg-orange-50" %>
          <p class="mt-2 text-xs leading-relaxed text-stone-500">
            발급 취소는 국세청 전송 전에만 가능합니다. 취소 후에도 재발행은 새 결제가 필요합니다.
          </p>
        <% elsif @tax_invoice.canceled? %>
          <p class="mt-4 text-xs leading-relaxed text-stone-500">
            취소된 발행입니다. 재발행이 필요한 경우 고객지원(문의)으로 연락해 주세요.
          </p>
        <% end %>
      </section>
    <% end %>
  <% elsif @order.pending? %>
    <%# 결제 대기 — 포트원 위젯 체크아웃(_checkout 선례 — 주문 원값만 전달, PLAN-5) %>
    <section class="mt-6 rounded-2xl border-2 border-emerald-800 bg-emerald-900/5 p-5 shadow-sm"
         data-controller="portone-payment"
         data-portone-payment-store-id-value="<%= @portone_store_id %>"
         data-portone-payment-channel-key-value="<%= @portone_channel_key_normal %>"
         data-portone-payment-payment-id-value="<%= @order.pg_order_id %>"
         data-portone-payment-amount-value="<%= @order.amount %>"
         data-portone-payment-order-name-value="전자세금계산서 발행"
         data-portone-payment-callback-url-value="<%= callback_app_orders_url %>"
         data-portone-payment-customer-name-value="<%= @portone_customer_name %>"
         data-portone-payment-customer-phone-value="<%= @portone_customer_phone %>"
         data-portone-payment-customer-email-value="<%= @portone_customer_email %>">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm font-bold text-stone-800">결제 대기</p>
        <p class="text-xl font-extrabold tabular-nums text-stone-900"><%= won(@order.amount) %></p>
      </div>
      <% if @invoice %>
        <p class="mt-2 text-xs text-stone-500">대상 청구: <%= @invoice.issue_number %></p>
      <% end %>
      <% if @portone_customer_phone.present? %>
        <button type="button" data-action="portone-payment#pay"
              class="mt-4 inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-emerald-800 px-6 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900">
          결제하기
        </button>
      <% else %>
        <p class="mt-4 rounded-xl bg-amber-50 p-3 text-sm leading-relaxed text-stone-700" role="status">
          결제에는 연락처가 필요합니다.
          <%= link_to "프로필에서 연락처를 등록", edit_app_profile_path, class: "font-bold text-emerald-800 underline underline-offset-2 hover:text-emerald-900" %>해 주세요.
        </p>
      <% end %>
      <p class="mt-3 text-xs leading-relaxed text-stone-500">
        결제 승인은 KG이니시스(포트원 경유)가 처리하며, 승인 결과는 서버에서 재확인한 뒤 발행이 요청됩니다.
      </p>
    </section>
  <% else %>
    <%# 실패·취소 — 재주문 안내 %>
    <section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" aria-label="결제 실패">
      <p class="text-sm font-bold text-stone-800">결제가 완료되지 않았습니다.</p>
      <p class="mt-2 text-xs leading-relaxed text-stone-500">
        결제가 취소되었거나 실패했습니다. 청구서 상세에서 다시 발행을 요청해 주세요.
      </p>
      <% if @invoice %>
        <%= link_to "다시 발행 요청", new_app_tax_invoice_path(invoice_id: @invoice.id),
              class: "mt-4 inline-flex min-h-11 items-center justify-center rounded-xl border border-stone-300 bg-white px-5 py-2 text-sm font-bold text-stone-700 transition hover:bg-stone-50" %>
      <% end %>
    </section>
  <% end %>
</div>
