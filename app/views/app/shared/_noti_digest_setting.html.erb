<%# NOTI-2 주간 다이제스트 수신 토글(T7 신규 파셜 — 기존 프로필 설정 스타일 준수).
    프로필 본문 폼과 분리된 독립 폼이다 — 토글 제출이
    App::NotificationSettingsController#update(app_notification_settings_path)로 간다.
    삽입 위치(3-S 결선): app/views/app/profiles/edit.html.erb의 프로필 form_with 닫힘
    (`<% end %>` — app_profile_path 폼) 직후, 최상위 컨테이너 div 닫힘 이전에
    `render "app/shared/noti_digest_setting", user: @user` 한 줄.
    연락처(phone) 필드가 다이제스트 수신 번호라 프로필 폼 바로 아래가 문맥상 자연스럽다. %>
<div class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
  <%= form_with model: user, url: app_notification_settings_path, method: :patch,
        class: "flex items-start justify-between gap-4" do |form| %>
    <div>
      <p class="text-sm font-bold text-stone-800">주간 수금 요약 받기</p>
      <p class="mt-1 text-xs leading-relaxed text-stone-500">
        매주 월요일 아침 지난 7일간의 만기·약속·수금 완료 현황을 등록된 연락처로 요약해 보내 드립니다.
      </p>
    </div>
    <div class="flex shrink-0 flex-col items-center gap-1.5">
      <%= form.label :noti2_digest_enabled, class: "relative inline-flex cursor-pointer items-center" do %>
        <%= form.check_box :noti2_digest_enabled, class: "peer sr-only" %>
        <span class="h-6 w-11 rounded-full bg-stone-300 transition peer-checked:bg-emerald-700
                     after:absolute after:top-0.5 after:left-0.5 after:h-5 after:w-5 after:rounded-full
                     after:bg-white after:shadow-sm after:transition peer-checked:after:translate-x-5"></span>
        <span class="sr-only">주간 수금 요약 수신 여부</span>
      <% end %>
      <%= form.submit "저장",
            class: "cursor-pointer text-xs font-semibold text-emerald-700 hover:text-emerald-900 hover:underline focus-visible:outline-2 focus-visible:outline-emerald-700" %>
    </div>
  <% end %>
</div>
