<% content_for :title, "#{@client.name} — 받을돈" %>

<%# 거래처 상세(CLIENT-1) — 등록 정보 전체 확인 + 편집·코드 + 거래처 카드·지급 성적표(CLIENT-3/4)·약속 이행 이력(PROMISE-5). %>
<div class="mx-auto w-full max-w-xl py-8">
  <p class="text-sm">
    <%= link_to "← 거래처 목록", app_clients_path, class: "font-semibold text-stone-500 transition hover:text-stone-800" %>
  </p>

  <header class="mt-4">
    <h1 class="text-2xl font-bold tracking-tight text-emerald-900"><%= @client.name %></h1>
    <p class="mt-2 text-sm leading-relaxed text-stone-500"><%= @client.contact_name %> 담당</p>
  </header>

  <section aria-labelledby="client-detail" class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 id="client-detail" class="text-base font-bold text-stone-800">거래처 정보</h2>
    <dl class="mt-5 divide-y divide-stone-100">
      <div class="flex items-start justify-between gap-4 py-3">
        <dt class="shrink-0 text-sm text-stone-400">담당자명</dt>
        <dd class="text-right text-sm font-medium text-stone-700"><%= @client.contact_name %></dd>
      </div>
      <div class="flex items-start justify-between gap-4 py-3">
        <dt class="shrink-0 text-sm text-stone-400">알림 수신 번호</dt>
        <dd class="text-right text-sm font-medium text-stone-700"><%= @client.phone %></dd>
      </div>
      <div class="flex items-start justify-between gap-4 py-3">
        <dt class="shrink-0 text-sm text-stone-400">이메일</dt>
        <dd class="text-right text-sm font-medium text-stone-700"><%= @client.email.presence || "—" %></dd>
      </div>
      <div class="flex items-start justify-between gap-4 py-3">
        <dt class="shrink-0 text-sm text-stone-400">사업자번호</dt>
        <dd class="text-right text-sm font-medium tabular-nums text-stone-700"><%= @client.business_number.presence || "—" %></dd>
      </div>
      <div class="flex items-start justify-between gap-4 py-3">
        <dt class="shrink-0 text-sm text-stone-400">메모</dt>
        <dd class="whitespace-pre-line text-right text-sm font-medium text-stone-700"><%= @client.memo.presence || "—" %></dd>
      </div>
    </dl>
  </section>

  <%# ── 거래처 카드(CLIENT-3) — 누적 청구액·진행 중 건수. 약속 이행 이력은 PROMISE-5 파생 판정 목록 ── %>
  <section aria-labelledby="client-scorecard" class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="client-scorecard" class="text-base font-bold text-stone-800">지급 성적표</h2>
      <% comparison = client_comparison_badge(@scorecard) %>
      <% if comparison %>
        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-bold <%= comparison.last %>"><%= comparison.first %></span>
      <% end %>
    </div>
    <%# CLIENT-4 — "지연"은 약속일 대비. 만기일 대비 지연 리포트(DASH-5)와 별개 지표다. %>
    <p class="mt-1 text-xs text-stone-400">약속일 대비 기준입니다 — 만기일 대비 정산 지연은 리포트 페이지의 거래처별 지연 리포트에서 확인할 수 있습니다.</p>

    <dl class="mt-5 divide-y divide-stone-100">
      <div class="flex items-baseline justify-between gap-4 py-3">
        <dt class="text-sm text-stone-400">누적 청구액</dt>
        <dd class="text-base font-bold tabular-nums text-stone-900"><%= won(@scorecard.total_invoiced_amount) %></dd>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-3">
        <dt class="text-sm text-stone-400">진행 중 건수</dt>
        <dd class="text-base font-bold tabular-nums text-stone-900"><%= @scorecard.unsettled_count %>건</dd>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-3">
        <dt class="text-sm text-stone-400">평균 지급 지연일 <span class="text-xs">(약속일 대비)</span></dt>
        <dd class="text-base font-bold tabular-nums <%= @scorecard.avg_delay_days && @scorecard.avg_delay_days.positive? ? "text-orange-600" : "text-stone-900" %>"><%= scorecard_delay_text(@scorecard.avg_delay_days) %></dd>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-3">
        <dt class="text-sm text-stone-400">약속 이행률</dt>
        <dd class="text-base font-bold tabular-nums <%= @scorecard.compliance_rate && @scorecard.compliance_rate >= 80 ? "text-green-700" : "text-stone-900" %>"><%= scorecard_rate_text(@scorecard.compliance_rate) %></dd>
      </div>
    </dl>
    <% if @scorecard.avg_delay_days.nil? %>
      <p class="mt-2 text-xs leading-relaxed text-stone-400">아직 약속이 있었던 마감 건이 없어 지급 지표가 집계되지 않았습니다.</p>
    <% end %>

    <%# CLIENT-4 — 최근 6개월 월별 평균 지급 지연일 추이(CSS 막대 — 외부 라이브러리 없음) %>
    <div class="mt-4 rounded-xl bg-stone-50 p-4 ring-1 ring-inset ring-stone-200">
      <p class="text-xs font-semibold text-stone-500">최근 6개월 지급 경향 <span class="font-normal text-stone-400">(마감 입금월 기준·약속일 대비)</span></p>
      <div class="mt-3 flex items-end justify-between gap-2" role="img" aria-label="최근 6개월 월별 평균 지급 지연일 추이">
        <% scorecard_trend_bars(@scorecard.monthly_trend).each do |month, label, height| %>
          <div class="flex min-w-0 flex-1 flex-col items-center gap-1">
            <span class="text-[11px] font-semibold tabular-nums text-stone-600"><%= label %></span>
            <div class="flex h-20 w-full items-end justify-center rounded-md bg-stone-100" aria-hidden="true">
              <div class="w-1/2 rounded-md bg-orange-300 transition-all" style="height: <%= height %>%"></div>
            </div>
            <span class="text-[10px] tabular-nums text-stone-400"><%= month[2..] %></span>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── 약속 이행 이력(PROMISE-5·CLIENT-3) — Q14 파생 판정 3상태 목록, 최신 약속순 ── %>
  <section aria-labelledby="promise-history" class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 id="promise-history" class="text-base font-bold text-stone-800">약속 이행 이력</h2>
    <% if @compliance.empty? %>
      <p class="mt-3 rounded-xl bg-stone-50 p-4 text-sm leading-relaxed text-stone-500 ring-1 ring-inset ring-stone-200" role="status">
        아직 기록된 약속이 없습니다. 거래처가 입금 예정일을 응답하면 이행 여부가 자동으로 기록됩니다.
      </p>
    <% else %>
      <ul class="mt-3 divide-y divide-stone-100">
        <% @compliance.each do |row| %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-3">
            <div class="min-w-0">
              <p class="text-sm font-medium tabular-nums text-stone-700"><%= row.issue_number.presence || "청구서" %></p>
              <p class="mt-0.5 text-xs text-stone-400">
                <%= won(row.total_amount) %> · 약속일 <%= display_date(row.promised_on) %><%= " · 입금일 #{display_date(row.closing_paid_on)}" if row.closing_paid_on %>
              </p>
            </div>
            <%= promise_status_badge(row.status_key) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <%# REM-7·VIEW-7 — 거래처 단위 자동 안내 상태와 보류/재개 액션. 수신거부는 채무자 의사라
      재개 경로가 없다(제품 원칙 P1 — U1이 되돌리지 않는다). %>
  <section class="mt-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-base font-bold text-stone-800">자동 안내 상태</h2>
      <%= client_reminder_badge(@client) %>
    </div>
    <% if @client.refused? %>
      <p class="mt-3 rounded-xl bg-stone-50 p-4 text-sm leading-relaxed text-stone-600 ring-1 ring-inset ring-stone-200" role="status">
        이 거래처가 추가 안내 수신을 거부했습니다. 이 번호로는 자동 안내를 보내지 않습니다.
      </p>
    <% elsif @client.reminders_suspended? %>
      <p class="mt-3 text-xs leading-relaxed text-stone-500">
        이 거래처의 모든 청구서 자동 안내가 보류 중입니다. 재개하면 다음 단계부터 이어집니다.
      </p>
      <%= button_to "안내 재개하기", resume_reminders_app_client_path(@client), method: :patch,
            class: "mt-4 inline-flex min-h-11 cursor-pointer items-center rounded-xl border border-emerald-700/40 bg-emerald-50 px-5 text-sm font-bold text-emerald-800 transition hover:bg-emerald-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    <% else %>
      <p class="mt-3 text-xs leading-relaxed text-stone-500">
        이 거래처의 미수 청구서에 단계별 안내가 자동 발송됩니다. 일정 조정이 필요하면 보류할 수 있습니다.
      </p>
      <%= button_to "안내 보류하기", suspend_reminders_app_client_path(@client), method: :patch,
            data: { turbo_confirm: "이 거래처의 모든 청구서 자동 안내를 멈춥니다. 보류하시겠습니까?" },
            class: "mt-4 inline-flex min-h-11 cursor-pointer items-center rounded-xl border border-stone-300 bg-white px-5 text-sm font-semibold text-stone-600 transition hover:border-stone-400 hover:text-stone-800" %>
    <% end %>
  </section>

  <div class="mt-6 flex items-center justify-between gap-3">
    <%= link_to "정보 수정", edit_app_client_path(@client),
          class: "inline-flex min-h-11 items-center rounded-xl bg-emerald-800 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    <%= button_to "삭제", app_client_path(@client), method: :delete,
          data: { turbo_confirm: "이 거래처를 삭제하시겠습니까?" },
          class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl border border-stone-300 bg-white px-5 text-sm font-semibold text-stone-500 transition hover:border-red-300 hover:text-red-600" %>
  </div>
</div>
