<%# 프로필 설정(AUTH-1.3) — 표시명·사업자 유형 필수, 계좌 3종·연락처 선택(모두 이후 수정 가능).
    섹션 구분(내 정보/입금 계좌) + 필드 라벨·힌트·오류 상태 완성도(토스 송금류 국내 표준 UX). %>
<div class="mx-auto w-full max-w-xl py-12">
  <header>
    <h1 class="text-2xl font-bold tracking-tight text-emerald-900 sm:text-3xl">프로필 설정</h1>
    <p class="mt-2 text-sm leading-relaxed text-stone-500">
      발행된 청구서와 입금 안내에 사용할 정보입니다. 모든 항목은 이후에도 수정할 수 있습니다.
    </p>
  </header>

  <% if @user.errors.any? %>
    <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-600" role="alert">
      <ul class="list-disc space-y-1 pl-5">
        <% @user.errors.messages.each_value do |messages| %>
          <% messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: app_profile_path, class: "mt-8 space-y-6" do |form| %>
    <%# ── 내 정보 ── %>
    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">내 정보</h2>

      <div class="mt-5">
        <%= form.label :display_name, "표시명 또는 상호", class: "block text-sm font-medium text-stone-700" %>
        <%= form.text_field :display_name, required: true, autofocus: true, maxlength: 30,
              placeholder: "예) 김디자인 스튜디오",
              class: profile_input_classes(@user, :display_name) %>
        <p class="mt-1.5 text-xs text-stone-500">청구서 상단에 발행인 대신 표기되는 이름입니다.</p>
        <% if profile_error_message(@user, :display_name) %>
          <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :display_name) %></p>
        <% end %>
      </div>

      <fieldset class="mt-6">
        <legend class="text-sm font-medium text-stone-700">사업자 유형</legend>
        <p class="mt-1 text-xs text-stone-500">청구서의 세금 표기 방식이 달라집니다.</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="relative">
            <%= form.radio_button :business_type, "freelancer", class: "peer sr-only" %>
            <%= form.label :business_type, value: "freelancer",
                  class: "block h-full cursor-pointer rounded-xl border border-stone-300 bg-white p-4 transition hover:border-stone-400 peer-checked:border-emerald-700 peer-checked:ring-2 peer-checked:ring-emerald-700/30 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-700/50" do %>
              <span class="flex items-baseline justify-between gap-2">
                <span class="text-sm font-bold text-stone-800">프리랜서</span>
                <span class="shrink-0 text-xs font-semibold text-emerald-700">원천징수 3.3% 표기 적용</span>
              </span>
              <span class="mt-1.5 block text-xs leading-relaxed text-stone-500">3.3% 원천징수 대상 소득으로 청구합니다.</span>
            <% end %>
          </div>
          <div class="relative">
            <%= form.radio_button :business_type, "business", class: "peer sr-only" %>
            <%= form.label :business_type, value: "business",
                  class: "block h-full cursor-pointer rounded-xl border border-stone-300 bg-white p-4 transition hover:border-stone-400 peer-checked:border-emerald-700 peer-checked:ring-2 peer-checked:ring-emerald-700/30 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-700/50" do %>
              <span class="flex items-baseline justify-between gap-2">
                <span class="text-sm font-bold text-stone-800">사업자</span>
                <span class="shrink-0 text-xs font-semibold text-emerald-700">부가세 별도 표기</span>
              </span>
              <span class="mt-1.5 block text-xs leading-relaxed text-stone-500">공급가액에 부가가치세를 더해 청구합니다.</span>
            <% end %>
          </div>
        </div>
        <% if profile_error_message(@user, :business_type) %>
          <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :business_type) %></p>
        <% end %>
      </fieldset>

      <div class="mt-6">
        <%= form.label :phone, "연락처", class: "block text-sm font-medium text-stone-700" %>
        <%= form.telephone_field :phone, inputmode: "tel", autocomplete: "tel", maxlength: 14,
              placeholder: "예) 010-1234-5678",
              class: profile_input_classes(@user, :phone) %>
        <p class="mt-1.5 text-xs text-stone-500">선택 입력 — 서비스 안내에 사용됩니다.</p>
        <% if profile_error_message(@user, :phone) %>
          <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :phone) %></p>
        <% end %>
      </div>
    </section>

    <%# ── 입금 계좌 ── %>
    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">입금 계좌</h2>
      <p class="mt-1 text-xs text-stone-500">청구서 뷰어에 계좌 복사 버튼과 함께 표시됩니다. 선택 입력입니다.</p>

      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :bank_name, "은행", class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :bank_name, bank_options, { prompt: "은행 선택" },
                class: profile_input_classes(@user, :bank_name) %>
        </div>
        <div>
          <%= form.label :account_holder, "예금주", class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field :account_holder, maxlength: 30, placeholder: "예) 김디자인",
                class: profile_input_classes(@user, :account_holder) %>
        </div>
      </div>

      <div class="mt-5">
        <%= form.label :account_number, "계좌번호", class: "block text-sm font-medium text-stone-700" %>
        <%= form.text_field :account_number, inputmode: "numeric", autocomplete: "off", maxlength: 24,
              placeholder: "예) 1234-5678-9012",
              data: { controller: "account-number" },
              class: profile_input_classes(@user, :account_number) %>
        <p class="mt-1.5 text-xs text-stone-500">숫자만 입력해도 하이픈이 자동으로 붙습니다.</p>
        <% if profile_error_message(@user, :account_number) %>
          <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :account_number) %></p>
        <% end %>
      </div>
    </section>

    <div class="border-t border-stone-200 pt-6">
      <%= form.submit "프로필 저장",
            class: "w-full cursor-pointer rounded-xl bg-emerald-800 px-6 py-3 text-base font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      <p class="mt-3 text-center text-xs text-stone-500">저장 후에도 언제든 수정할 수 있습니다.</p>
    </div>
  <% end %>
</div>
