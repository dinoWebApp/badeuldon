<%# 프로필 설정(AUTH-1.3) — 표시명·사업자 유형 필수, 계좌 3종·연락처 선택(모두 이후 수정 가능).
    섹션 구분(내 정보/입금 계좌) + 필드 라벨·힌트·오류 상태 완성도(토스 송금류 국내 표준 UX). %>
<div class="mx-auto w-full max-w-xl py-12">
  <header>
    <h1 class="text-2xl font-bold tracking-tight text-emerald-900 sm:text-3xl">프로필 설정</h1>
    <p class="mt-2 text-sm leading-relaxed text-stone-500">
      발행된 청구서와 입금 안내에 사용할 정보입니다. 모든 항목은 이후에도 수정할 수 있습니다.
    </p>
  </header>

  <% if @user.errors.any? %>
    <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-600" role="alert">
      <ul class="list-disc space-y-1 pl-5">
        <% @user.errors.messages.each_value do |messages| %>
          <% messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: app_profile_path, class: "mt-8 space-y-6" do |form| %>
    <%# ── 내 정보 ── %>
    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">내 정보</h2>

      <div class="mt-5">
        <%= form.label :display_name, "표시명 또는 상호", class: "block text-sm font-medium text-stone-700" %>
        <%= form.text_field :display_name, required: true, autofocus: true, maxlength: 30,
              placeholder: "예) 김디자인 스튜디오",
              class: profile_input_classes(@user, :display_name) %>
        <p class="mt-1.5 text-xs text-stone-500">청구서 상단에 발행인 대신 표기되는 이름입니다.</p>
        <% if profile_error_message(@user, :display_name) %>
          <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :display_name) %></p>
        <% end %>
      </div>

      <fieldset class="mt-6">
        <legend class="text-sm font-medium text-stone-700">사업자 유형</legend>
        <p class="mt-1 text-xs text-stone-500">청구서의 세금 표기 방식이 달라집니다.</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="relative">
            <%= form.radio_button :business_type, "freelancer", class: "peer sr-only" %>
            <%= form.label :business_type, value: "freelancer",
                  class: "block h-full cursor-pointer rounded-xl border border-stone-300 bg-white p-4 transition hover:border-stone-400 peer-checked:border-emerald-700 peer-checked:ring-2 peer-checked:ring-emerald-700/30 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-700/50" do %>
              <span class="flex items-baseline justify-between gap-2">
                <span class="text-sm font-bold text-stone-800">프리랜서</span>
                <span class="shrink-0 text-xs font-semibold text-emerald-700">원천징수 3.3% 표기 적용</span>
              </span>
              <span class="mt-1.5 block text-xs leading-relaxed text-stone-500">3.3% 원천징수 대상 소득으로 청구합니다.</span>
            <% end %>
          </div>
          <div class="relative">
            <%= form.radio_button :business_type, "business", class: "peer sr-only" %>
            <%= form.label :business_type, value: "business",
                  class: "block h-full cursor-pointer rounded-xl border border-stone-300 bg-white p-4 transition hover:border-stone-400 peer-checked:border-emerald-700 peer-checked:ring-2 peer-checked:ring-emerald-700/30 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-700/50" do %>
              <span class="flex items-baseline justify-between gap-2">
                <span class="text-sm font-bold text-stone-800">사업자</span>
                <span class="shrink-0 text-xs font-semibold text-emerald-700">부가세 별도 표기</span>
              </span>
              <span class="mt-1.5 block text-xs leading-relaxed text-stone-500">공급가액에 부가가치세를 더해 청구합니다.</span>
            <% end %>
          </div>
        </div>
        <% if profile_error_message(@user, :business_type) %>
          <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :business_type) %></p>
        <% end %>
      </fieldset>

      <div class="mt-6">
        <%= form.label :phone, "연락처", class: "block text-sm font-medium text-stone-700" %>
        <%= form.telephone_field :phone, inputmode: "tel", autocomplete: "tel", maxlength: 14,
              placeholder: "예) 010-1234-5678",
              class: profile_input_classes(@user, :phone) %>
        <p class="mt-1.5 text-xs text-stone-500">선택 입력 — 서비스 안내에 사용됩니다.</p>
        <% if profile_error_message(@user, :phone) %>
          <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :phone) %></p>
        <% end %>
      </div>
    </section>

    <%# ── 입금 계좌 ── %>
    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">입금 계좌</h2>
      <p class="mt-1 text-xs text-stone-500">청구서 뷰어에 계좌 복사 버튼과 함께 표시됩니다. 선택 입력입니다.</p>

      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :bank_name, "은행", class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :bank_name, bank_options, { prompt: "은행 선택" },
                class: profile_input_classes(@user, :bank_name) %>
        </div>
        <div>
          <%= form.label :account_holder, "예금주", class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field :account_holder, maxlength: 30, placeholder: "예) 김디자인",
                class: profile_input_classes(@user, :account_holder) %>
        </div>
      </div>

      <div class="mt-5">
        <%= form.label :account_number, "계좌번호", class: "block text-sm font-medium text-stone-700" %>
        <%= form.text_field :account_number, inputmode: "numeric", autocomplete: "off", maxlength: 24,
              placeholder: "예) 1234-5678-9012",
              data: { controller: "account-number" },
              class: profile_input_classes(@user, :account_number) %>
        <p class="mt-1.5 text-xs text-stone-500">숫자만 입력해도 하이픈이 자동으로 붙습니다.</p>
        <% if profile_error_message(@user, :account_number) %>
          <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :account_number) %></p>
        <% end %>
      </div>
    </section>

    <%# ── 알림 발송 시간(REM-3 — 고정 경계 내 축소 설정) ── %>
    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">알림 발송 시간</h2>
      <p class="mt-1 text-xs text-stone-500">
        만기 독촉 알림톡을 보낼 요일과 시간대를 선택합니다. 기본은 평일 09시~18시이며,
        이 범위 안에서만 좁힐 수 있습니다.
      </p>

      <fieldset class="mt-5">
        <legend class="block text-sm font-medium text-stone-700">발송 요일</legend>
        <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-2">
          <%= hidden_field_tag "user[remind_allowed_wdays][]", "" %>
          <% remind_wday_options.each do |label, wday| %>
            <label class="flex cursor-pointer items-center gap-2 text-sm text-stone-700">
              <%= check_box_tag "user[remind_allowed_wdays][]", wday,
                    @user.remind_allowed_wday_list.include?(wday), id: "user_remind_wday_#{wday}",
                    class: remind_wday_checkbox_classes %>
              <%= label %>
            </label>
          <% end %>
        </div>
        <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :remind_allowed_wdays) %></p>
      </fieldset>

      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :remind_start_hour, "시작 시각", class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :remind_start_hour, remind_start_hour_options,
                class: profile_input_classes(@user, :remind_start_hour) %>
          <% if profile_error_message(@user, :remind_start_hour) %>
            <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :remind_start_hour) %></p>
          <% end %>
        </div>
        <div>
          <%= form.label :remind_end_hour, "종료 시각", class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :remind_end_hour, remind_end_hour_options,
                class: profile_input_classes(@user, :remind_end_hour) %>
          <% if profile_error_message(@user, :remind_end_hour) %>
            <p class="mt-1.5 text-xs font-medium text-red-600"><%= profile_error_message(@user, :remind_end_hour) %></p>
          <% end %>
        </div>
      </div>
      <p class="mt-4 rounded-lg bg-stone-50 px-3 py-2.5 text-xs leading-relaxed text-stone-500">
        야간·주말 발송은 정책상 불가합니다 — 허용 범위 내에서만 조정할 수 있습니다.
      </p>
    </section>

    <div class="border-t border-stone-200 pt-6">
      <%= form.submit "프로필 저장",
            class: "w-full cursor-pointer rounded-xl bg-emerald-800 px-6 py-3 text-base font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      <p class="mt-3 text-center text-xs text-stone-500">저장 후에도 언제든 수정할 수 있습니다.</p>
    </div>
  <% end %>

  <%= render "app/shared/noti_digest_setting", user: @user %>

  <%# ── 회원 탈퇴(AUTH-1.5) — 위험 구역. 프로필 폼과 별개의 독립 DELETE 폼이다(폼 중첩 금지).
      불일치 등 실패 시 이 영역(#withdrawal 앵커)으로 되돌아온다(W-3). %>
  <section id="withdrawal" class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-base font-bold text-red-700">회원 탈퇴</h2>
    <p class="mt-1 text-sm leading-relaxed text-stone-700">
      탈퇴하면 계정과 데이터가 즉시 삭제되어 <strong class="font-bold">되돌릴 수 없습니다.</strong>
    </p>

    <div class="mt-4 rounded-lg bg-stone-50 px-3 py-2.5">
      <p class="text-xs font-semibold text-stone-600">삭제되는 항목</p>
      <ul class="mt-2 list-disc space-y-1 pl-4 text-xs leading-relaxed text-stone-600">
        <li>청구서와 청구 링크(발행 중인 링크는 모두 폐기)</li>
        <li>청구서 부속 기록(입금 내역·약속·문의 응답·열람 기록)</li>
        <li>거래처·품목</li>
        <li>발송 이력·문의 내역</li>
        <li>반복 청구 일정</li>
        <li>결제·환불 내역(구독료·수금 패스·내용증명·세금계산서 결제)</li>
        <li>세금계산서 발행 내역</li>
        <li>계정 정보(이메일·휴대폰·프로필)</li>
      </ul>
      <p class="mt-2 text-xs font-medium text-stone-600">필요한 내역은 탈퇴 전에 미리 저장해 주세요.</p>
      <p class="mt-2 text-xs font-medium text-stone-600">결제 기록은 관계 법령에 따라 회원과 연결되지 않는 형태로 5년간 보관됩니다 (개인정보처리방침 §3).</p>
    </div>

    <% if @withdrawal_summary.unsettled_count.positive? %>
      <p class="mt-3 text-sm leading-relaxed text-stone-700">
        미수 청구 <strong class="font-bold"><%= number_with_delimiter(@withdrawal_summary.unsettled_count) %>건(잔액 <%= number_with_delimiter(@withdrawal_summary.unsettled_balance) %>원)</strong>의 청구 링크가 열리지 않아, 채무자에게 받을돈 명의의 안내를 보내거나 입금 예정일 약속을 받을 수 없습니다. <strong class="font-bold">받을 권리는 그대로 남습니다.</strong>
      </p>
    <% end %>
    <% if @withdrawal_summary.paid_plus_end_on %>
      <% if @withdrawal_summary.paid_plus_cancelled %>
        <p class="mt-3 text-sm leading-relaxed text-stone-700">
          이용 중인 Plus(<strong class="font-bold"><%= @withdrawal_summary.paid_plus_end_on.month %>월 <%= @withdrawal_summary.paid_plus_end_on.day %>일 종료 예정</strong>)는 즉시 종료됩니다. 남은 기간은 <strong class="font-bold">환불되지 않습니다</strong>.
        </p>
      <% else %>
        <p class="mt-3 text-sm leading-relaxed text-stone-700">
          이용 중인 Plus(<strong class="font-bold"><%= @withdrawal_summary.paid_plus_end_on.month %>월 <%= @withdrawal_summary.paid_plus_end_on.day %>일 종료 예정</strong>)는 즉시 종료됩니다. 남은 기간은 <strong class="font-bold">환불되지 않고</strong>, 이후 결제는 청구되지 않습니다.
        </p>
      <% end %>
    <% elsif @withdrawal_summary.trialing_plus %>
      <p class="mt-3 text-sm leading-relaxed text-stone-700">체험 중인 Plus는 즉시 종료됩니다.</p>
    <% end %>
    <% if @withdrawal_summary.remaining_pass_count.positive? %>
      <p class="mt-3 text-sm leading-relaxed text-stone-700">
        남은 수금 패스 <strong class="font-bold"><%= number_with_delimiter(@withdrawal_summary.remaining_pass_count) %>건</strong>은 소멸되며 <strong class="font-bold">환불되지 않습니다</strong>.
      </p>
    <% end %>
    <%# N-1 — 실패 안내(불일치·처리 오류)를 탈퇴 영역 안에서도 보인다. 앵커 복귀 시 레이아웃
        상단의 alert(#alert)은 화면 밖이라 한 줄 이중 표시가 필요하다. %>
    <% if flash[:withdrawal_error] %>
      <p class="mt-3 text-xs font-medium text-red-600" role="alert"><%= flash[:withdrawal_error] %></p>
    <% end %>

    <%= form_with url: app_profile_path, method: :delete, class: "mt-5" do |form| %>
      <%= form.label :confirm_email, "확인용 이메일", class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_field :confirm_email, required: true, autocomplete: "email", inputmode: "email",
            pattern: ".*\\S.*", title: "공백 없이 가입한 이메일을 입력해 주세요",
            placeholder: "가입한 이메일을 입력해 주세요",
            class: "mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:outline-none focus:ring-2 focus:border-emerald-700 focus:ring-emerald-700/30" %>
      <%= form.submit "탈퇴합니다",
            class: "mt-4 w-full cursor-pointer rounded-xl border border-red-300 bg-white px-6 py-3 text-base font-bold text-red-700 shadow-sm transition hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" %>
      <p class="mt-3 text-center text-xs text-stone-500">
        탈퇴 후에는 같은 이메일로 다시 가입할 수 있지만, 이전 데이터는 복구되지 않습니다.
      </p>
    <% end %>
  </section>
</div>
