<% content_for :title, "문의 — 받을돈" %>

<%# ADMIN-8 — 내 문의 목록(상태 배지·분류·최신순). %>
<div class="py-8">
  <header class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-emerald-900">문의</h1>
      <p class="mt-2 text-sm leading-relaxed text-stone-500">1:1 문의 이력을 확인합니다. 답변은 알림톡으로도 알려드립니다.</p>
    </div>
    <%= link_to "새 문의", new_app_ticket_path,
          class: "inline-flex min-h-11 items-center rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
  </header>

  <div class="mt-6 divide-y divide-stone-100 rounded-2xl border border-stone-200 bg-white shadow-sm">
    <% @tickets.each do |ticket| %>
      <% status_label, status_class = ticket_status_badge(ticket) %>
      <%= link_to app_ticket_path(ticket),
            class: "flex items-center gap-3 px-5 py-4 transition hover:bg-stone-50" do %>
        <span class="shrink-0 rounded-full px-2 py-0.5 text-[11px] font-bold ring-1 ring-inset <%= status_class %>"><%= status_label %></span>
        <span class="min-w-0 flex-1 truncate text-sm font-semibold text-stone-800"><%= ticket.title %></span>
        <span class="shrink-0 text-xs text-stone-400"><%= ticket_category_label(ticket) %></span>
        <span class="shrink-0 text-xs tabular-nums text-stone-400"><%= display_datetime(ticket.created_at) %></span>
      <% end %>
    <% end %>
    <% if @tickets.empty? %>
      <p class="px-5 py-10 text-center text-sm text-stone-400">
        문의 이력이 없습니다. 궁금한 점이 있으면 새 문의를 남겨 주세요.
      </p>
    <% end %>
  </div>
</div>
