<% content_for :title, "새 문의 — 받을돈" %>

<%# ADMIN-8 티켓 작성 — 분류·제목·본문·이미지 첨부(선택). ADMIN-9 — FAQ 선노출: 랜딩 _faq
    파셜을 그대로 렌더한다(3-a 인계 사항 — 파셜은 자기완결·수정 불요, 랜딩 회귀 방지).
    문의 전 자주 묻는 질문으로 1차 해소를 유도해 CS 공수를 통제한다(비목표 10 — 실시간
    채팅 미제공). %>
<div class="py-8">
  <header>
    <h1 class="text-2xl font-bold tracking-tight text-emerald-900">새 문의</h1>
    <p class="mt-2 text-sm leading-relaxed text-stone-500">문의 전에 아래 자주 묻는 질문을 먼저 확인해 주세요.</p>
  </header>

  <%= render "landing/faq" %>

  <%# 작성 폼 — rate_limit 5회/시간(스팸 방지). 이미지는 선택(1장·5MB·jpg/png/webp). %>
  <div class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <%= form_with model: @ticket, url: app_tickets_path, local: true, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :category, "분류", class: "block text-sm font-semibold text-stone-700" %>
        <%= f.select :category,
              [ [ "결제", "billing" ], [ "이용 문의", "support" ], [ "버그 제보", "bug" ],
                [ "기능 제안", "feature" ], [ "기타", "etc" ] ],
              {}, class: "mt-1 block w-full max-w-xs rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
      </div>
      <div>
        <%= f.label :title, "제목", class: "block text-sm font-semibold text-stone-700" %>
        <%= f.text_field :title, maxlength: 100, required: true,
              class: form_input_classes(@ticket, :title),
              placeholder: "예) 결제 카드 등록이 되지 않아요" %>
      </div>
      <div>
        <%= f.label :body, "문의 내용", class: "block text-sm font-semibold text-stone-700" %>
        <%= f.text_area :body, rows: 6, maxlength: 2_000, required: true,
              class: form_input_classes(@ticket, :body),
              placeholder: "문의 내용을 자세히 적어 주세요. (최대 2,000자)" %>
      </div>
      <div>
        <%= f.label :image, "이미지 첨부(선택)", class: "block text-sm font-semibold text-stone-700" %>
        <%= f.file_field :image, accept: "image/jpeg,image/png,image/webp",
              class: "mt-1 block w-full text-sm text-stone-600 file:mr-3 file:rounded-lg file:border-0 file:bg-emerald-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-emerald-700 hover:file:bg-emerald-100" %>
        <p class="mt-1 text-xs text-stone-400">JPG·PNG·WEBP · 5MB 이하 1장</p>
      </div>
      <div class="pt-2">
        <%= f.submit "문의 접수",
              class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl bg-emerald-700 px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
        <%= link_to "취소", app_tickets_path,
              class: "ml-2 inline-flex min-h-11 items-center rounded-xl border border-stone-300 px-4 text-sm font-semibold text-stone-600 transition hover:border-stone-400" %>
      </div>
    <% end %>
  </div>
</div>
