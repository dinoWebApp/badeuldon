<% content_for :title, "문의 상세 — 받을돈" %>

<%# ADMIN-8 티켓 상세 — 스레드(문의·답변·추가 질문) + 추가 질문 폼(closed가 아니면 노출).
    첨부 이미지는 AS 변환 없이 원본 표시. 종료된 티켓에는 재문의 불가 안내. %>
<div class="py-8">
  <header class="flex items-start justify-between gap-4">
    <div>
      <%= link_to "← 문의 목록", app_tickets_path, class: "text-sm font-semibold text-emerald-700 hover:text-emerald-800" %>
      <h1 class="mt-2 text-xl font-bold tracking-tight text-stone-900"><%= @ticket.title %></h1>
      <p class="mt-1 text-xs text-stone-400">
        <%= ticket_category_label(@ticket) %> · <%= display_datetime(@ticket.created_at) %>
      </p>
    </div>
    <% status_label, status_class = ticket_status_badge(@ticket) %>
    <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-bold ring-1 ring-inset <%= status_class %>"><%= status_label %></span>
  </header>

  <%# 스레드 — 발신자별 정렬(user 좌 / admin 우)로 대화 흐름을 표현한다. %>
  <div class="mt-6 space-y-4">
    <% @messages.each do |message| %>
      <% if message.user? %>
        <div class="flex justify-start">
          <div class="max-w-[85%] rounded-2xl rounded-bl-sm border border-stone-200 bg-white px-4 py-3 shadow-sm">
            <p class="text-[11px] font-bold text-stone-400"><%= display_datetime(message.created_at) %></p>
            <p class="mt-1 whitespace-pre-wrap text-sm leading-relaxed text-stone-800"><%= message.body %></p>
            <% if message.image.attached? %>
              <%# W-1 — AS 공개 리다이렉트 대신 인증 서빙 경로(소유 U1 세션만). %>
              <%= image_tag app_ticket_message_image_path(@ticket, message), class: "mt-3 max-h-64 rounded-xl border border-stone-200", alt: "첨부 이미지" %>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="flex justify-end">
          <div class="max-w-[85%] rounded-2xl rounded-br-sm bg-emerald-800/10 px-4 py-3 ring-1 ring-inset ring-emerald-700/20">
            <p class="text-[11px] font-bold text-emerald-700">받을돈 · <%= display_datetime(message.created_at) %></p>
            <p class="mt-1 whitespace-pre-wrap text-sm leading-relaxed text-emerald-950"><%= message.body %></p>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# 추가 질문 — 종료 전까지 가능(PRD ADMIN-8). answered에서 질문하면 open으로 복귀한다. %>
  <% if @ticket.closed? %>
    <div class="mt-6 rounded-2xl border border-stone-200 bg-stone-50 p-4 text-sm text-stone-500">
      이 문의는 종료되었습니다. 새로운 문의는 목록 화면에서 <strong class="text-stone-700">새 문의</strong>로 등록해 주세요.
    </div>
  <% else %>
    <div class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold text-stone-700">추가 질문</h2>
      <%= form_with url: follow_up_app_ticket_path(@ticket), method: :post, local: true, class: "mt-3 space-y-3" do |f| %>
        <%= f.text_area :body, rows: 3, maxlength: 2_000, required: true,
              placeholder: "궁금한 점을 이어서 남겨 주세요. (최대 2,000자)",
              class: "block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
        <%= f.submit "추가 질문 보내기",
              class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      <% end %>
    </div>
  <% end %>
</div>
