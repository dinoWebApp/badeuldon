<% content_for :title, "반복 청구 등록 — 받을돈" %>

<%# 반복 청구 등록(INV-7) — 거래처·매월 발행일(1~28 한정)·품목·세금 설정. 품목 행은
    매월 동일 발행의 스냅샷 소스로, 저장 후 매달 RecurringInvoices::IssueJob이 Invoice로 발행한다. %>
<div class="py-8">
  <header>
    <h1 class="text-2xl font-bold tracking-tight text-emerald-900">반복 청구 등록</h1>
    <p class="mt-2 text-sm leading-relaxed text-stone-500">
      내용을 저장해 두면 매월 선택한 날짜에 청구서가 자동 발행됩니다.
    </p>
  </header>

  <%= form_with model: [:app, @schedule], class: "mt-8 space-y-6" do |form| %>
    <% if @schedule.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-600" role="alert">
        <ul class="list-disc space-y-1 pl-5">
          <% @schedule.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">청구 기본 설정</h2>

      <div class="mt-5 grid gap-6 sm:grid-cols-2">
        <div>
          <%= form.label :client_id, "거래처", class: "block text-sm font-medium text-stone-700" %>
          <%= form.collection_select :client_id, @clients, :id, :name,
                { prompt: "거래처를 선택하세요", required: true },
                class: form_input_classes(@schedule, :client_id) %>
          <% if @clients.blank? %>
            <p class="mt-1.5 text-xs text-stone-500">
              등록된 거래처가 없습니다. <%= link_to "거래처 먼저 등록하기", new_app_client_path, class: "font-bold text-emerald-700 underline underline-offset-4" %>
            </p>
          <% end %>
          <% if form_error_message(@schedule, :client_id) %>
            <p class="mt-1.5 text-xs font-medium text-red-600"><%= form_error_message(@schedule, :client_id) %></p>
          <% end %>
        </div>
        <div>
          <%= form.label :day_of_month, "매월 발행일", class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :day_of_month,
                (RecurringInvoice::DAY_OF_MONTH_RANGE).map { |d| [ "#{d}일", d ] },
                { prompt: "발행일을 선택하세요", required: true },
                class: form_input_classes(@schedule, :day_of_month) %>
          <p class="mt-1.5 text-xs text-stone-500">매월 1일부터 28일까지 선택할 수 있습니다.</p>
          <% if form_error_message(@schedule, :day_of_month) %>
            <p class="mt-1.5 text-xs font-medium text-red-600"><%= form_error_message(@schedule, :day_of_month) %></p>
          <% end %>
        </div>
      </div>

      <div class="mt-6 space-y-4">
        <div>
          <%= form.label :tax_mode, "부가세", class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :tax_mode,
                Invoice.tax_modes.keys.map { |k| [ k == "separate" ? "부가세 별도" : "부가세 포함", k ] },
                { include_blank: false },
                class: form_input_classes(@schedule, :tax_mode) %>
        </div>
        <div class="flex items-start gap-3">
          <%= form.check_box :withholding_enabled, class: "mt-1 size-4 rounded border-stone-300 text-emerald-700 focus:ring-emerald-600" %>
          <%= form.label :withholding_enabled, "원천징수(3.3%) 적용", class: "text-sm font-medium text-stone-700" %>
          <p class="text-xs text-stone-500">프리랜서 지급 건에 해당합니다.</p>
        </div>
        <div class="flex items-start gap-3">
          <%= form.check_box :hold_if_unpaid, class: "mt-1 size-4 rounded border-stone-300 text-emerald-700 focus:ring-emerald-600" %>
          <div>
            <%= form.label :hold_if_unpaid, "직전 청구 미수금 시 이번 달 보류", class: "text-sm font-medium text-stone-700" %>
            <p class="text-xs text-stone-500">이전 달 청구서가 아직 입금되지 않았다면 새 청구서를 발행하지 않습니다.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-base font-bold text-stone-800">품목</h2>
      <p class="mt-1 text-xs text-stone-500">매월 이 내용으로 청구서가 만들어집니다.</p>

      <div class="mt-4 space-y-3">
        <%= form.fields_for :items do |item_fields| %>
          <div class="grid gap-3 sm:grid-cols-[1fr_5rem_8rem]">
            <div>
              <%= item_fields.label :name, "품목명", class: "block text-xs font-medium text-stone-600" %>
              <%= item_fields.text_field :name, required: true, maxlength: 100,
                    placeholder: "예) 월간 디자인 유지보수",
                    class: form_input_classes(@schedule, :name) %>
            </div>
            <div>
              <%= item_fields.label :quantity, "수량", class: "block text-xs font-medium text-stone-600" %>
              <%= item_fields.number_field :quantity, min: 1, step: 1, required: true, class: form_input_classes(@schedule, :quantity) %>
            </div>
            <div>
              <%= item_fields.label :unit_price, "단가(원)", class: "block text-xs font-medium text-stone-600" %>
              <%= item_fields.number_field :unit_price, min: 0, step: 1, required: true, class: form_input_classes(@schedule, :unit_price) %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <div class="border-t border-stone-200 pt-6">
      <%= form.submit "반복 청구 등록",
            class: "inline-flex min-h-11 cursor-pointer items-center rounded-xl bg-emerald-800 px-6 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    </div>
  <% end %>
</div>
