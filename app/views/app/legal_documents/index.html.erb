<%# 내용증명 양식 목록(F-LEGAL — LEGAL-1/2) — 발급 이력과 새로 발급 가능한 대상(만기 D+30 초과
    미수 청구)을 보여준다. LEGAL-4 — 발송 대행 없음 안내를 목록 상단에 함께 표기한다. %>
<div class="mx-auto max-w-4xl">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-stone-900">내용증명</h1>
      <p class="mt-2 text-sm leading-relaxed text-stone-500">
        청구 내역·발송 이력이 자동 반영된 내용증명 양식(PDF)을 건당 5,000원으로 발급합니다.
      </p>
    </div>
    <%= link_to "새 양식 발급", new_app_legal_document_path,
          class: "inline-flex min-h-11 items-center rounded-xl bg-emerald-800 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900" %>
  </header>

  <%# ── LEGAL-4 — 발송 대행 없음 안내 ── %>
  <p class="mt-4 rounded-2xl border border-stone-200 bg-white p-4 text-xs leading-relaxed text-stone-500 shadow-sm">
    내용증명 발송은 우체국 등기 등으로 <span class="font-bold text-stone-700">직접</span> 수행해야 하며, 법률 자문은 제공되지 않습니다.
  </p>

  <%# ── 발급 가능 대상(LEGAL-1 — D+30 초과 미수 한정) ── %>
  <section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="legal-targets">
    <h2 id="legal-targets" class="text-base font-bold text-stone-800">발급 가능한 청구서</h2>
    <p class="mt-1 text-xs text-stone-400">만기일이 30일 이상 지난 미수금 청구입니다.</p>
    <% if @legal_targets.any? %>
      <ul class="mt-4 divide-y divide-stone-100">
        <% @legal_targets.each do |invoice| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <div>
              <p class="text-sm font-semibold text-stone-800"><%= invoice.issue_number %></p>
              <p class="mt-0.5 text-xs text-stone-500">
                <%= invoice.client.name %> · 만기 <%= invoice.due_on.strftime("%Y-%m-%d") %>
              </p>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-sm font-bold tabular-nums text-stone-900"><%= won(invoice.total_amount) %></span>
              <%= link_to "양식 발급", new_app_legal_document_path(invoice_id: invoice.id),
                    class: "inline-flex min-h-11 items-center rounded-xl border border-emerald-300 bg-white px-4 py-2 text-sm font-bold text-emerald-800 transition hover:bg-emerald-50" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm leading-relaxed text-stone-500">해당하는 청구가 없습니다.</p>
    <% end %>
  </section>

  <%# ── 발급 이력(주문 기준 — P4 모든 발신은 기록) ── %>
  <section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="legal-history">
    <h2 id="legal-history" class="text-base font-bold text-stone-800">발급 이력</h2>
    <% if @orders.any? %>
      <ul class="mt-4 divide-y divide-stone-100">
        <% @orders.each do |order| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <div>
              <p class="text-sm font-semibold text-stone-800"><%= order.created_at.strftime("%Y-%m-%d %H:%M") %></p>
              <p class="mt-0.5 text-xs text-stone-500">주문번호 <span class="tabular-nums"><%= order.pg_order_id %></span></p>
            </div>
            <div class="flex items-center gap-3">
              <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-bold <%= order.paid? ? "bg-emerald-50 text-emerald-700" : (order.pending? ? "bg-stone-100 text-stone-500" : "bg-red-50 text-red-600") %>">
                <%= order.paid? ? "결제 완료" : (order.pending? ? "결제 대기" : "결제 실패·취소") %>
              </span>
              <span class="text-sm font-bold tabular-nums text-stone-900"><%= won(order.amount) %></span>
              <%= link_to "상세", app_legal_document_path(order),
                    class: "text-sm font-bold text-emerald-800 underline underline-offset-2 transition hover:text-emerald-900" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm leading-relaxed text-stone-500">발급 이력이 없습니다.</p>
    <% end %>
  </section>
</div>
