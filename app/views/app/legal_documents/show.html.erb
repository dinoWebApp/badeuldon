<%# 내용증명 주문 상세(F-LEGAL — LEGAL-2) — 결제 상태 표시. 대기 주문은 포트원 위젯 체크아웃
    (수금 패스 _checkout 선례 — portone_payment Stimulus 재사용), 결제 완료 주문은 다운로드
    버튼을 노출한다. 콜백은 기존 App::OrdersController#callback을 재사용하며 컨트롤러가
    legal_doc 주문을 내용증명 상세로 되돌려보낸다. %>

<% content_for :head do %>
  <%= tag.script(src: "https://cdn.portone.io/v2/browser-sdk.js") %>
<% end %>

<div class="mx-auto max-w-2xl">
  <p class="text-sm">
    <%= link_to "← 내용증명 목록", app_legal_documents_path, class: "font-semibold text-stone-500 transition hover:text-stone-800" %>
  </p>

  <header class="mt-4">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900">내용증명 양식</h1>
    <p class="mt-2 text-sm leading-relaxed text-stone-500">
      주문번호 <span class="tabular-nums"><%= @order.pg_order_id %></span> ·
      <span class="tabular-nums"><%= won(@order.amount) %></span>
    </p>
  </header>

  <%# ── LEGAL-3 — 법률 자문 미제공 고지(상시 노출) ── %>
  <p class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900" role="note">
    <span class="font-bold">안내</span> — <%= LegalDocuments::ContentProofPdfService::LEGAL_NOTICE %>
  </p>
  <p class="mt-3 text-xs leading-relaxed text-stone-500">
    <%= LegalDocuments::ContentProofPdfService::DIRECT_SEND_NOTICE %>
  </p>

  <% if @order.paid? %>
    <%# 결제 완료 — PDF 다운로드(LEGAL-2 — paid 한정) %>
    <section class="mt-6 rounded-2xl border-2 border-emerald-800 bg-emerald-900/5 p-5 shadow-sm" aria-label="결제 완료">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm font-bold text-emerald-900">결제가 완료되었습니다.</p>
        <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-bold text-emerald-700">결제 완료</span>
      </div>
      <% if @invoice %>
        <p class="mt-2 text-xs text-stone-500">대상 청구: <%= @invoice.issue_number %></p>
      <% end %>
      <%= link_to "내용증명 PDF 내려받기", download_app_legal_document_path(@order),
            class: "mt-4 inline-flex min-h-11 items-center justify-center rounded-xl bg-emerald-800 px-6 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900" %>
    </section>
  <% elsif @order.pending? %>
    <%# 결제 대기 — 포트원 위젯 체크아웃(_checkout 선례 — 주문 원값만 전달, PLAN-5) %>
    <section class="mt-6 rounded-2xl border-2 border-emerald-800 bg-emerald-900/5 p-5 shadow-sm"
         data-controller="portone-payment"
         data-portone-payment-store-id-value="<%= @portone_store_id %>"
         data-portone-payment-channel-key-value="<%= @portone_channel_key_normal %>"
         data-portone-payment-payment-id-value="<%= @order.pg_order_id %>"
         data-portone-payment-amount-value="<%= @order.amount %>"
         data-portone-payment-order-name-value="내용증명 양식"
         data-portone-payment-callback-url-value="<%= callback_app_orders_url %>"
         data-portone-payment-customer-name-value="<%= @portone_customer_name %>"
         data-portone-payment-customer-phone-value="<%= @portone_customer_phone %>"
         data-portone-payment-customer-email-value="<%= @portone_customer_email %>">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm font-bold text-stone-800">결제 대기</p>
        <p class="text-xl font-extrabold tabular-nums text-stone-900"><%= won(@order.amount) %></p>
      </div>
      <% if @invoice %>
        <p class="mt-2 text-xs text-stone-500">대상 청구: <%= @invoice.issue_number %></p>
      <% end %>
      <% if @portone_customer_phone.present? %>
        <button type="button" data-action="portone-payment#pay"
              class="mt-4 inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-emerald-800 px-6 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900">
          결제하기
        </button>
      <% else %>
        <%# KG이니시스가 customer.phoneNumber를 필수로 요구 — 연락처 등록 후 결제 가능 %>
        <p class="mt-4 rounded-xl bg-amber-50 p-3 text-sm leading-relaxed text-stone-700" role="status">
          결제에는 연락처가 필요합니다.
          <%= link_to "프로필에서 연락처를 등록", edit_app_profile_path, class: "font-bold text-emerald-800 underline underline-offset-2 hover:text-emerald-900" %>해 주세요.
        </p>
      <% end %>
      <p class="mt-3 text-xs leading-relaxed text-stone-500">
        결제 승인은 KG이니시스(포트원 경유)가 처리하며, 승인 결과는 서버에서 재확인한 뒤 다운로드가 활성화됩니다.
      </p>
      <%# LEGAL-2 — 미결제는 워터마크 미리보기만 제공한다(C-1) %>
      <p class="mt-2 text-xs leading-relaxed text-stone-500">
        미리보기:
        <%= link_to "워터마크 미리보기 PDF 내려받기", download_app_legal_document_path(@order),
              class: "font-bold text-emerald-800 underline underline-offset-2 transition hover:text-emerald-900" %>
        (정식 PDF는 결제 완료 후 제공됩니다)
      </p>
    </section>
  <% else %>
    <%# 실패·취소 — 재주문 안내 %>
    <section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" aria-label="결제 실패">
      <p class="text-sm font-bold text-stone-800">결제가 완료되지 않았습니다.</p>
      <p class="mt-2 text-xs leading-relaxed text-stone-500">
        결제가 취소되었거나 실패했습니다. 새로 주문해 주세요.
      </p>
      <%= link_to "새 양식 발급", new_app_legal_document_path,
            class: "mt-4 inline-flex min-h-11 items-center justify-center rounded-xl border border-stone-300 bg-white px-5 py-2 text-sm font-bold text-stone-700 transition hover:bg-stone-50" %>
    </section>
  <% end %>
</div>
