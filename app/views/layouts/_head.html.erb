<%# 표면 공통 <head> — application·landing·app 레이아웃이 함께 사용한다(중복 제거).
    SURF-3 — /app·/b/*·/admin은 noindex, 랜딩 등 공개 표면은 색인 허용. %>
<title><%= content_for(:title) || "받을돈 — 프리랜서 수금 자동화" %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="<%= content_for(:description) || "프리랜서 수금 자동화 서비스 받을돈" %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="Badeuldon">
<meta name="mobile-web-app-capable" content="yes">
<%= tag.meta(name: "robots", content: "noindex, nofollow") if noindex? %>
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= yield :head %>

<%# 아이콘 갱신 시 v= 쿼리를 올린다 — CF 엣지·브라우저 1년 캐시 무효화(2026-10-16 교체) %>
<link rel="icon" href="/icon.png?v=20261016" type="image/png">
<link rel="icon" href="/icon.svg?v=20261016" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.png?v=20261016">

<%# DESIGN-3 — Pretendard(국문 우선 오픈소스 폰트) CDN, 전역 폰트 교체 %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<%# Includes all stylesheet files in app/assets/stylesheets %>
<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
