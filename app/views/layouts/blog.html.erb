<%# 표면 ① 블로그 레이아웃(BLOG-2 — 공개 콘텐츠, SURF-6 예산 분리 — 앱 자원·내비 미포함).
    크림 톤(DESIGN-2)의 심플 크롬. 색인 허용(SURF-3 예외) — noindex 미출력(_head 공통). %>
<!DOCTYPE html>
<html lang="ko">
  <head>
    <%= render "layouts/head" %>
    <%= yield :head %>
  </head>

  <body class="min-h-dvh bg-cream text-stone-800">
    <header class="sticky top-0 z-10 border-b border-stone-200/80 bg-cream/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
        <%= link_to blog_path, class: "text-lg font-extrabold tracking-tight text-emerald-900" do %>
          받을돈 <span class="ml-1 text-sm font-semibold text-stone-500">블로그</span>
        <% end %>
        <%# 블로그 자체 네비 — 홈 + 무료 도구 3종(LP-11 허브 유입 경로, 공개) %>
        <nav class="hidden items-center gap-4 text-sm font-semibold text-stone-600 sm:flex" aria-label="콘텐츠 메뉴">
          <%= link_to "홈", blog_path, class: "transition hover:text-emerald-800" %>
          <%= link_to "독촉 문구 생성기", reminder_generator_tool_path, class: "transition hover:text-emerald-800" %>
          <%= link_to "3.3% 계산기", tax_calculator_tool_path, class: "transition hover:text-emerald-800" %>
          <%= link_to "청구서 양식", invoice_template_tool_path, class: "transition hover:text-emerald-800" %>
        </nav>
        <% if authenticated? %>
          <%= link_to "대시보드로 가기", app_root_path,
                class: "rounded-lg bg-emerald-800 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
        <% else %>
          <%= link_to "서비스 시작하기", new_registration_path,
                class: "inline-flex min-h-11 items-center rounded-lg bg-emerald-800 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
      <%= render "layouts/flash" %>

      <%= yield %>
    </main>

    <footer class="border-t border-stone-200 bg-cream">
      <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
        <p class="text-xs leading-relaxed text-stone-500">
          프리랜서 수금 자동화 서비스 · © 2026 받을돈
        </p>
        <nav class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold text-stone-600" aria-label="법적 고지">
          <%= link_to "이용약관", terms_path, class: "transition hover:text-emerald-800" %>
          <%= link_to "개인정보처리방침", privacy_path, class: "transition hover:text-emerald-800" %>
          <%= link_to "환불 정책", refund_path, class: "transition hover:text-emerald-800" %>
        </nav>
      </div>
    </footer>
  </body>
</html>
