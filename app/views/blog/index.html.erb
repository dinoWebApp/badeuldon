<%# BLOG-3 — 블로그 목록(LP-11 허브의 공개 코어). 최신순·카테고리 필터·페이지네이션(12건).
    썸네일·제목·요약·발행일·카테고리 배지. 카테고리 필터 라벨은 BlogHelper(쿼리 없는 표현 함수). %>
<%# BLOG-3 — 블로그 목록(LP-11 허브의 공개 코어). 최신순·카테고리 필터·페이지네이션(12건).
    썸네일·제목·요약·발행일·카테고리 배지. 카테고리 필터 라벨은 BlogHelper(쿼리 없는 표현 함수).
    LP-11 허브 레이어: 허브 헤더·5클러스터 카테고리 카드·무료 도구 3종·가입 CTA — 목록 위 보조 레이어. %>
<div class="max-w-5xl">
  <%# ── 허브 헤더 ── %>
  <h1 class="text-3xl font-extrabold tracking-tight text-emerald-900">프리랜서 수금 콘텐츠</h1>
  <p class="mt-2 text-sm leading-relaxed text-stone-600">
    독촉·수금 시나리오부터 미수금 대응, 청구서 양식과 프리랜서 세금까지 — 실무에 바로 쓰는 가이드.
  </p>

  <%# ── 5클러스터 카테고리 카드 네비 — 기존 필터 경로 재사용(BLOG-6 허브 진입) ── %>
  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
    <% BlogHelper::CATEGORY_KEYS.each do |key| %>
      <%= link_to blog_category_path(key),
            class: "flex flex-col rounded-xl border border-stone-200 bg-white p-4 shadow-sm transition hover:border-emerald-700 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" do %>
        <span class="text-sm font-bold text-emerald-900"><%= category_label(key) %></span>
        <span class="mt-1 text-xs leading-relaxed text-stone-600"><%= category_description(key) %></span>
      <% end %>
    <% end %>
  </div>

  <%# ── 무료 도구 3종 진입 카드(경로 하드코딩 — 3-S 결선 시 헬퍼 교체) ── %>
  <%= render "blog/tool_cards" %>

  <%# ── 가입 CTA — LP-11 허브 버전(과도한 마케팅 금지·VIEW-8 정신 준용) ── %>
  <section class="mt-8 rounded-xl bg-emerald-900 px-6 py-5 text-white" aria-label="서비스 안내">
    <p class="text-sm font-bold">발행부터 독촉까지, 받을돈이 대신합니다.</p>
    <p class="mt-1 text-xs text-emerald-100">청구서를 링크로 보내고, 리마인더는 서비스가 명의로 전달합니다.</p>
    <%= link_to "무료로 시작하기", new_registration_path,
          class: "mt-3 inline-flex min-h-11 items-center rounded-lg bg-white px-4 text-sm font-bold text-emerald-900 shadow-sm transition hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" %>
  </section>

  <%# ── 게시글 목록(기존 유지) ── %>

  <%# 카테고리 필터 — Q19 5클러스터 고정 enum %>
  <nav class="mt-6 flex flex-wrap gap-2" aria-label="카테고리">
    <%= link_to "전체", blog_path,
          class: "inline-flex min-h-9 items-center rounded-full px-4 text-sm font-semibold #{'bg-emerald-800 text-white' if @category.nil?} #{'border border-stone-300 bg-white text-stone-600 hover:border-emerald-700 hover:text-emerald-800' unless @category.nil?}" %>
    <% BlogHelper::CATEGORY_KEYS.each do |key| %>
      <%= link_to category_label(key), blog_category_path(key),
            class: "inline-flex min-h-9 items-center rounded-full px-4 text-sm font-semibold #{'bg-emerald-800 text-white' if @category == key} #{'border border-stone-300 bg-white text-stone-600 hover:border-emerald-700 hover:text-emerald-800' if @category != key}" %>
    <% end %>
  </nav>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    <% @posts.each do |post| %>
      <article class="group flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition hover:shadow-md">
        <%= link_to blog_post_path(slug: post.slug), class: "block" do %>
          <% if post.thumbnail.attached? %>
            <div class="aspect-[16/9] w-full overflow-hidden bg-stone-100">
              <%= image_tag post.thumbnail, class: "h-full w-full object-cover transition group-hover:scale-[1.02]", alt: post.title, loading: "lazy" %>
            </div>
          <% else %>
            <div class="aspect-[16/9] w-full bg-emerald-50"></div>
          <% end %>
        <% end %>
        <div class="flex flex-1 flex-col p-5">
          <div class="flex items-center gap-2 text-xs">
            <span class="rounded-full bg-emerald-50 px-2 py-0.5 font-semibold text-emerald-700"><%= category_label(post.category) %></span>
            <% if post.display_published_at %>
              <time datetime="<%= post.display_published_at.to_date.iso8601 %>" class="text-stone-400"><%= l(post.display_published_at.to_date, format: :long) %></time>
            <% end %>
          </div>
          <h2 class="mt-2 text-lg font-bold leading-snug text-stone-900">
            <%= link_to post.title, blog_post_path(slug: post.slug), class: "transition hover:text-emerald-800" %>
          </h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600"><%= post.display_summary %></p>
        </div>
      </article>
    <% end %>
    <% if @posts.empty? %>
      <p class="col-span-full py-16 text-center text-sm text-stone-400">아직 게시된 글이 없습니다.</p>
    <% end %>
  </div>

  <%# 페이지네이션 — offset/limit 단순 페이저(kaminari 미도입) %>
  <% if @page > 1 || @has_more %>
    <nav class="mt-10 flex items-center justify-between" aria-label="페이지">
      <% if @page > 1 %>
        <%= link_to "이전 페이지", blog_path(page: @page - 1, category: @category),
              class: "inline-flex min-h-11 items-center rounded-lg border border-stone-300 bg-white px-4 text-sm font-semibold text-stone-600 hover:border-emerald-700 hover:text-emerald-800" %>
      <% else %><span></span><% end %>
      <% if @has_more %>
        <%= link_to "다음 페이지", blog_path(page: @page + 1, category: @category),
              class: "inline-flex min-h-11 items-center rounded-lg border border-stone-300 bg-white px-4 text-sm font-semibold text-stone-600 hover:border-emerald-700 hover:text-emerald-800" %>
      <% else %><span></span><% end %>
    </nav>
  <% end %>
</div>
