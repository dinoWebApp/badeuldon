<%# 비밀번호 재설정 요청 — AUTH-8 이메일로 1회성 만료 링크 발송 %>
<div class="mx-auto w-full max-w-md">
  <h1 class="text-3xl font-bold tracking-tight text-emerald-900">비밀번호 찾기</h1>
  <p class="mt-2 text-sm text-stone-500">가입하신 이메일을 입력하면 재설정 링크를 보내드립니다.</p>

  <%= form_with url: passwords_path, class: "mt-8" do |form| %>
    <div>
      <%= form.label :email, "이메일", class: "block text-sm font-medium text-stone-700" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
            value: params[:email],
            class: "mt-1 block w-full rounded-lg border border-stone-300 px-3 py-2.5 text-stone-800 focus:outline-2 focus:outline-emerald-700" %>
    </div>

    <div class="mt-6">
      <%= form.submit "재설정 링크 받기",
            class: "cursor-pointer rounded-xl bg-emerald-800 px-6 py-2.5 text-base font-bold text-white hover:bg-emerald-900" %>
    </div>
  <% end %>

  <p class="mt-8 text-sm text-stone-500">
    <%= link_to "로그인으로 돌아가기", new_session_path, class: "font-semibold text-emerald-800 underline hover:no-underline" %>
  </p>
</div>
