<%# 비밀번호 재설정 요청 — AUTH-8 이메일로 1회성 만료 링크 발송.
    UI 품질 기준(DESIGN) 적용 — 기능·라우팅·문구 불변. %>
<div class="mx-auto w-full max-w-md py-12">
  <h1 class="text-2xl font-bold tracking-tight text-emerald-900 sm:text-3xl">비밀번호 찾기</h1>
  <p class="mt-2 text-sm text-stone-500">가입하신 이메일을 입력하면 재설정 링크를 보내드립니다.</p>

  <%= form_with url: passwords_path, class: "mt-8 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm" do |form| %>
    <div>
      <%= form.label :email, "이메일", class: "block text-sm font-medium text-stone-700" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
            value: params[:email],
            class: "mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2.5 text-stone-800 shadow-sm transition placeholder:text-stone-400 hover:border-stone-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/30" %>
    </div>

    <div class="mt-6">
      <%= form.submit "재설정 링크 받기",
            class: "w-full cursor-pointer rounded-xl bg-emerald-800 px-6 py-3 text-base font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    </div>
  <% end %>

  <p class="mt-6 text-center text-sm text-stone-500">
    <%= link_to "로그인으로 돌아가기", new_session_path, class: "font-semibold text-emerald-800 underline hover:no-underline" %>
  </p>
</div>
