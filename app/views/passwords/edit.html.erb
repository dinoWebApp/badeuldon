<%# 새 비밀번호 설정 — AUTH-8 재설정 링크(토큰) 진입 %>
<div class="mx-auto w-full max-w-md">
  <h1 class="text-3xl font-bold tracking-tight text-emerald-900">새 비밀번호 설정</h1>
  <p class="mt-2 text-sm text-stone-500">새 비밀번호를 두 번 입력해 주세요.</p>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-8" do |form| %>
    <div>
      <%= form.label :password, "새 비밀번호", class: "block text-sm font-medium text-stone-700" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-lg border border-stone-300 px-3 py-2.5 text-stone-800 focus:outline-2 focus:outline-emerald-700" %>
    </div>

    <div class="mt-4">
      <%= form.label :password_confirmation, "새 비밀번호 확인", class: "block text-sm font-medium text-stone-700" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-lg border border-stone-300 px-3 py-2.5 text-stone-800 focus:outline-2 focus:outline-emerald-700" %>
    </div>

    <div class="mt-6">
      <%= form.submit "비밀번호 변경",
            class: "cursor-pointer rounded-xl bg-emerald-800 px-6 py-2.5 text-base font-bold text-white hover:bg-emerald-900" %>
    </div>
  <% end %>
</div>
