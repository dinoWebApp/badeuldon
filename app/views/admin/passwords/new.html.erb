<%# 관리자 비밀번호 재설정 요청(AUTH-7.6) — 존재 열거 방지 응답. %>
<div class="mx-auto w-full max-w-md py-8">
  <h1 class="admin-title">비밀번호 재설정</h1>

  <%= form_with url: admin_passwords_path, class: "admin-card" do |form| %>
    <%= form.label :email, "가입된 관리자 이메일", class: "admin-label" %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
          value: params[:email], class: "admin-input" %>
    <%= form.submit "재설정 안내 받기", class: "admin-btn" %>
  <% end %>

  <p class="mt-4 text-center text-sm">
    <%= link_to "로그인으로 돌아가기", new_admin_session_path, class: "text-stone-500 underline hover:no-underline" %>
  </p>
</div>
