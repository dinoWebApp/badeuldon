<%# ADMIN-4 쿠폰 관리 목록 — 코드·할인·사용 통계(used_count/max·잔여)·기간·활성 배지. %>
<div class="admin-card">
  <div class="flex items-center justify-between">
    <h1 class="admin-title">쿠폰 관리</h1>
    <%= link_to "새 쿠폰", new_admin_coupon_path,
          class: "rounded bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-800" %>
  </div>

  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs text-stone-500 border-b border-stone-200">
        <th class="py-2 pr-4">코드</th>
        <th class="py-2 pr-4">이름</th>
        <th class="py-2 pr-4">할인</th>
        <th class="py-2 pr-4">사용</th>
        <th class="py-2 pr-4">만료일</th>
        <th class="py-2 pr-4">상태</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody>
      <% @coupons.each do |coupon| %>
        <tr class="border-b border-stone-100 hover:bg-stone-50">
          <td class="py-2 pr-4 font-mono text-xs font-bold"><%= link_to coupon.code, admin_coupon_path(coupon) %></td>
          <td class="py-2 pr-4"><%= coupon.name %></td>
          <td class="py-2 pr-4 tabular-nums"><%= coupon_discount_label(coupon) %></td>
          <td class="py-2 pr-4 tabular-nums"><%= coupon.used_count %> / <%= coupon.max_redemptions %> (잔여 <%= coupon.remaining_count %>)</td>
          <td class="py-2 pr-4 tabular-nums"><%= coupon.expires_at || "무기한" %></td>
          <td class="py-2 pr-4">
            <% if coupon.active? && !coupon.expired? %>
              <span class="rounded-full bg-green-50 px-2 py-0.5 text-xs font-semibold text-green-700">활성</span>
            <% elsif coupon.expired? %>
              <span class="rounded-full bg-orange-50 px-2 py-0.5 text-xs font-semibold text-orange-600">만료</span>
            <% else %>
              <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs font-semibold text-stone-500">비활성</span>
            <% end %>
          </td>
          <td class="py-2 text-right whitespace-nowrap">
            <%= link_to "수정", edit_admin_coupon_path(coupon), class: "text-xs text-emerald-700 hover:underline mr-2" %>
            <%= button_to "삭제", admin_coupon_path(coupon), method: :delete,
                  form: { data: { turbo_confirm: "쿠폰을 삭제하시겠습니까? 사용 이력이 있는 쿠폰은 삭제할 수 없습니다." } },
                  class: "text-xs text-red-600 hover:underline inline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @coupons.empty? %>
    <p class="mt-4 text-sm text-stone-500">등록된 쿠폰이 없습니다.</p>
  <% end %>
</div>
