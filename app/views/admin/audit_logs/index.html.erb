<%# ADMIN-2 감사 로그 목록 — 최신순·필터(action·관리자·기간), 100행 페이지네이션. %>
<div class="admin-card">
  <h1 class="admin-title">감사 로그</h1>

  <%= form_with url: admin_audit_logs_path, method: :get, local: true, class: "mb-4 flex flex-wrap items-end gap-2" do %>
    <div>
      <label class="block text-xs text-stone-500 mb-1" for="action_filter">행위</label>
      <%= select_tag :action_filter,
            options_for_select([ [ "전체", "" ], "login_success", "login_failed", "lockout",
                                 "new_ip_login", "password_reset", "member_plan_change",
                                 "member_suspend", "member_unsuspend" ].to_h { |v| v.is_a?(Array) ? v : [ v, v ] },
                               params[:action_filter]),
            class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    </div>
    <div>
      <label class="block text-xs text-stone-500 mb-1" for="admin_id">관리자</label>
      <%= select_tag :admin_id,
            options_for_select([ [ "전체", "" ] ] + @admins, params[:admin_id]),
            class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    </div>
    <div>
      <label class="block text-xs text-stone-500 mb-1" for="from">시작일</label>
      <%= date_field_tag :from, params[:from], class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    </div>
    <div>
      <label class="block text-xs text-stone-500 mb-1" for="to">종료일</label>
      <%= date_field_tag :to, params[:to], class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    </div>
    <%= submit_tag "조회", class: "bg-stone-800 text-white rounded px-4 py-1.5 text-sm hover:bg-stone-700" %>
  <% end %>

  <p class="text-xs text-stone-500 mb-2">총 <%= number_with_delimiter(@total_count) %>건 · <%= @page %>페이지(최대 100건)</p>

  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs text-stone-500 border-b border-stone-200">
        <th class="py-2 pr-4">일시(KST)</th>
        <th class="py-2 pr-4">관리자</th>
        <th class="py-2 pr-4">행위</th>
        <th class="py-2 pr-4">대상</th>
        <th class="py-2 pr-4">상세</th>
        <th class="py-2">IP</th>
      </tr>
    </thead>
    <tbody>
      <% @audit_logs.each do |log| %>
        <tr class="border-b border-stone-100 hover:bg-stone-50">
          <td class="py-2 pr-4 whitespace-nowrap"><%= l(log.created_at, format: :long) %></td>
          <td class="py-2 pr-4"><%= log.admin.email %></td>
          <td class="py-2 pr-4"><%= log.action %></td>
          <td class="py-2 pr-4"><%= log.target_type %>#<%= log.target_id %></td>
          <td class="py-2 pr-4"><%= truncate(log.detail, length: 60) %></td>
          <td class="py-2 text-stone-500"><%= log.ip %></td>
        </tr>
      <% end %>
      <% if @audit_logs.empty? %>
        <tr><td colspan="6" class="py-6 text-center text-stone-400">조건에 맞는 감사 로그가 없습니다.</td></tr>
      <% end %>
    </tbody>
  </table>

  <% if @page > 1 %>
    <%= link_to "이전 페이지", admin_audit_logs_path(request.query_parameters.merge(page: @page - 1)),
          class: "inline-block mt-4 text-sm text-stone-600 underline" %>
  <% end %>
  <% if @page * Admin::AuditLogsController::PAGE_SIZE < @total_count %>
    <%= link_to "다음 페이지", admin_audit_logs_path(request.query_parameters.merge(page: @page + 1)),
          class: "inline-block mt-4 ml-3 text-sm text-stone-600 underline" %>
  <% end %>
</div>
