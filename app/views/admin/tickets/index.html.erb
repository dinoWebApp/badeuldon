<%# ADMIN-8 티켓 관리 목록 — 상태·분류 필터·최신순·limit 100. %>
<div class="admin-card">
  <div class="flex items-center justify-between">
    <h1 class="admin-title">문의 티켓</h1>
  </div>

  <%= form_with url: admin_tickets_path, method: :get, local: true, class: "mb-4 flex items-center gap-2" do %>
    <%= select_tag :status,
          options_for_select([ [ "전체 상태", "" ], [ "접수", "open" ], [ "답변 완료", "answered" ], [ "종료", "closed" ] ], params[:status]),
          class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    <%= select_tag :category,
          options_for_select([ [ "전체 분류", "" ] ] + Admin::TicketsController::CATEGORY_LABELS.map { |k, v| [ v, k ] }, params[:category]),
          class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    <%= submit_tag "필터", class: "ml-1 bg-stone-800 text-white rounded px-3 py-1.5 text-sm hover:bg-stone-700" %>
  <% end %>

  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs text-stone-500 border-b border-stone-200">
        <th class="py-2 pr-4">제목</th>
        <th class="py-2 pr-4">사용자</th>
        <th class="py-2 pr-4">분류</th>
        <th class="py-2 pr-4">상태</th>
        <th class="py-2 pr-4">접수일시</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody>
      <% @tickets.each do |ticket| %>
        <% status_label, status_class = admin_ticket_status_badge(ticket) %>
        <tr class="border-b border-stone-100 hover:bg-stone-50">
          <td class="py-2 pr-4"><%= link_to ticket.title, admin_ticket_path(ticket), class: "font-semibold text-emerald-800 hover:underline" %></td>
          <td class="py-2 pr-4 text-stone-600"><%= ticket.user.display_name %></td>
          <td class="py-2 pr-4 text-stone-600"><%= admin_ticket_category_label(ticket) %></td>
          <td class="py-2 pr-4">
            <span class="rounded-full px-2 py-0.5 text-xs font-semibold <%= status_class %>"><%= status_label %></span>
          </td>
          <td class="py-2 pr-4 whitespace-nowrap text-xs text-stone-500"><%= ticket.created_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td class="py-2 text-right">
            <%= link_to "상세", admin_ticket_path(ticket), class: "text-xs text-emerald-700 hover:underline" %>
          </td>
        </tr>
      <% end %>
      <% if @tickets.empty? %>
        <tr><td colspan="6" class="py-8 text-center text-stone-400">문의가 없습니다.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
