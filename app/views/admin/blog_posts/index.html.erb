<%# ADMIN-10·BLOG-5 블로그 관리 목록 — 상태·카테고리 필터, 상태 배지, 발행/예약/비공개 member PATCH. %>
<div class="admin-card">
  <div class="flex items-center justify-between">
    <h1 class="admin-title">블로그 콘텐츠</h1>
    <%= link_to "새 게시글", new_admin_blog_post_path,
          class: "rounded bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-800" %>
  </div>

  <%= form_with url: admin_blog_posts_path, method: :get, local: true, class: "mb-4 flex gap-2" do %>
    <%= select_tag :status,
          options_for_select([ [ "전체 상태", "" ] ] + BlogHelper::STATUS_KEYS.map { |k| [ status_label(k), k ] }, params[:status]),
          class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    <%= select_tag :category,
          options_for_select([ [ "전체 카테고리", "" ] ] + BlogHelper::CATEGORY_KEYS.map { |k| [ category_label(k), k ] }, params[:category]),
          class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    <%= submit_tag "필터", class: "bg-stone-800 text-white rounded px-3 py-1.5 text-sm hover:bg-stone-700" %>
  <% end %>

  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs text-stone-500 border-b border-stone-200">
        <th class="py-2 pr-4">제목</th>
        <th class="py-2 pr-4">카테고리</th>
        <th class="py-2 pr-4">상태</th>
        <th class="py-2 pr-4">발행일</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody>
      <% @blog_posts.each do |post| %>
        <% status_label, status_class = blog_status_badge(post) %>
        <tr class="border-b border-stone-100 hover:bg-stone-50">
          <td class="py-2 pr-4"><%= post.title %><p class="text-xs text-stone-400">/<%= post.slug %></p></td>
          <td class="py-2 pr-4"><span class="rounded-full px-2 py-0.5 text-xs font-semibold bg-emerald-50 text-emerald-700"><%= category_label(post.category) %></span></td>
          <td class="py-2 pr-4">
            <span class="rounded-full px-2 py-0.5 text-xs font-semibold <%= status_class %>"><%= status_label %></span>
            <% if post.publish_at.present? && !post.published? %>
              <p class="text-xs text-stone-400">예약: <%= l(post.publish_at, format: :short) %></p>
            <% end %>
          </td>
          <td class="py-2 pr-4 whitespace-nowrap text-xs text-stone-500">
            <%= post.published_at ? l(post.published_at, format: :short) : "-" %>
          </td>
          <td class="py-2 text-right whitespace-nowrap">
            <% if post.published? %>
              <%= button_to "비공개", unpublish_admin_blog_post_path(post), method: :patch,
                    form: { class: "inline" },
                    class: "inline-block rounded border border-orange-400 px-3 py-1.5 text-xs text-orange-600 hover:bg-orange-50" %>
            <% elsif post.scheduled? %>
              <%= button_to "예약 취소", unpublish_admin_blog_post_path(post), method: :patch,
                    form: { class: "inline" },
                    class: "inline-block rounded border border-stone-300 px-3 py-1.5 text-xs hover:bg-stone-100" %>
              <%= button_to "즉시 발행", publish_admin_blog_post_path(post), method: :patch,
                    form: { class: "inline" },
                    class: "inline-block rounded border border-emerald-600 px-3 py-1.5 text-xs text-emerald-700 hover:bg-emerald-50" %>
            <% else %>
              <%= button_to "발행", publish_admin_blog_post_path(post), method: :patch,
                    form: { class: "inline" },
                    class: "inline-block rounded border border-emerald-600 px-3 py-1.5 text-xs text-emerald-700 hover:bg-emerald-50" %>
            <% end %>
            <%= link_to "수정", edit_admin_blog_post_path(post),
                  class: "ml-1 inline-block rounded border border-stone-300 px-3 py-1.5 text-xs hover:bg-stone-100" %>
            <%= button_to "삭제", admin_blog_post_path(post), method: :delete,
                  form: { class: "inline ml-1" },
                  data: { turbo_confirm: "게시글을 삭제하시겠습니까?" },
                  class: "inline-block rounded border border-red-300 px-3 py-1.5 text-xs text-red-600 hover:bg-red-50" %>
          </td>
        </tr>
      <% end %>
      <% if @blog_posts.empty? %>
        <tr><td colspan="5" class="py-6 text-center text-stone-400">등록된 게시글이 없습니다.</td></tr>
      <% end %>
    </tbody>
  </table>
  <p class="mt-3 text-xs text-stone-400">최대 100건까지 표시합니다.</p>
</div>
