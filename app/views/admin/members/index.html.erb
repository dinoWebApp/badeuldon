<%# ADMIN-3 회원 목록 — 검색(이름/이메일)·플랜·상태 필터. %>
<div class="admin-card">
  <h1 class="admin-title">회원 관리</h1>

  <%= form_with url: admin_members_path, method: :get, local: true, class: "mb-4 flex flex-wrap items-end gap-2" do %>
    <div>
      <label class="block text-xs text-stone-500 mb-1" for="q">이름·이메일 검색</label>
      <%= text_field_tag :q, params[:q], placeholder: "이름 또는 이메일",
            class: "border border-stone-300 rounded px-2 py-1.5 text-sm w-56" %>
    </div>
    <div>
      <label class="block text-xs text-stone-500 mb-1" for="plan">플랜</label>
      <%= select_tag :plan, options_for_select([ [ "전체", "" ], [ "Free", "free" ], [ "Plus", "plus" ] ], params[:plan]),
            class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    </div>
    <div>
      <label class="block text-xs text-stone-500 mb-1" for="status">상태</label>
      <%= select_tag :status, options_for_select([ [ "전체", "" ], [ "활성", "active" ], [ "정지", "suspended" ] ], params[:status]),
            class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    </div>
    <%= submit_tag "검색", class: "bg-stone-800 text-white rounded px-4 py-1.5 text-sm hover:bg-stone-700" %>
  <% end %>

  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs text-stone-500 border-b border-stone-200">
        <th class="py-2 pr-4">이메일</th>
        <th class="py-2 pr-4">표시명</th>
        <th class="py-2 pr-4">플랜</th>
        <th class="py-2 pr-4">상태</th>
        <th class="py-2 pr-4">가입일</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr class="border-b border-stone-100 hover:bg-stone-50">
          <td class="py-2 pr-4"><%= user.email %></td>
          <td class="py-2 pr-4"><%= user.display_name.presence || "-" %></td>
          <td class="py-2 pr-4"><%= user.subscription&.plus? ? "Plus" : "Free" %></td>
          <td class="py-2 pr-4">
            <% if user.suspended? %>
              <span class="text-orange-600 font-medium">정지</span>
            <% else %>
              <span class="text-stone-500">활성</span>
            <% end %>
          </td>
          <td class="py-2 pr-4 whitespace-nowrap"><%= l(user.created_at.to_date, format: :long) %></td>
          <td class="py-2 text-right">
            <%= link_to "상세", admin_member_path(user),
                  class: "inline-block rounded border border-stone-300 px-3 py-1.5 text-xs hover:bg-stone-100" %>
          </td>
        </tr>
      <% end %>
      <% if @users.empty? %>
        <tr><td colspan="6" class="py-6 text-center text-stone-400">조건에 맞는 회원이 없습니다.</td></tr>
      <% end %>
    </tbody>
  </table>
  <p class="mt-3 text-xs text-stone-400">최대 100건까지 표시합니다.</p>
</div>
