<%# ADMIN-6 공지 관리 목록 — 중요도 필터·상태 배지(초안·게시 중·종료)·발행/종료 member PATCH. %>
<div class="admin-card">
  <div class="flex items-center justify-between">
    <h1 class="admin-title">공지 관리</h1>
    <%= link_to "새 공지", new_admin_notice_path,
          class: "rounded bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-800" %>
  </div>

  <%= form_with url: admin_notices_path, method: :get, local: true, class: "mb-4" do %>
    <%= select_tag :importance,
          options_for_select([ [ "전체", "" ], [ "일반", "general" ], [ "중요", "important" ] ], params[:importance]),
          class: "border border-stone-300 rounded px-2 py-1.5 text-sm" %>
    <%= submit_tag "필터", class: "ml-2 bg-stone-800 text-white rounded px-3 py-1.5 text-sm hover:bg-stone-700" %>
  <% end %>

  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs text-stone-500 border-b border-stone-200">
        <th class="py-2 pr-4">제목</th>
        <th class="py-2 pr-4">중요도</th>
        <th class="py-2 pr-4">상태</th>
        <th class="py-2 pr-4">게시 기간</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody>
      <% @notices.each do |notice| %>
        <% status_label, status_class = notice_status_badge(notice) %>
        <% importance_label, importance_class = notice_importance_badge(notice) %>
        <tr class="border-b border-stone-100 hover:bg-stone-50">
          <td class="py-2 pr-4"><%= notice.title %></td>
          <td class="py-2 pr-4">
            <span class="rounded-full px-2 py-0.5 text-xs font-semibold <%= importance_class %>"><%= importance_label %></span>
          </td>
          <td class="py-2 pr-4">
            <span class="rounded-full px-2 py-0.5 text-xs font-semibold <%= status_class %>"><%= status_label %></span>
          </td>
          <td class="py-2 pr-4 whitespace-nowrap text-xs text-stone-500">
            <%= notice.published_at ? l(notice.published_at.to_date, format: :long) : "-" %>
            ~ <%= notice.expires_at ? l(notice.expires_at.to_date, format: :long) : "무기한" %>
          </td>
          <td class="py-2 text-right whitespace-nowrap">
            <% if notice.draft? %>
              <%= button_to "발행", publish_admin_notice_path(notice), method: :patch,
                    form: { class: "inline" },
                    class: "inline-block rounded border border-emerald-600 px-3 py-1.5 text-xs text-emerald-700 hover:bg-emerald-50" %>
            <% elsif notice.live? %>
              <%= button_to "종료", close_admin_notice_path(notice), method: :patch,
                    form: { class: "inline" },
                    class: "inline-block rounded border border-orange-400 px-3 py-1.5 text-xs text-orange-600 hover:bg-orange-50" %>
            <% end %>
            <%= link_to "수정", edit_admin_notice_path(notice),
                  class: "ml-1 inline-block rounded border border-stone-300 px-3 py-1.5 text-xs hover:bg-stone-100" %>
            <%= button_to "삭제", admin_notice_path(notice), method: :delete,
                  form: { class: "inline ml-1" },
                  data: { turbo_confirm: "공지를 삭제하시겠습니까?" },
                  class: "inline-block rounded border border-red-300 px-3 py-1.5 text-xs text-red-600 hover:bg-red-50" %>
          </td>
        </tr>
      <% end %>
      <% if @notices.empty? %>
        <tr><td colspan="5" class="py-6 text-center text-stone-400">등록된 공지가 없습니다.</td></tr>
      <% end %>
    </tbody>
  </table>
  <p class="mt-3 text-xs text-stone-400">최대 100건까지 표시합니다.</p>
</div>
