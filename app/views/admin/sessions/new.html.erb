<%# 관리자 로그인 1단계(AUTH-7 이메일+비밀번호) — 오류 문구 통일(열거 방지). %>
<div class="mx-auto w-full max-w-md py-8">
  <h1 class="admin-title">관리자 로그인</h1>

  <%= form_with url: admin_session_path, class: "admin-card" do |form| %>
    <div>
      <%= form.label :email, "이메일", class: "admin-label" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
            value: params[:email], class: "admin-input" %>
    </div>

    <div class="mt-4">
      <%= form.label :password, "비밀번호", class: "admin-label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password",
            maxlength: 72, class: "admin-input" %>
    </div>

    <%= form.submit "로그인", class: "admin-btn" %>
  <% end %>

  <p class="mt-4 text-center text-sm">
    <%= link_to "비밀번호 재설정", new_admin_password_path, class: "text-stone-500 underline hover:no-underline" %>
  </p>
</div>
