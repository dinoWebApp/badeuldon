<%# 청구서 양식 PDF(LP-11) — 입력(선택) 후 PDF 다운로드. GET params·저장 없음(P3).
    도구 경로는 3-S 결선 헬퍼(invoice_template_tool_path·
    invoice_template_pdf_tool_path(params 포함)로 교체). %>
<% tools_meta("청구서 양식 PDF | 받을돈",
              "거래처·품목을 넣어 청구서 양식 PDF를 바로 만들어 다운로드하세요. 가입 없이 사용하고, 입력값은 저장되지 않습니다.") %>

<div class="max-w-3xl">
  <h1 class="text-3xl font-extrabold tracking-tight text-stone-900">청구서 양식 만들기</h1>
  <p class="mt-3 text-sm leading-relaxed text-stone-600">
    내용을 비워 두면 샘플 양식으로 만들어 드립니다. 입력값은 저장되지 않습니다.
  </p>

  <%= form_with url: invoice_template_pdf_tool_path, method: :get, local: true,
        data: { turbo: false }, class: "mt-8 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6" do |f| %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= f.label :client_name, "거래처명 (선택)", class: "block text-xs font-bold text-stone-700" %>
        <%= f.text_field :client_name, placeholder: "예) 가나디자인",
              class: "mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none" %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :item_name, "품목명 (선택)", class: "block text-xs font-bold text-stone-700" %>
        <%= f.text_field :item_name, placeholder: "예) 10월 웹 디자인 작업",
              class: "mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :quantity, "수량 (선택)", class: "block text-xs font-bold text-stone-700" %>
        <%= f.text_field :quantity, inputmode: "numeric", placeholder: "예) 1",
              class: "mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :unit_price, "단가 (선택)", class: "block text-xs font-bold text-stone-700" %>
        <%= f.text_field :unit_price, inputmode: "numeric", placeholder: "예) 1,000,000",
              class: "mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none" %>
      </div>
    </div>
    <div class="mt-5">
      <%= f.submit "PDF 다운로드",
            class: "inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-emerald-800 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 sm:w-auto" %>
    </div>
  <% end %>

  <%= tools_cta(text: "양식을 직접 만들지 말고, 링크만 보내면 열람부터 입금까지 자동으로 관리하세요", link_label: "받을돈 무료로 시작하기") %>
</div>
