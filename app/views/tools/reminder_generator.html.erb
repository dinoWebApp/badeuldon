<%# 독촉 문구 생성기(LP-11·REM-2 4단계 톤) — 폼+결과 동일 페이지·GET params·저장 없음(P3).
    도구 경로는 3-S 결선 헬퍼(reminder_generator_tool_path) 사용. %>
<% tools_meta("독촉 문구 생성기 | 받을돈",
              "거래처에 보내기 어려운 독촉 메시지를 톤 4단계로 만들어 드립니다. 가입 없이 사용하고, 입력값은 저장되지 않습니다.") %>

<div class="max-w-3xl">
  <h1 class="text-3xl font-extrabold tracking-tight text-stone-900">독촉 문구 생성기</h1>
  <p class="mt-3 text-sm leading-relaxed text-stone-600">
    톤을 고르면 관계를 지키는 문장 3개를 만들어 드립니다. 모든 입력은 저장되지 않습니다.
  </p>

  <%= form_with url: reminder_generator_tool_path, method: :get, local: true, class: "mt-8 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6" do |f| %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= f.label :tone, "톤", class: "block text-xs font-bold text-stone-700" %>
        <%= f.select :tone,
              [["부드럽게", "soft"], ["정중하게", "polite"], ["사실적으로", "factual"], ["명확하게", "firm"]],
              { selected: @tone.presence || "polite" },
              class: "mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :client_name, "거래처명 (선택)", class: "block text-xs font-bold text-stone-700" %>
        <%= f.text_field :client_name, value: @client_name, placeholder: "예) 가나디자인",
              class: "mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :amount, "금액 (선택)", class: "block text-xs font-bold text-stone-700" %>
        <%= f.text_field :amount, value: @amount, inputmode: "numeric", placeholder: "예) 1,000,000",
              class: "mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :due_date, "만기일 (선택)", class: "block text-xs font-bold text-stone-700" %>
        <%= f.date_field :due_date, value: @due_date,
              class: "mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none" %>
      </div>
    </div>
    <div class="mt-5">
      <%= f.submit "문구 만들기",
            class: "inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-emerald-800 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 sm:w-auto" %>
    </div>
  <% end %>

  <div class="mt-8 space-y-4">
    <% @messages.each_with_index do |message, i| %>
      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <p class="text-sm leading-relaxed text-stone-800"><%= message %></p>
          <%= tools_copy_button(message, label: "복사 #{i + 1}") %>
        </div>
      </div>
    <% end %>
  </div>

  <%= tools_cta(text: "문구 복사 대신, 만기가 지나면 받을돈이 자동으로 예의 바르게 보내드립니다", link_label: "받을돈 무료로 시작하기") %>
</div>

<%= render "tools/copy_script" %>
