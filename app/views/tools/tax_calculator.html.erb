<%# 3.3% 계산기(LP-11·INV-2 3.3% 선례) — 클라이언트 즉시 계산 + GET params 서버 계산(공유 URL).
    도구 경로는 3-S 결선 헬퍼(tax_calculator_tool_path) 사용. %>
<% tools_meta("3.3% 계산기 | 받을돈",
              "공급가액을 넣으면 원천징수 3.3%와 부가세 10%를 반영한 실수령액을 바로 계산합니다. 가입 없이 사용하고, 입력값은 저장되지 않습니다.") %>

<div class="max-w-3xl">
  <h1 class="text-3xl font-extrabold tracking-tight text-stone-900">3.3% 계산기</h1>
  <p class="mt-3 text-sm leading-relaxed text-stone-600">
    원천징수 3.3%·부가세 10% 기준으로 실수령액을 계산합니다. 입력값은 저장되지 않습니다.
  </p>

  <%= form_with url: tax_calculator_tool_path, method: :get, local: true,
        id: "tax-calc-form", data: { turbo: false }, class: "mt-8 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6" do |f| %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :amount, "공급가액 (원)", class: "block text-xs font-bold text-stone-700" %>
        <%= f.text_field :amount, value: @amount_raw, inputmode: "numeric", placeholder: "예) 1,000,000", id: "tax-amount",
              class: "mt-1 w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm shadow-sm focus:border-emerald-700 focus:outline-none" %>
      </div>
      <div class="flex items-end pb-2">
        <%= label_tag :vat_included, nil, class: "flex min-h-11 cursor-pointer items-center gap-2 text-sm font-semibold text-stone-700" do %>
          <%= check_box_tag :vat_included, "true", @vat_included == "true", id: "vat-included", class: "h-4 w-4 rounded border-stone-300 text-emerald-800 focus:ring-emerald-700" %>
          입력 금액에 부가세 포함
        <% end %>
      </div>
    </div>
    <div class="mt-5">
      <%= f.submit "계산하기",
            class: "inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-emerald-800 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 sm:w-auto" %>
    </div>
  <% end %>

  <% if @calculation_error %>
    <p class="mt-4 rounded-xl border border-orange-300 bg-orange-50 px-4 py-3 text-sm font-semibold text-orange-800" role="alert">
      <%= @calculation_error %>
    </p>
  <% end %>

  <% if @result %>
    <div class="mt-8 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6" id="tax-result">
      <dl class="divide-y divide-stone-100 text-sm">
        <div class="flex items-center justify-between py-3">
          <dt class="font-semibold text-stone-700">공급가액</dt>
          <dd class="font-bold tabular-nums text-stone-900" data-role="supply"><%= tools_won(@result.supply_amount) %></dd>
        </div>
        <div class="flex items-center justify-between py-3">
          <dt class="font-semibold text-stone-700">원천징수 (3.3%)</dt>
          <dd class="font-bold tabular-nums text-orange-700" data-role="withholding">-<%= tools_won(@result.withholding_amount) %></dd>
        </div>
        <div class="flex items-center justify-between py-3">
          <dt class="font-semibold text-stone-700">부가세 (10%)</dt>
          <dd class="font-bold tabular-nums text-stone-900" data-role="tax"><%= tools_won(@result.tax_amount) %></dd>
        </div>
        <div class="flex items-center justify-between rounded-b-xl bg-emerald-50 px-4 py-4">
          <dt class="font-extrabold text-emerald-900">실수령액</dt>
          <dd class="text-lg font-extrabold tabular-nums text-emerald-900" data-role="net"><%= tools_won(@result.net_amount) %></dd>
        </div>
      </dl>
      <div class="mt-4 flex justify-end">
        <%= tools_copy_button(
              "공급가액 #{tools_won(@result.supply_amount)} · 원천징수(3.3%) #{tools_won(@result.withholding_amount)} · 부가세 #{tools_won(@result.tax_amount)} · 실수령액 #{tools_won(@result.net_amount)}",
              label: "결과 복사") %>
      </div>
    </div>
  <% end %>

  <%= tools_cta(text: "계산에서 청구서 발행, 자동 독촉까지 — 받을돈 한 곳에서 끝내세요", link_label: "받을돈 무료로 시작하기") %>
</div>

<%= render "tools/copy_script" %>
<script nonce="<%= content_security_policy_nonce %>">
  // 클라이언트 즉시 계산(서버 결과 카드 자리에 같은 산식으로 갱신 — GET 제출도 여전히 동작).
  (function () {
    var form = document.getElementById("tax-calc-form");
    var amountInput = document.getElementById("tax-amount");
    var vatIncluded = document.getElementById("vat-included");
    var result = document.getElementById("tax-result");
    if (!form || !amountInput || !vatIncluded || !result) return;

    var won = function (n) { return n.toLocaleString("ko-KR") + "원"; };
    var calc = function () {
      var raw = parseInt((amountInput.value || "").replace(/[^\d]/g, ""), 10) || 0;
      if (!raw) return;
      var supply = vatIncluded.checked ? Math.floor(raw / 1.1) : raw;
      var withholding = Math.floor(supply * 0.033);
      var tax = Math.floor(supply * 0.10);
      result.querySelector('[data-role="supply"]').textContent = won(supply);
      result.querySelector('[data-role="withholding"]').textContent = "-" + won(withholding);
      result.querySelector('[data-role="tax"]').textContent = won(tax);
      result.querySelector('[data-role="net"]').textContent = won(supply - withholding);
    };
    amountInput.addEventListener("input", calc);
    vatIncluded.addEventListener("change", calc);
  })();
</script>
