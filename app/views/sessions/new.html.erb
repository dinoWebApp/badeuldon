<%# 로그인 — AUTH-1 이메일/비밀번호 %>
<div class="mx-auto w-full max-w-md">
  <h1 class="text-3xl font-bold tracking-tight text-emerald-900">로그인</h1>
  <p class="mt-2 text-sm text-stone-500">받을돈 계정으로 로그인합니다.</p>

  <%= form_with url: session_path, class: "mt-8" do |form| %>
    <div>
      <%= form.label :email, "이메일", class: "block text-sm font-medium text-stone-700" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
            value: params[:email],
            class: "mt-1 block w-full rounded-lg border border-stone-300 px-3 py-2.5 text-stone-800 focus:outline-2 focus:outline-emerald-700" %>
    </div>

    <div class="mt-4">
      <%= form.label :password, "비밀번호", class: "block text-sm font-medium text-stone-700" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            class: "mt-1 block w-full rounded-lg border border-stone-300 px-3 py-2.5 text-stone-800 focus:outline-2 focus:outline-emerald-700" %>
    </div>

    <div class="mt-6 flex items-center justify-between">
      <%= form.submit "로그인",
            class: "cursor-pointer rounded-xl bg-emerald-800 px-6 py-2.5 text-base font-bold text-white hover:bg-emerald-900" %>
      <%= link_to "비밀번호 찾기", new_password_path, class: "text-sm text-stone-500 underline hover:no-underline" %>
    </div>
  <% end %>

  <p class="mt-8 text-sm text-stone-500">
    아직 계정이 없으신가요?
    <%= link_to "무료로 시작하기", new_registration_path, class: "font-semibold text-emerald-800 underline hover:no-underline" %>
  </p>
</div>
